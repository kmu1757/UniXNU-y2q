+/* ---- fwput: firmware upload over the USB control channel ---- */
+
+#define FWPUT_MAX_NAME   31
+#define FWPUT_MAX_SLOTS  4
+#define FWPUT_MAX_SIZE   (8u * 1024u * 1024u)
+#define FWPUT_TIMEOUT_MS 10000u
+
+struct fwput_slot {
+    char     name[FWPUT_MAX_NAME + 1];
+    uint8_t *data;
+    uint32_t cap;      /* bytes allocated at data */
+    uint32_t len;
+    uint32_t crc;
+    bool     used;
+};
+
+static struct fwput_slot fwput_slots[FWPUT_MAX_SLOTS];
+
+/* Binary receive mode: while set, incoming bulk-OUT bytes are firmware, not a command line. */
+static bool fwput_rx_active;
+static struct fwput_slot *fwput_rx_slot;
+static uint32_t fwput_rx_len;
+static uint32_t fwput_rx_got;
+static uint32_t fwput_rx_crc;
+static uint64_t fwput_rx_deadline;
+
+static uint32_t
+fwput_crc32(const uint8_t *data, uint32_t len)
+{
+    uint32_t crc = 0xffffffffu;
+    for (uint32_t i = 0; i < len; i++) {
+        crc ^= data[i];
+        for (int b = 0; b < 8; b++) {
+            crc = (crc >> 1) ^ (0xedb88320u & (0u - (crc & 1u)));
+        }
+    }
+    return crc ^ 0xffffffffu;
+}
+
+static void
+fwput_reset_deadline(void)
+{
+    uint64_t interval = 0;
+    nanoseconds_to_absolutetime((uint64_t)FWPUT_TIMEOUT_MS * NSEC_PER_MSEC, &interval);
+    fwput_rx_deadline = mach_absolute_time() + interval;
+}
+
+/* Consume one bulk-OUT chunk while in binary receive mode. */
+static void
+fwput_feed(const uint8_t *data, unsigned len)
+{
+    struct fwput_slot *slot = fwput_rx_slot;
+    uint32_t remaining = fwput_rx_len - fwput_rx_got;
+
+    if (len > remaining) {
+        len = remaining;
+    }
+    copy_from_device(slot->data + fwput_rx_got, (const volatile uint8_t *)data, len);
+    fwput_rx_got += len;
+    fwput_reset_deadline();
+
+    if (fwput_rx_got == fwput_rx_len) {
+        fwput_rx_active = false;
+        uint32_t crc = fwput_crc32(slot->data, slot->len);
+        char reply[96];
+        if (crc == fwput_rx_crc) {
+            snprintf(reply, sizeof(reply), "fwput: ok %s %u %08x\n", slot->name, slot->len, crc);
+        } else {
+            snprintf(reply, sizeof(reply), "fwput: crc-mismatch %s got %08x want %08x\n",
+                slot->name, crc, fwput_rx_crc);
+            slot->used = false;
+        }
+        send_str(reply);
+    }
+}
+
+/* Called from the control thread's main loop: abandon a stalled upload. */
+static void
+fwput_check_timeout(void)
+{
+    if (!fwput_rx_active) {
+        return;
+    }
+    if (mach_absolute_time() < fwput_rx_deadline) {
+        return;
+    }
+    fwput_rx_active = false;
+    fwput_rx_slot->used = false;
+    char reply[64];
+    snprintf(reply, sizeof(reply), "fwput: timeout got %u\n", fwput_rx_got);
+    send_str(reply);
+}
+
+static void
+cmd_handle_fwput(const char *args)
+{
+    const char *p = args;
+    char name[FWPUT_MAX_NAME + 1];
+    unsigned name_len = 0;
+
+    while (*p == ' ') {
+        p++;
+    }
+    while (*p && *p != ' ' && name_len < FWPUT_MAX_NAME) {
+        char c = *p;
+        if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+              (c >= '0' && c <= '9') || c == '.' || c == '_' || c == '-')) {
+            send_str("fwput: bad-name\n");
+            return;
+        }
+        name[name_len++] = c;
+        p++;
+    }
+    if (name_len == 0) {
+        send_str("fwput: bad-name\n");
+        return;
+    }
+    name[name_len] = '\0';
+
+    uint32_t size = parse_num(&p);
+    uint32_t crc = parse_num(&p);
+
+    if (size < 1 || size > FWPUT_MAX_SIZE) {
+        send_str("fwput: bad-size\n");
+        return;
+    }
+
+    struct fwput_slot *slot = NULL;
+    struct fwput_slot *free_slot = NULL;
+    for (unsigned i = 0; i < FWPUT_MAX_SLOTS; i++) {
+        if (fwput_slots[i].used && strcmp(fwput_slots[i].name, name) == 0) {
+            slot = &fwput_slots[i];
+            break;
+        }
+        if (!fwput_slots[i].used && !free_slot) {
+            free_slot = &fwput_slots[i];
+        }
+    }
+    if (!slot) {
+        slot = free_slot;
+    }
+    if (!slot) {
+        send_str("fwput: no-slot\n");
+        return;
+    }
+
+    if (!slot->data || slot->cap < size) {
+        IOPhysicalAddress phys = 0;
+        void *buf = IOMallocContiguous(size, 4096, &phys);
+        if (!buf) {
+            send_str("fwput: no-mem\n");
+            return;
+        }
+        if (slot->data) {
+            IOFreeContiguous(slot->data, slot->cap);
+        }
+        slot->data = buf;
+        slot->cap = size;
+    }
+
+    slot->len = size;
+    slot->crc = crc;
+    strlcpy(slot->name, name, sizeof(slot->name));
+    slot->used = true;
+
+    fwput_rx_active = true;
+    fwput_rx_slot = slot;
+    fwput_rx_len = size;
+    fwput_rx_got = 0;
+    fwput_rx_crc = crc;
+    fwput_reset_deadline();
+
+    char reply[64];
+    snprintf(reply, sizeof(reply), "fwput: ready %u\n", size);
+    send_str(reply);
+}
+
+static void
+cmd_handle_fwlist(void)
+{
+    char reply[256];
+    int n = 0;
+
+    for (unsigned i = 0; i < FWPUT_MAX_SLOTS; i++) {
+        if (fwput_slots[i].used) {
+            n += snprintf(reply + n, sizeof(reply) - (size_t)n, "%s %u %08x\n",
+                fwput_slots[i].name, fwput_slots[i].len, fwput_slots[i].crc);
+        }
+    }
+    if (n == 0) {
+        send_str("fwlist: (empty)\n");
+    } else {
+        send_str(reply);
+    }
+}
+
+/*
+ * Look up an uploaded firmware blob by name. Returns 0 and sets *data and *len on
+ * success, -1 if not found. The returned pointer stays valid until the next
+ * `fwput` that replaces the same name (or a timeout discards it).
+ */
+int
+pong_fw_lookup(const char *name, const uint8_t **data, uint32_t *len)
+{
+    for (unsigned i = 0; i < FWPUT_MAX_SLOTS; i++) {
+        if (fwput_slots[i].used && strcmp(fwput_slots[i].name, name) == 0) {
+            if (data) {
+                *data = fwput_slots[i].data;
+            }
+            if (len) {
+                *len = fwput_slots[i].len;
+            }
+            return 0;
+        }
+    }
+    return -1;
+}
+
