 extern void pong_wifi_tools_init(void);                                     /* pong_wifi_tools.c: Wi-Fi starts by itself */
+/* pong_boot_write.c: a new boot image received over this channel and written to the boot partition */
+extern int pong_boot_usb(char *reply, size_t cap, const char *cmd);
+extern int pong_boot_rx_active(void);
+extern int pong_boot_feed(const uint8_t *data, unsigned len, char *reply, size_t cap);
