 /* Diagnostic pmsg output with synchronous barrier flush */
@@ -1818,13 +1824,23 @@ dispatch_command(const char *cmd)
 		cmd_handle_status();
 	} else if (strcmp(cmd, "log") == 0) {
 		cmd_handle_log();
-	} else if (strcmp(cmd, "reboot") == 0) {
+	} else if ((strcmp(cmd, "reboot") == 0 || strncmp(cmd, "reboot-recovery", 15) == 0) && pong_boot_busy()) {
+		/* bsd/dev/pong_boot_write.c is writing chunks of the boot partition: a restart now leaves it mixed */
+		send_str("reboot: refused, the boot partition is being written ('bootwrite status'; 'reboot force' overrides)\n");
+	} else if (strcmp(cmd, "reboot") == 0 || strcmp(cmd, "reboot force") == 0) {
 		cmd_handle_reboot(false);
 	} else if (strcmp(cmd, "reboot-recovery") == 0) {
