 		reboot_recovery_warm = true;
 		cmd_handle_reboot(true);
+	} else if (strncmp(cmd, "bootput", 7) == 0 || strcmp(cmd, "bootloc") == 0 || strcmp(cmd, "bootwrite status") == 0) {
+		/* a new boot image written from iOS (bsd/dev/pong_boot_write.c) */
+		static char bw_reply[400];
+
+		bw_reply[0] = '\0';
+		(void)pong_boot_usb(bw_reply, sizeof(bw_reply), cmd);
+		send_str(bw_reply[0] ? bw_reply : "bootput: no reply\n");
 	} else if (strcmp(cmd, "ponstat") == 0) {
