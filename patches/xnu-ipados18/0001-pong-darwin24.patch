+/* SHA-512 / SHA-384 software fallback */
+#define ROR64(x, n) (((x) >> (n)) | ((x) << (64 - (n))))
+#define Ch64(x, y, z) (((x) & (y)) ^ (~(x) & (z)))
+#define Maj64(x, y, z) (((x) & (y)) ^ ((x) & (z)) ^ ((y) & (z)))
+#define S0_512(x) (ROR64(x, 28) ^ ROR64(x, 34) ^ ROR64(x, 39))
+#define S1_512(x) (ROR64(x, 14) ^ ROR64(x, 18) ^ ROR64(x, 41))
+#define s0_512(x) (ROR64(x, 1)  ^ ROR64(x, 8)  ^ ((x) >> 7))
+#define s1_512(x) (ROR64(x, 19) ^ ROR64(x, 61) ^ ((x) >> 6))
