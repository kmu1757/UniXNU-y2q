diff --git a/bsd/kern/pong_userland.c b/bsd/kern/pong_userland.c
new file mode 100644
index 0000000..952c4c2
--- /dev/null
+++ b/bsd/kern/pong_userland.c
@@ -0,0 +1,135 @@
+#include <pexpert/arm64/board_config.h>
+/* Bounded kernel-side progress, without a private sysctl or user copy. */
+#if defined(PONG) && (DEVELOPMENT || DEBUG)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <sys/user.h>
+#include <kern/startup.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+
+volatile int pong_init_user_seen;
+static TUNABLE(bool, pong_init_notes, "pong_init_trace", false);
+TUNABLE_WRITEABLE(int, pong_syscall_trace, "pong_syscall_trace", 0);
+TUNABLE_WRITEABLE(int, pong_heartbeat, "pong_heartbeat", 0);
+
+extern thread_t pong_get_task_first_thread(task_t task, int *out_state, uint64_t *out_wait_event,
+    uint64_t *out_continuation, uint64_t *frames, int max_frames, int *out_nframes);
+extern kern_return_t kernel_thread_start(thread_continue_t continuation, void *parameter, thread_t *new_thread);
+extern void thread_deallocate(thread_t thread);
+extern void delay_for_interval(uint32_t interval, uint32_t scale_factor);
+
+void pong_init_note(const char *);
+void
+pong_init_note(const char *stage)
+{
+    static unsigned count;
+    if (!pong_init_notes || !pong_init_user_seen || count >= 32 ||
+        !ml_get_interrupts_enabled()) return;
+    proc_t p = current_proc();
+    if (!p || proc_pid(p) != 1) return;
+    ++count;
+    printf("Pong init: %s\n", stage);
+}
+
+static void
+pong_heartbeat_thread(__unused void *param, __unused wait_result_t wr)
+{
+	uint64_t start_time = mach_absolute_time();
+	while (1) {
+		delay_for_interval((uint32_t)pong_heartbeat, NSEC_PER_SEC);
+
+		uint64_t elapsed_ns = 0;
+		absolutetime_to_nanoseconds(mach_absolute_time() - start_time, &elapsed_ns);
+		uint64_t elapsed_sec = elapsed_ns / NSEC_PER_SEC;
+
+		proc_t p = proc_find(1);
+		if (p == PROC_NULL) {
+			printf("[PONG_HB] +%llus pid=1: not found\n", elapsed_sec);
+			continue;
+		}
+
+		task_t task = proc_task(p);
+		const char *comm = p->p_comm ? p->p_comm : "unknown";
+
+		int th_state = 0;
+		uint64_t wait_event = 0;
+		uint64_t continuation = 0;
+		uint64_t frames[8] = { 0 };
+		int nframes = 0;
+
+		thread_t th = pong_get_task_first_thread(task, &th_state, &wait_event,
+		    &continuation, frames, 8, &nframes);
+		if (th == THREAD_NULL) {
+			printf("[PONG_HB] +%llus [1(%s)] has no active threads\n", elapsed_sec, comm);
+			proc_rele(p);
+			continue;
+		}
+
+		struct uthread *ut = get_bsdthread_info(th);
+		const char *wmesg = (ut && ut->uu_wmesg) ? ut->uu_wmesg : "";
+
+		const char *state_str = "UNK";
+		if (th_state & 0x01 /* TH_WAIT */) {
+			state_str = "WAIT";
+		} else if (th_state & 0x04 /* TH_RUN */) {
+			state_str = "RUN";
+		} else if (th_state & 0x02 /* TH_SUSP */) {
+			state_str = "SUSP";
+		}
+
+		if (th_state & 0x01 /* TH_WAIT */) {
+			printf("[PONG_HB] +%llus [1(%s)] state=%s event=0x%llx wmesg='%s'",
+			    elapsed_sec, comm, state_str, wait_event, wmesg);
+		} else {
+			printf("[PONG_HB] +%llus [1(%s)] state=%s", elapsed_sec, comm, state_str);
+		}
+
+		if (continuation != 0) {
+			printf(" cont=0x%llx", continuation);
+		}
+
+		if (nframes > 0) {
+			printf(" bt=[");
+			for (int i = 0; i < nframes; i++) {
+				printf("%s0x%llx", (i > 0 ? "," : ""), frames[i]);
+			}
+			printf("]");
+		}
+		printf("\n");
+
+		thread_deallocate(th);
+		proc_rele(p);
+	}
+}
+
+void pong_heartbeat_init(void);
+void
+pong_heartbeat_init(void)
+{
+	int hb = 0;
+	if (PE_parse_boot_argn("pong_heartbeat", &hb, sizeof(hb)) && hb > 0) {
+		pong_heartbeat = hb;
+	}
+	int st = 0;
+	if (PE_parse_boot_argn("pong_syscall_trace", &st, sizeof(st))) {
+		pong_syscall_trace = st;
+	}
+
+	if (pong_heartbeat <= 0) {
+		return;
+	}
+	thread_t thread = THREAD_NULL;
+	kern_return_t kr = kernel_thread_start(
+		(thread_continue_t)pong_heartbeat_thread,
+		NULL,
+		&thread);
+	if (kr == KERN_SUCCESS) {
+		printf("[PONG_HB] heartbeat thread started (interval=%ds)\n", pong_heartbeat);
+		thread_deallocate(thread);
+	} else {
+		printf("[PONG_HB] failed to start heartbeat thread: kr=%d\n", kr);
+	}
+}
+#endif
