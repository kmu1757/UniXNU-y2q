+#define PONG_RAMOOPS_PHYS_BASE          0x9FA00000ULL
+#define PONG_RAMOOPS_RESERVED_BYTES     0x00100000U
+#define PONG_RAMOOPS_CONSOLE_OFFSET     0x00040000U
+#define PONG_RAMOOPS_CONSOLE_BYTES      0x00040000U
+#define PONG_RAMOOPS_DIAG_OFFSET        0x000C0000U
+#define PONG_RAMOOPS_DIAG_BYTES         0x00040000U
+
+#define PONG_RAMOOPS_HEADER_BYTES       12U
+#define PONG_RAMOOPS_MAGIC              0x43474244U
+
+struct pong_ramoops_header {
+	volatile uint32_t sig;
+	volatile uint32_t start;
+	volatile uint32_t size;
+};
+
+static vm_offset_t pong_ramoops_base;
+static uint32_t pong_ramoops_capacity;
+static uint32_t pong_ramoops_start;
+static uint32_t pong_ramoops_size;
+static volatile uint32_t pong_ramoops_busy;
+
+static vm_offset_t pong_diagnostic_base;
+static uint32_t pong_diagnostic_capacity;
+static volatile uint32_t pong_diagnostic_busy;
+static uint32_t pong_diagnostic_size;
+
+/* Keep a bounded record in the pmsg zone so console traffic does not evict early diagnostic data.
+ * Linux pstore exposes this as pmsg-ramoops-0.
+ */
+void pong_ramoops_diagnostic_write(const char *, int);
+void
+pong_ramoops_diagnostic_write(const char *text, int length)
+{
+	if (!text || length <= 0 || length > 2048 || !pong_diagnostic_base ||
+	    __atomic_exchange_n(&pong_diagnostic_busy, 1, __ATOMIC_ACQUIRE)) return;
+	vm_offset_t base = pong_diagnostic_base;
+	struct pong_ramoops_header *header = (struct pong_ramoops_header *)(uintptr_t)base;
+	volatile uint8_t *data = (volatile uint8_t *)(uintptr_t)(base + PONG_RAMOOPS_HEADER_BYTES);
+	uint32_t cap = pong_diagnostic_capacity ? pong_diagnostic_capacity : (PONG_RAMOOPS_DIAG_BYTES - PONG_RAMOOPS_HEADER_BYTES);
+	uint32_t count = (uint32_t)length;
+	if (count > cap - pong_diagnostic_size)
+		count = cap - pong_diagnostic_size;
+	if (count) {
+		for (uint32_t i = 0; i < count; i++) data[pong_diagnostic_size + i] = (uint8_t)text[i];
+		FlushPoC_DcacheRegion(base + PONG_RAMOOPS_HEADER_BYTES + pong_diagnostic_size, count);
+		__asm__ volatile("dsb sy" ::: "memory");
+		pong_diagnostic_size += count;
+		header->start = pong_diagnostic_size;
+		header->size = pong_diagnostic_size;
+		header->sig = PONG_RAMOOPS_MAGIC;
+		FlushPoC_DcacheRegion(base, PONG_RAMOOPS_HEADER_BYTES);
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	__atomic_store_n(&pong_diagnostic_busy, 0, __ATOMIC_RELEASE);
+}
+
+void pong_ramoops_console_write(const char *, int);
+void
+pong_ramoops_console_write(const char *text, int length)
+{
+	if (!text || length <= 0 || !pong_ramoops_base ||
+	    __atomic_exchange_n(&pong_ramoops_busy, 1, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+
+	const uint32_t capacity = pong_ramoops_capacity ? pong_ramoops_capacity : (PONG_RAMOOPS_CONSOLE_BYTES - PONG_RAMOOPS_HEADER_BYTES);
+	uint32_t old_size = pong_ramoops_size;
+	uint32_t write_at = old_size < capacity ?
+	    (pong_ramoops_start + old_size) % capacity : pong_ramoops_start;
+	uint32_t count = (uint32_t)length;
+	uint32_t skip = 0;
+	if (count > capacity) {
+		skip = count - capacity;
+		count = capacity;
+	}
+	uint32_t data_at = (write_at + skip) % capacity;
+	const char *source = text + skip;
+	volatile uint8_t *data = (volatile uint8_t *)(uintptr_t)
+	    (pong_ramoops_base + PONG_RAMOOPS_HEADER_BYTES);
+	uint32_t first = capacity - data_at;
+	if (first > count) {
+		first = count;
+	}
+	for (uint32_t i = 0; i < first; i++) {
+		data[data_at + i] = (uint8_t)source[i];
+	}
+	uint32_t second = count - first;
+	for (uint32_t i = 0; i < second; i++) {
+		data[i] = (uint8_t)source[first + i];
+	}
+
+	if (first) {
+		FlushPoC_DcacheRegion((vm_offset_t)(uintptr_t)(data + data_at), first);
+	}
+	if (second) {
+		FlushPoC_DcacheRegion((vm_offset_t)(uintptr_t)data, second);
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	uint64_t total = (uint64_t)old_size + (uint32_t)length;
+	uint32_t new_size = total >= capacity ? capacity : (uint32_t)total;
+	uint32_t new_start = total > capacity ?
+	    (uint32_t)((pong_ramoops_start + total - capacity) % capacity) : pong_ramoops_start;
+	struct pong_ramoops_header *header =
+	    (struct pong_ramoops_header *)(uintptr_t)pong_ramoops_base;
+	header->start = new_start;
+	header->size = new_size;
+	__asm__ volatile("dsb sy" ::: "memory");
+	FlushPoC_DcacheRegion(pong_ramoops_base, PONG_RAMOOPS_HEADER_BYTES);
+	__asm__ volatile("dsb sy" ::: "memory");
+	pong_ramoops_start = new_start;
+	pong_ramoops_size = new_size;
+	__atomic_store_n(&pong_ramoops_busy, 0, __ATOMIC_RELEASE);
+}
+
+int
+pong_ramoops_console_init(void)
+{
+	if (pong_ramoops_base) {
+		return 1;
+	}
+
+	uint64_t phys_base = PONG_RAMOOPS_PHYS_BASE;
+	uint32_t reserved_bytes = PONG_RAMOOPS_RESERVED_BYTES;
+	uint32_t console_offset = PONG_RAMOOPS_CONSOLE_OFFSET;
+	uint32_t console_bytes = PONG_RAMOOPS_CONSOLE_BYTES;
+	uint32_t diag_offset = PONG_RAMOOPS_DIAG_OFFSET;
+	uint32_t diag_bytes = PONG_RAMOOPS_DIAG_BYTES;
+
+	DTEntry chosen;
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) == kSuccess) {
+		void const *prop = NULL;
+		unsigned int plen = 0;
+		if (SecureDTGetProperty(chosen, "pong,ramoops-phys", &prop, &plen) == kSuccess &&
+		    prop && plen == 16) {
+			const uint64_t *val = (const uint64_t *)prop;
+			if (val[0] && val[1]) {
+				phys_base = val[0];
+				reserved_bytes = (uint32_t)val[1];
+			}
+		}
+		if (SecureDTGetProperty(chosen, "pong,ramoops-layout", &prop, &plen) == kSuccess &&
+		    prop && plen == 16) {
+			const uint32_t *l = (const uint32_t *)prop;
+			console_offset = l[0];
+			console_bytes = l[1];
+			diag_offset = l[2];
+			diag_bytes = l[3];
+		}
+	}
+
+	vm_offset_t mapped = ml_io_map_wcomb(phys_base, reserved_bytes);
+	if (!mapped) {
+		return 0;
+	}
+
+	pong_ramoops_base = mapped + console_offset;
+	pong_ramoops_capacity = console_bytes > PONG_RAMOOPS_HEADER_BYTES ?
+	    (console_bytes - PONG_RAMOOPS_HEADER_BYTES) : 0;
+
+	struct pong_ramoops_header *c_header =
+	    (struct pong_ramoops_header *)(uintptr_t)pong_ramoops_base;
+	c_header->sig = 0;
+	c_header->start = 0;
+	c_header->size = 0;
+	__asm__ volatile("dsb sy" ::: "memory");
+	FlushPoC_DcacheRegion(pong_ramoops_base, PONG_RAMOOPS_HEADER_BYTES);
+	c_header->sig = PONG_RAMOOPS_MAGIC;
+	__asm__ volatile("dsb sy" ::: "memory");
+	FlushPoC_DcacheRegion(pong_ramoops_base, PONG_RAMOOPS_HEADER_BYTES);
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	pong_ramoops_start = 0;
+	pong_ramoops_size = 0;
+
+	if (diag_bytes > PONG_RAMOOPS_HEADER_BYTES && diag_offset + diag_bytes <= reserved_bytes) {
+		pong_diagnostic_base = mapped + diag_offset;
+		pong_diagnostic_capacity = diag_bytes - PONG_RAMOOPS_HEADER_BYTES;
+		struct pong_ramoops_header *d_header =
+		    (struct pong_ramoops_header *)(uintptr_t)pong_diagnostic_base;
+		d_header->sig = 0;
+		d_header->start = 0;
+		d_header->size = 0;
+		__asm__ volatile("dsb sy" ::: "memory");
+		FlushPoC_DcacheRegion(pong_diagnostic_base, PONG_RAMOOPS_HEADER_BYTES);
+		d_header->sig = PONG_RAMOOPS_MAGIC;
+		__asm__ volatile("dsb sy" ::: "memory");
+		FlushPoC_DcacheRegion(pong_diagnostic_base, PONG_RAMOOPS_HEADER_BYTES);
+		__asm__ volatile("dsb sy" ::: "memory");
+		pong_diagnostic_size = 0;
+	}
+
+	static const char ready[] = "XNU T970 RAMOOPS CONSOLE READY (0x9FA40000, 256K)\n";
+	pong_ramoops_console_write(ready, (int)sizeof(ready)-1);
+	pong_ramoops_diagnostic_write(ready, (int)sizeof(ready)-1);
+	return 1;
+}
diff --git a/osfmk/arm64/pong_ui_exception.c b/osfmk/arm64/pong_ui_exception.c
new file mode 100644
index 0000000..cf3892c
--- /dev/null
+++ b/osfmk/arm64/pong_ui_exception.c
@@ -0,0 +1,144 @@
+/* Bounded UI crash capture derived from the earlier user_exception_trace.c.
+ * Exception delivery is unchanged; no polling threads or periodic probes.
+ */
+#include <pexpert/arm64/board_config.h>
+#if (defined(ARM64_BOARD_CONFIG_PONG) || defined(PONG)) && (DEVELOPMENT || DEBUG)
+#include <arm/thread.h>
+#include <kern/misc_protos.h>
+#include <kern/queue.h>
+#include <kern/task.h>
+#include <kern/thread.h>
+#include <mach/exception_types.h>
+#include <machine/machine_routines.h>
+#include <string.h>
+#include <vm/vm_map.h>
+#include <vm/vm_shared_region_xnu.h>
+
+extern char *proc_name_address(struct proc *p);
+extern int proc_pid(struct proc *p);
+void pong_ui_exception(exception_type_t, mach_exception_data_t,
+    mach_msg_type_number_t, thread_t);
+thread_t pong_get_task_first_thread(task_t task, int *out_state, uint64_t *out_wait_event,
+    uint64_t *out_continuation, uint64_t *frames, int max_frames, int *out_nframes);
+
+void
+pong_ui_exception(exception_type_t exception, mach_exception_data_t code,
+    mach_msg_type_number_t count, thread_t thread)
+{
+	static const char * const names[] = { "SpringBoard", "backboardd", "containermanagerd", "contextstored", "biomed", "notifyd" };
+	static unsigned records[sizeof(names) / sizeof(names[0])];
+	static const unsigned message_regs[] = { 0, 1, 2, 3, 8, 16, 20, 21 };
+	if (!ml_get_interrupts_enabled() || thread != current_thread() ||
+	    (exception != EXC_BREAKPOINT && exception != EXC_BAD_INSTRUCTION)) return;
+	task_t task = get_threadtask(thread);
+	const arm_saved_state_t *state = get_user_regs(thread);
+	struct proc *proc = get_bsdtask_info(task);
+	if (task == kernel_task || proc == NULL || state == NULL || !is_saved_state64(state)) return;
+	const char *name = proc_name_address(proc);
+	unsigned which;
+	for (which = 0; which < sizeof(names) / sizeof(names[0]) && strcmp(name, names[which]) != 0; which++) { }
+	if (which == sizeof(names) / sizeof(names[0]) || __atomic_fetch_add(&records[which], 1, __ATOMIC_RELAXED) >= 4) return;
+	vm_shared_region_t region = vm_shared_region_get(task);
+	uint32_t slide = region ? region->sr_slide : 0;
+	if (region) vm_shared_region_deallocate(region);
+	printf("Pong UI crash: %s[%d] exception=%d code=0x%llx/0x%llx pc=0x%llx lr=0x%llx sp=0x%llx cache_slide=0x%x\n",
+	    name, proc_pid(proc), exception, count ? code[0] : 0, count > 1 ? code[1] : 0,
+	    (uint64_t)get_saved_state_pc(state), (uint64_t)get_saved_state_lr(state),
+	    (uint64_t)get_saved_state_sp(state), slide);
+	for (unsigned i = 0; i < sizeof(message_regs) / sizeof(message_regs[0]); i++) {
+		user_addr_t address = get_saved_state_reg(state, message_regs[i]);
+		char text[128] = { 0 };
+		vm_size_t length = 0;
+		if (address < 0x100000000ULL || address >= MACH_VM_MAX_ADDRESS ||
+		    copyinstr(address, text, sizeof(text) - 1, &length) != 0 || length < 7) continue;
+		bool printable = true;
+		for (unsigned c = 0; c < 6; c++) printable &= text[c] >= 0x20 && text[c] < 0x7f;
+		if (printable) printf("Pong UI crash: x%u text=%s\n", message_regs[i], text);
+	}
+	uint64_t fp = get_saved_state_fp(state), sp = get_saved_state_sp(state), frame[2];
+	for (unsigned depth = 0; depth < 12; depth++) {
+		if (fp < sp || fp - sp > 1024 * 1024 || fp >= MACH_VM_MAX_ADDRESS - sizeof(frame) ||
+		    (fp & 15) || copyin(fp, frame, sizeof(frame)) != 0) break;
+		printf("Pong UI crash: frame%u lr=0x%llx\n", depth, frame[1]);
+		if (frame[0] <= fp) break;
+		fp = frame[0];
+	}
+}
+
+thread_t
+pong_get_task_first_thread(task_t task, int *out_state, uint64_t *out_wait_event,
+    uint64_t *out_continuation, uint64_t *frames, int max_frames, int *out_nframes)
+{
+	*out_state = 0;
+	*out_wait_event = 0;
+	*out_continuation = 0;
+	*out_nframes = 0;
+
+	if (task == TASK_NULL) {
+		return THREAD_NULL;
+	}
+
+	task_lock(task);
+	if (!task->active) {
+		task_unlock(task);
+		return THREAD_NULL;
+	}
+
+	thread_t th = (thread_t)(void *)queue_first(&task->threads);
+	if (queue_end(&task->threads, (queue_entry_t)th)) {
+		task_unlock(task);
+		return THREAD_NULL;
+	}
+
+	thread_reference(th);
+	task_unlock(task);
+
+	*out_state = th->state;
+	*out_wait_event = (uint64_t)th->wait_event;
+	*out_continuation = th->continuation ? (uint64_t)VM_KERNEL_UNSLIDE(th->continuation) : 0;
+
+	if (th->continuation != NULL) {
+		if (max_frames > 0) {
+			frames[0] = *out_continuation;
+			*out_nframes = 1;
+		}
+	} else if (th->kernel_stack != 0) {
+		vm_offset_t kstack_bottom = th->kernel_stack;
+		vm_offset_t kstack_top = kstack_bottom + kernel_stack_size;
+		arm_kernel_saved_state_t *kstate = &thread_get_kernel_state(th)->machine.ss;
+		uint64_t fp = kstate->fp;
+		uint64_t lr = kstate->lr;
+		int count = 0;
+
+		if (lr != 0 && count < max_frames) {
+#if defined(HAS_APPLE_PAC)
+			lr = (uint64_t)ptrauth_strip((void *)lr, ptrauth_key_return_address);
+#endif
+			frames[count++] = (uint64_t)VM_KERNEL_UNSLIDE(lr);
+		}
+
+		while (count < max_frames) {
+			if (fp < kstack_bottom || fp + 16 > kstack_top || (fp & 7) != 0) {
+				break;
+			}
+			uint64_t next_fp = *(uint64_t *)fp;
+			uint64_t next_lr = *(uint64_t *)(fp + 8);
+#if defined(HAS_APPLE_PAC)
+			next_lr = (uint64_t)ptrauth_strip((void *)next_lr, ptrauth_key_return_address);
+#endif
+			next_lr = (uint64_t)VM_KERNEL_UNSLIDE(next_lr);
+			if (next_lr == 0) {
+				break;
+			}
+			frames[count++] = next_lr;
+			if (next_fp <= fp || next_fp >= kstack_top) {
+				break;
+			}
+			fp = next_fp;
+		}
+		*out_nframes = count;
+	}
+
+	return th;
+}
+#endif
