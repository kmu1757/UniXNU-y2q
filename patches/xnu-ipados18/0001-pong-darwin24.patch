+static uint64_t
+load64_be(const uint8_t *p)
+{
+	return ((uint64_t)p[0] << 56) |
+	       ((uint64_t)p[1] << 48) |
+	       ((uint64_t)p[2] << 40) |
+	       ((uint64_t)p[3] << 32) |
+	       ((uint64_t)p[4] << 24) |
+	       ((uint64_t)p[5] << 16) |
+	       ((uint64_t)p[6] << 8)  |
+	       ((uint64_t)p[7]);
+}
+
+static void
+sha512_sw_transform(uint64_t state[8], const uint8_t buffer[128])
+{
+	uint64_t a = state[0], b = state[1], c = state[2], d = state[3];
+	uint64_t e = state[4], f = state[5], g = state[6], h = state[7];
+	uint64_t w[80];
+	int i;
+
+	for (i = 0; i < 16; i++) {
+		w[i] = load64_be(&buffer[i * 8]);
+	}
+	for (i = 16; i < 80; i++) {
+		w[i] = s1_512(w[i - 2]) + w[i - 7] + s0_512(w[i - 15]) + w[i - 16];
+	}
+	for (i = 0; i < 80; i++) {
+		uint64_t t1 = h + S1_512(e) + Ch64(e, f, g) + k512[i] + w[i];
+		uint64_t t2 = S0_512(a) + Maj64(a, b, c);
+		h = g;
+		g = f;
+		f = e;
+		e = d + t1;
+		d = c;
+		c = b;
+		b = a;
+		a = t1 + t2;
+	}
+
+	state[0] += a;
+	state[1] += b;
+	state[2] += c;
+	state[3] += d;
+	state[4] += e;
+	state[5] += f;
+	state[6] += g;
+	state[7] += h;
+}
