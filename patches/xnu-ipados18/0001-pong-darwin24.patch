+int
+_psynch_rw_yieldwrlock(__unused proc_t p, __unused user_addr_t rwlock,
+		__unused uint32_t lgenval, __unused uint32_t ugenval,
+		__unused uint32_t rw_wc, __unused int flags, __unused uint32_t *retval)
+{
+	return ESRCH;
