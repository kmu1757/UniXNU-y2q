+
+#include "MiniIOSurface.h"
+
+static_assert(sizeof(struct minisurf_plane) == 0x80, "plane layout");
+static_assert(sizeof(struct minisurf_result) == 0x68, "result layout");
+static_assert(offsetof(struct minisurf_shared, attachments) == 0x30, "shared layout");
+static_assert(offsetof(struct minisurf_shared, wiringAssertionCount) == 0x24, "22H374 wiring count");
+static_assert(offsetof(struct minisurf_aux, detachModeCode) == 0x28, "22H374 detach state");
+
+/* 22H374 IOSurfaceClient copies its reply at client+0x70. Geometry and
+ * allocation fields are now uint64_t; the plane stride is 0x98, not 0x80.
+ * Keep internal 512 MiB/dimension limits and translate only at the ABI edge.
+ */
+struct minisurf_result18 {
+	uint64_t base, shared, aux;
+	uint32_t sid, reserved1c;
+	uint64_t allocSize, width, height, bytesPerRow, offset;
+	uint32_t pixelFormat, reserved4c;
+	uint64_t reserved50;
+	uint32_t planeCount, reserved5c;
+	uint16_t bytesPerElement;
+	uint8_t elementWidth, elementHeight;
+	uint32_t cacheMode, lockSeed;
+	uint8_t subsampling, prohibitUseCount;
+	uint16_t reserved6e;
+	uint32_t parentID, sliceCount;
+	uint64_t traceID, protectionOptions;
+};
+struct minisurf_plane18 {
+	uint64_t width, height, reserved10, offset, bytesPerRow, size;
+	uint16_t bytesPerElement;
+	uint8_t elementWidth, elementHeight, componentCount, addressFormat, reserved36[2];
+	uint8_t componentBitDepth[4], componentBitOffset[4], componentName[4], componentType[4], componentRange[4];
+	uint8_t reserved4c[0x20], compression, reserved6d[0x1b];
+	uint32_t extendedPixels[4];
+};
+static_assert(sizeof(minisurf_result18) == 0x88, "22H374 surface reply");
+static_assert(offsetof(minisurf_result18, allocSize) == 0x20, "22H374 allocation size");
+static_assert(offsetof(minisurf_result18, planeCount) == 0x58, "22H374 plane count");
+static_assert(offsetof(minisurf_result18, protectionOptions) == 0x80, "22H374 protection options");
+static_assert(sizeof(minisurf_plane18) == 0x98, "22H374 plane stride");
+static_assert(offsetof(minisurf_plane18, offset) == 0x18, "22H374 plane offset");
+static_assert(offsetof(minisurf_plane18, compression) == 0x6c, "22H374 compression flag");
+static_assert(sizeof(minisurf_result18) + MINISURF_MAX_PLANES * sizeof(minisurf_plane18) == MINISURF_RESULT_MAX, "22H374 max reply");
+
+/* IOConnectCallMethod selectors used by 22H374 IOSurfaceRootUserClient. */
+enum {
+	kSurfaceMethodCreate            = 0,
+	kSurfaceMethodLookup            = 4,
+	kSurfaceMethodSetYCbCrMatrix    = 5,
+	kSurfaceMethodWrapClientImage   = 6,
+	kSurfaceMethodWrapClientMemory  = 7,
