+static uint32_t         gSurfaceNext = 1;
+static uint32_t         gSurfaceCount;
+static uint64_t         gSurfaceBytes;
+static uint32_t         gSurfaceUnheld;         /* surfaces around client memory that could not be made (said a few times) */
