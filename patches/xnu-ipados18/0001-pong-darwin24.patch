+	{ 0x3b, 0x3c }, { 0x3c, 0x3d }, { 0x3d, 0x3e }, { 0x3e, 0x3f }, { 0x3f, 0x40 }, { 0x40, 0x58 },
+	{ 0x58, 0x5c }, { 0x5c, 0x64 }, { 0x64, 0x65 }, { 0x68, 0x70 }, { 0x70, 0x74 }, { 0x65, 0x66 },
+};
+#define MINISURF_ATTACHMENT_MASK ((1ULL << 18) - 1)
+#define MINISURF_VALUE_HEADER 12u
+
+#define kSurfaceLockReadOnly    1u
+
+#define MINISURF_TABLE_SIZE     16384
+#define MINISURF_MAX_DIMENSION  16384
+#define MINISURF_MAX_ALLOC      (512u << 20)
