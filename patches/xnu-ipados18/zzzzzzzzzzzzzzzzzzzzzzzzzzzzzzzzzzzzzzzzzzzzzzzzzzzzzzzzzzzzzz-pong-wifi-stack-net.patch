+/* The network side asks for the next step now (a frame to send), and logs through the same lines. */
+void
+pong_wifi_wake(void)
+{
+	__atomic_store_n(&ws.wake, 1, __ATOMIC_RELEASE);
+}
+
+void
+native_wifi_logf(int level, const char *fmt, ...)
+{
+	char line[200];
+	va_list ap;
+
+	va_start(ap, fmt);
+	vsnprintf(line, sizeof(line), fmt, ap);
+	va_end(ap);
+	ws_log(level, line);
+}
