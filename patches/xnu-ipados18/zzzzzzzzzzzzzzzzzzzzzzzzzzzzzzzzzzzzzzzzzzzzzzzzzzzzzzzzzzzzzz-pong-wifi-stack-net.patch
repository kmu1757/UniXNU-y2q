+				ws.net = 1;
+				ws.net_rc = t970_wifi_net_up(st.mac);
+				ws_log(6, ws.net_rc ? "the network side did not start" : "station ready: en0 published, first scan asked");
+				if (!ws.net_rc) {
+					(void)nw_wifi_scan(NULL, 0);
+				}
+			}
+		}
+		if (busy < 0) {
+			delay_for_interval(100, 1000000u);
