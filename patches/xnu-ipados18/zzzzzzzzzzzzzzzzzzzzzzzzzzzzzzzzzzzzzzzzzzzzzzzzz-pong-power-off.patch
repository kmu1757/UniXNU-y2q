+/* ---- power off and restart through the PMIC ----------------------------------------------------------------
+ * Nothing answers PEHaltRestart on this board (panic "Halt/Restart Timed Out" 30 s later) and PSCI SYSTEM_RESET
+ * returns without a reset (both measured 11-10), so "power off" in iPadOS left the tablet running. The stock
+ * kernel's way: gts7xlwifi.dts restart@c264000 "qcom,pshold" and qcom,power-on@800 with "qcom,system-reset" on the
+ * PM8150 (SID 0). The PON peripheral says what PS_HOLD going low means; then PS_HOLD is dropped.
+ * Values as Linux drivers/input/misc/pm8941-pwrkey.c (no code taken): PS_HOLD_RST_CTL 0x5a type [3:0], 4 = shutdown;
+ * PS_HOLD_RST_CTL2 0x5b bit 7 = enable, cleared while the type changes. SPMI write as spmi-pmic-arb.c for arbiter
+ * v5: the peripheral's channel at chnls + 0x10000 * apid, WDATA0 +0x10, CMD +0 (extended write long = opcode 0),
+ * STATUS +8; only for a channel this execution environment (0) owns.
+ * A restart leaves the type as the boot loader set it: dropping PS_HOLD alone restarted the tablet on 11-10.
+ * With a charger or USB host attached the PMIC powers the board up again right after a shutdown.
+ */
+void pong_power_down(int howto);
+void pong_shutdown_failsafe(int howto);
+
+static bool write_register(const struct peripheral *p, uint8_t reg, uint8_t value)
+{
+    static vm_offset_t ch;
+
+    if (!p->found || v7 || !chnls_pa || !cnfg) return false;
+    if ((rd(cnfg + 0x700 + 4 * p->channel) & 7) != 0) return false;
+    if (!ch) ch = ml_io_map(chnls_pa + 0x10000ULL * p->channel, 0x1000);
+    if (!ch) return false;
+    uint64_t limit = 0;
+    clock_interval_to_deadline(2000, NSEC_PER_USEC, &limit);
+    wr(ch + 0x10, value);
+    wr(ch, (uint32_t)reg << 4);
+    uint32_t status;
+    do {
+        status = rd(ch + 8);
+    } while (!(status & 1) && mach_absolute_time() < limit);
+    return (status & 0xf) == 1;
+}
+
+/* howto: reboot(2) flags. Returns only when the board stayed up. */
+void pong_power_down(int howto)
+{
+    static vm_offset_t pshold;
+    bool halt = (howto & RB_HALT) != 0;
+
+    if (__atomic_exchange_n(&power_down_started, 1, __ATOMIC_ACQUIRE)) return;
+    delay_for_interval(80, NSEC_PER_MSEC);          /* the polling loop's last read is over */
+    if (halt) {
+        uint8_t ctl = 0, ctl2 = 0, after = 0, after2 = 0;
+        bool ok = read_registers(&pon, 0x5a, &ctl, 1) && read_registers(&pon, 0x5b, &ctl2, 1) &&
+            write_register(&pon, 0x5b, (uint8_t)(ctl2 & 0x7f));
+
+        if (ok) {
+            delay_for_interval(1, NSEC_PER_MSEC);   /* a few sleep clock cycles between the enable bit's writes */
+            ok = write_register(&pon, 0x5a, (uint8_t)((ctl & 0xf0) | 4)) &&
+                write_register(&pon, 0x5b, (uint8_t)(ctl2 | 0x80)) &&
+                read_registers(&pon, 0x5a, &after, 1) && read_registers(&pon, 0x5b, &after2, 1) &&
+                (after & 0x0f) == 4 && (after2 & 0x80);
+        }
+        pmsg_log("[PONG_PWR] off: pon=%d ctl %02x>%02x ctl2 %02x>%02x ok=%d\n", pon.found, ctl, after, ctl2, after2, ok);
+        if (!ok) {
+            /* PS_HOLD would restart the board instead: leave it, the caller goes on as before */
+            __atomic_store_n(&power_down_started, 0, __ATOMIC_RELEASE);
+            return;
+        }
+    }
+    if (!pshold) pshold = ml_io_map(0x0c264000UL, 0x1000);
+    if (!pshold) {
+        pmsg_log("[PONG_PWR] no PS_HOLD mapping\n");
+        return;
+    }
+    pmsg_log("[PONG_PWR] dropping PS_HOLD (%s)\n", halt ? "off" : "restart");
+    wr(pshold, 0);
+    delay_for_interval(1000, NSEC_PER_MSEC);
+    pmsg_log("[PONG_PWR] PS_HOLD dropped, still running\n");
+}
+
+static void shutdown_failsafe_fire(thread_call_param_t howto, __unused thread_call_param_t p1)
+{
+    pmsg_log("[PONG_PWR] shutdown stalled after the data volume was unmounted\n");
+    pong_power_down((int)(uintptr_t)howto);
+}
+
+/* reboot_kernel() calls this once the writable volumes are unmounted: if the rest of the shutdown (the sealed system
+ * volume's unmount took minutes on the same tablet, UniXNU-gts7xlwifi t970-shutdown-failsafe.patch) is not over in
+ * pong_shutdown_wait seconds (default 10, 0 = off), the board is powered down or restarted from here. */
+void pong_shutdown_failsafe(int howto)
+{
+    static thread_call_t call;
+    uint32_t seconds = 10;
+    uint64_t deadline = 0;
+
+    (void)PE_parse_boot_argn("pong_shutdown_wait", &seconds, sizeof(seconds));
+    if (!seconds || (howto & RB_PANIC) || call) return;
+    call = thread_call_allocate(shutdown_failsafe_fire, (thread_call_param_t)(uintptr_t)(unsigned)howto);
+    if (!call) return;
+    clock_interval_to_deadline(seconds, NSEC_PER_SEC, &deadline);
+    thread_call_enter_delayed(call, deadline);
+    pmsg_log("[PONG_PWR] shutdown failsafe armed, %u s\n", seconds);
+}
