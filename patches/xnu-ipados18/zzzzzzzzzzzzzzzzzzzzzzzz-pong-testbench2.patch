+#if defined(ARM64_BOARD_CONFIG_PONG) || defined(ARM64_BOARD_CONFIG_BCM2837)
+/*
+ * pong_task_prefer_cluster(): every QoS bucket of the task's thread group prefers this cluster, and
+ * its running and runnable threads move there. The USB command `tgprefer NAME N` calls it.
+ */
+extern struct thread_group *task_coalition_get_thread_group(task_t task);
+kern_return_t pong_task_prefer_cluster(task_t task, uint32_t cluster_id);
+
+kern_return_t
+pong_task_prefer_cluster(task_t task, uint32_t cluster_id)
+{
+	uint32_t preferred[TH_BUCKET_SCHED_MAX];
+	struct thread_group *tg;
+
+	if (task == TASK_NULL || cluster_id >= MAX_PSETS || pset_array[cluster_id] == PROCESSOR_SET_NULL) {
+		return KERN_INVALID_ARGUMENT;
+	}
+	tg = task_coalition_get_thread_group(task);
+	if (tg == NULL) {
+		return KERN_FAILURE;
+	}
+	for (int bucket = 0; bucket < TH_BUCKET_SCHED_MAX; bucket++) {
+		preferred[bucket] = cluster_id;
+	}
+	sched_edge_tg_preferred_cluster_change(tg, preferred,
+	    SCHED_PERFCONTROL_PREFERRED_CLUSTER_MIGRATE_RUNNING | SCHED_PERFCONTROL_PREFERRED_CLUSTER_MIGRATE_RUNNABLE);
+	return KERN_SUCCESS;
+}
+#endif
