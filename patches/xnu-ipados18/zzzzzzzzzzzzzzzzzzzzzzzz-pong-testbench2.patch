+/*
+ * top: the processes that used most CPU time since the previous `top` (the first call: since boot),
+ * in milliseconds. Pid 0 is the kernel.
+ */
+#define TOP_SEEN 512
+#define TOP_SHOWN 8
+
+struct top_state {
+	struct { int pid; uint64_t total; } seen[TOP_SEEN];
+	unsigned nseen;
+	struct { int pid; uint64_t delta; char name[20]; } best[TOP_SHOWN];
+	uint64_t sum;
+};
+
+static struct top_state top_state;
+
+static void
+top_account(int pid, const char *name, task_t task)
+{
+	struct proc_taskinfo_internal info;
+	uint64_t total, delta;
+	unsigned i, slot;
+
+	if (task == TASK_NULL) {
+		return;
+	}
+	bzero(&info, sizeof(info));
+	fill_taskprocinfo(task, &info);
+	total = info.pti_total_user + info.pti_total_system;
+	for (i = 0; i < top_state.nseen && top_state.seen[i].pid != pid; i++) {
+	}
+	if (i == top_state.nseen) {
+		if (top_state.nseen == TOP_SEEN) {
+			return;
+		}
+		top_state.seen[top_state.nseen++].pid = pid;
+		top_state.seen[i].total = 0;
+	}
+	delta = total >= top_state.seen[i].total ? total - top_state.seen[i].total : total;
+	top_state.seen[i].total = total;
+	top_state.sum += delta;
+	/* keep the TOP_SHOWN largest: replace the smallest kept one when this is larger */
+	slot = 0;
+	for (i = 1; i < TOP_SHOWN; i++) {
+		if (top_state.best[i].delta < top_state.best[slot].delta) {
+			slot = i;
+		}
+	}
+	if (delta > top_state.best[slot].delta) {
+		top_state.best[slot].pid = pid;
+		top_state.best[slot].delta = delta;
+		strlcpy(top_state.best[slot].name, name ? name : "?", sizeof(top_state.best[slot].name));
+	}
+}
+
+static int
+top_callout(proc_t p, __unused void *arg)
+{
+	if (proc_pid(p) != 0) {
+		top_account(proc_pid(p), proc_best_name(p), proc_task(p));
+	}
+	return 0;
+}
+
+static void
+cmd_handle_top(void)
+{
+	static uint64_t last_time;
+	char reply[400];
+	uint64_t now = mach_absolute_time(), ms = 0, value = 0;
+	int n;
+
+	bzero(top_state.best, sizeof(top_state.best));
+	top_state.sum = 0;
+	top_account(0, "kernel", kernel_task);
+	proc_iterate(PROC_ALLPROCLIST, top_callout, NULL, NULL, NULL);
+	absolutetime_to_nanoseconds(now - last_time, &ms);
+	last_time = now;
+	absolutetime_to_nanoseconds(top_state.sum, &value);
+	n = snprintf(reply, sizeof(reply), "top: %llu ms wall, %llu ms cpu:", ms / NSEC_PER_MSEC, value / NSEC_PER_MSEC);
+	for (unsigned shown = 0; shown < TOP_SHOWN; shown++) {
+		unsigned slot = 0;
+
+		/* largest first */
+		for (unsigned i = 1; i < TOP_SHOWN; i++) {
+			if (top_state.best[i].delta > top_state.best[slot].delta) {
+				slot = i;
+			}
+		}
+		if (top_state.best[slot].delta == 0) {
+			break;
+		}
+		absolutetime_to_nanoseconds(top_state.best[slot].delta, &value);
+		if (n > 0 && n < (int)sizeof(reply) - 40) {
+			n += snprintf(reply + n, sizeof(reply) - (size_t)n, " %s[%d]=%llu", top_state.best[slot].name,
+			    top_state.best[slot].pid, value / NSEC_PER_MSEC);
+		}
+		top_state.best[slot].delta = 0;
+	}
+	if (n > 0 && n < (int)sizeof(reply) - 2) {
+		reply[n] = '\n';
+		reply[n + 1] = '\0';
+	}
+	send_str(reply);
+}
+
+/* tgprefer NAME N: the thread group of every process called NAME prefers cluster N (0 Silver, 1 Gold, 2 Prime). */
+struct tgprefer_state {
+	char name[24];
+	uint32_t cluster;
+	unsigned matched;
+	int result;
+};
+
+static int
+tgprefer_callout(proc_t p, void *arg)
+{
+	struct tgprefer_state *state = (struct tgprefer_state *)arg;
+	const char *name = proc_best_name(p);
+
+	if (name && strcmp(name, state->name) == 0) {
+		state->matched++;
+		state->result = (int)pong_task_prefer_cluster(proc_task(p), state->cluster);
+	}
+	return 0;
+}
+
+static void
+cmd_handle_tgprefer(const char *args)
+{
+	struct tgprefer_state state = { .result = -1 };
+	const char *p = args;
+	char reply[80];
+	unsigned length = 0;
+
+	while (*p == ' ') {
+		p++;
+	}
+	while (*p && *p != ' ' && length < sizeof(state.name) - 1) {
+		state.name[length++] = *p++;
+	}
+	state.name[length] = '\0';
+	state.cluster = parse_uint(&p);
+	proc_iterate(PROC_ALLPROCLIST, tgprefer_callout, &state, NULL, NULL);
+	snprintf(reply, sizeof(reply), "tgprefer: %s cluster=%u matched=%u kr=%d\n", state.name, state.cluster, state.matched,
+	    state.result);
+	send_str(reply);
+}
+
 /* prefer N: the cluster every thread group prefers (0 Silver, 1 Gold, 2 Prime; 99: as before). */
 static void
 cmd_handle_prefer(const char *args)
@@ -971,8 +1128,12 @@ dispatch_command(const char *cmd)
