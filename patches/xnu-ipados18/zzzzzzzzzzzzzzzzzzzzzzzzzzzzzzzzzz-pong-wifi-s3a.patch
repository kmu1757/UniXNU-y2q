+/*
+ * wifis3a [bank]: after `wifiup` and `wifimhi`, read (never write) what the Wi-Fi chip's first DMA will depend on:
+ * the Apps SMMU's ID, fault and stream match registers, the PCIe controller's BDF->SID table, the endpoint's MSI and
+ * PCIe capabilities and the chip's boot state. `wifis3a bank` also reads the context bank a later stage would take.
+ */
+static void
+cmd_handle_wifis3a(int banks)
+{
+	char reply[640];
+
+	reply[0] = '\0';
+	(void)pong_wifi_stage3a(reply, sizeof(reply), banks);
+	send_str(reply[0] ? reply : "wifis3a: no reply\n");
+}
+
