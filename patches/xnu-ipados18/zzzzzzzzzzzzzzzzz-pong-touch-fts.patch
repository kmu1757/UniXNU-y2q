+/* STM FTS Touchscreen Driver (Samsung TSP, fts1ba90a) for SM-T970 (SM8250).
+ * Implements I2C via TLMM North Tile GPIO bit-banging (GPIO 12 SDA, GPIO 13 SCL, GPIO 15 INT).
+ * Powers on AVDD (3.3V) via PM8150 ldoa13 and DVDD (1.8V) via PM8150 ldoa14 using RPMh VRM voting.
+ * Dispatches touch events to the userland HID bridge via pong_touch_post().
+ * Reference: Linux fts5cu56a.c (MIT / GPL-2.0, JeyKul / Samsung downstream) and
+ * Qualcomm RPMh RSC / CMD-DB architecture.
+ */
+
+#include <pexpert/arm64/board_config.h>
+#if defined(PONG)
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/pong_input.h>
+#include <kern/sched_prim.h>
+#include <sys/systm.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t thread_terminate(thread_t thread);
+extern kern_return_t kernel_thread_start(thread_continue_t continuation, void *parameter, thread_t *new_thread);
+extern void thread_deallocate(thread_t thread);
+extern void pong_ramoops_diagnostic_write(const char *buf, int len);
+
+/* TLMM North Tile: GPIO 12 (SDA), GPIO 13 (SCL), GPIO 15 (INT)
+ * SM8250 TLMM North base: 0x0f900000 (Linux pinctrl-sm8250 North tile).
+ * CFG(12)=0x0f90c000, CFG(13)=0x0f90d000, CFG(15)=0x0f90f000.
+ * In Qualcomm QUPv3 SE5, Pad 0 is DATA (SDA, GPIO 12) and Pad 1 is CLK (SCL, GPIO 13).
+ */
+#define TLMM_NORTH_PHYS         0x0f900000UL
+#define TLMM_MAP_SIZE           0x00100000UL
+
+#define GPIO_CFG(tlmm, n)       ((tlmm) + 0x1000UL * (n))
+#define GPIO_IO(tlmm, n)        ((tlmm) + 0x1000UL * (n) + 4)
+
+#define PIN_SDA                 12
+#define PIN_SCL                 13
+#define PIN_INT                 15
+
+/* Qualcomm CMD-DB & RPMh RSC DRV 2 for SM8250 (SM-T970)
+ * CMD-DB: /reserved-memory/reserved-memory@80860000 (size 0x20000)
+ * Apps RSC: /soc/rsc@18200000, drv-2 base = 0x18220000 (size 0x10000)
+ * TCS offset: 0xd00, DRV 2 TCS 0/1 are active TCSs.
+ */
+#define CMD_DB_PHYS             0x80860000UL
+#define CMD_DB_SIZE             0x00020000UL
+
+#define RSC_PHYS                0x18220000UL
+#define RSC_SIZE                0x00010000UL
+#define RSC_TCS_BASE            0xd00
+#define RSC_TCS(n)              (RSC_TCS_BASE + 672 * (n))
+#define RSC_IRQ_STATUS          (RSC_TCS_BASE + 0x04)
+#define RSC_IRQ_CLEAR           (RSC_TCS_BASE + 0x08)
+#define TCS_CONTROL             0x14
+#define TCS_STATUS              0x18
+#define TCS_WAIT_FOR_DONE       0x10
+#define TCS_ENABLED             0x1c
+#define TCS_COMMAND(c)          (0x30 + 20 * (c))
+#define TCS_ACTIVE_MODE         (1u << 16)
+#define TCS_TRIGGER             (1u << 24)
+#define MSGID_WRITE_WAITED      (8u | (1u << 8) | (1u << 16))
+
+/* VRM register offsets and parameters */
+#define VRM_REG_VOLTAGE         0x0
+#define VRM_REG_ENABLE          0x4
+#define VRM_REG_MODE            0x8
+
+#define RPMH_REGULATOR_MODE_HPM 4
+
+/* SM-T970 DTB touchscreen@49 power supplies:
+ * stm,regulator_avdd = "pm8150_l13" -> resource "ldoa13", 3300 mV (3.3V)
+ * stm,regulator_dvdd = "pm8150_l14" -> resource "ldoa14", 1800 mV (1.8V)
+ * Voltages must not exceed DTB values.
+ */
+#define FTS_AVDD_MV             3300
+#define FTS_DVDD_MV             1800
+
+/* CMD-DB structures */
+struct cmd_db_slave {
+	uint16_t id, header_offset, data_offset, count, version, reserved[3];
+};
+struct cmd_db_header {
+	uint32_t version;
+	uint8_t magic[4];
+	struct cmd_db_slave slave[8];
+	uint32_t checksum, reserved;
+	uint8_t data[];
+};
+struct cmd_db_entry {
+	char id[8];
+	uint32_t priority[2];
+	uint32_t address;
+	uint16_t length, offset;
+};
+
+#define FTS_I2C_ADDR            0x49
+
+#define FTS_READ_DEVICE_ID      0x22
+#define FTS_ID0                 0x48
+#define FTS_ID0_1BA90A          0x39
+#define FTS_ID1                 0x36
+
+#define FTS_READ_ONE_EVENT      0x60
+#define FTS_CMD_CLEAR_ALL_EVENT 0x62
+#define FTS_CMD_SET_TOUCHTYPE   0x30
+#define FTS_TOUCHTYPE_DEFAULT   0x0061
+
+#define FTS_EVENT_SIZE          16
+#define FTS_FINGER_MAX          10
+
+#define FTS_EV_COORDINATE       0
+#define FTS_EV_STATUS           1
+#define FTS_STYPE_INFO          2
+#define FTS_INFO_READY          0x00
+
+#define FTS_ACT_PRESS           1
+#define FTS_ACT_MOVE            2
+#define FTS_ACT_RELEASE         3
+
+static vm_offset_t tlmm_vaddr = 0;
+static int pong_touch_fts = 0;
+static int pong_touch_rot = 3; /* bit 0: Swap XY (1), bit 1: Invert X (2), bit 2: Invert Y (4) */
+static int pong_touch_delay_sec = 20; /* Default 20s delay after boot before touch HW init */
+static uint32_t i2c_delay_us = 4; /* Default ~100 kHz (4 us half-cycle) */
+
+static inline uint32_t
+rd(vm_offset_t address)
+{
+	return *(volatile uint32_t *)address;
+}
+
+static inline void
+wr(vm_offset_t address, uint32_t value)
+{
+	*(volatile uint32_t *)address = value;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/*
+ * Spin, do not sleep. cpu_idle_latency is 0 on this board, so delay_for_interval() blocks on a
+ * timer even for 4 us (ml_delay_should_spin() is false). A 16-byte event read is about 520
+ * half-bit delays; as timer sleeps that took some 40 ms and touch was sampled at 20 Hz, which
+ * is the 50 ms frame pace measured while a finger moves. Spun, the read takes about 2 ms.
+ */
+extern uint64_t mach_absolute_time(void);
+
+static void
+sleep_us(uint32_t us)
+{
+	uint64_t interval, deadline;
+
+	nanoseconds_to_absolutetime((uint64_t)us * NSEC_PER_USEC, &interval);
+	deadline = mach_absolute_time() + interval;
+	while (mach_absolute_time() < deadline) {
+	}
+}
+
+static void
+sleep_ms(uint32_t ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	assert_wait_deadline((event_t)&tlmm_vaddr, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+pmsg_log(const char *fmt, ...)
+{
+	char buf[128];
+	va_list ap;
+	va_start(ap, fmt);
+	int n = vsnprintf(buf, sizeof(buf), fmt, ap);
+	va_end(ap);
+	if (n > 0) {
+		if (n >= (int)sizeof(buf)) {
+			n = (int)sizeof(buf) - 1;
+		}
+		pong_ramoops_diagnostic_write(buf, n);
+	}
+}
+
+/* Query resource command address from Qualcomm CMD-DB */
+static uint32_t
+cmd_db_query_resource(const char *name)
+{
+	vm_offset_t db_vaddr = ml_io_map(CMD_DB_PHYS, CMD_DB_SIZE);
+	if (!db_vaddr) {
+		pmsg_log("[PONG_FTS] cmd_db: map FAIL\n");
+		return 0;
+	}
+	const struct cmd_db_header *hdr = (const struct cmd_db_header *)db_vaddr;
+	if (hdr->magic[0] != 0xdb || hdr->magic[1] != 0x30 ||
+	    hdr->magic[2] != 0x03 || hdr->magic[3] != 0x0c) {
+		pmsg_log("[PONG_FTS] cmd_db: bad magic %02x%02x%02x%02x\n",
+		    hdr->magic[0], hdr->magic[1], hdr->magic[2], hdr->magic[3]);
+		return 0;
+	}
+
+	char target[8] = { 0 };
+	strlcpy(target, name, sizeof(target));
+
+	uint32_t res_addr = 0;
+	for (unsigned s = 0; s < 8; s++) {
+		const struct cmd_db_slave *slave = &hdr->slave[s];
+		if (slave->id == 0 || slave->count > 512) {
+			continue;
+		}
+		const struct cmd_db_entry *entry =
+		    (const struct cmd_db_entry *)(hdr->data + slave->header_offset);
+		for (unsigned i = 0; i < slave->count; i++) {
+			if (memcmp(entry[i].id, target, sizeof(target)) == 0) {
+				res_addr = entry[i].address;
+				break;
+			}
+		}
+		if (res_addr != 0) {
+			break;
+		}
+	}
+	return res_addr;
+}
+
+/* Power on touch rails (AVDD 3.3V, DVDD 1.8V) via RPMh VRM */
+static bool
+rpmh_power_on_touch(void)
+{
+	uint32_t ldo13_addr = cmd_db_query_resource("ldoa13");
+	uint32_t ldo14_addr = cmd_db_query_resource("ldoa14");
+
+	pmsg_log("[PONG_FTS] pwr: res l13=0x%x l14=0x%x\n", ldo13_addr, ldo14_addr);
+
+	if (!ldo13_addr || !ldo14_addr) {
+		pmsg_log("[PONG_FTS] pwr: res missing (SKIP)\n");
+		printf("Pong FTS touch: ldoa13/ldoa14 not found in cmd-db; SKIP power on\n");
+		return false;
+	}
+
+	vm_offset_t rsc_vaddr = ml_io_map(RSC_PHYS, RSC_SIZE);
+	if (!rsc_vaddr) {
+		pmsg_log("[PONG_FTS] pwr: map RSC FAIL\n");
+		return false;
+	}
+
+	/* Find an idle active TCS in DRV 2 (TCS 0 or 1) */
+	int tcs_idx = 0;
+	if (rd(rsc_vaddr + RSC_TCS(0) + TCS_STATUS) != 0 &&
+	    rd(rsc_vaddr + RSC_TCS(1) + TCS_STATUS) == 0) {
+		tcs_idx = 1;
+	}
+
+	vm_offset_t tcs_vaddr = rsc_vaddr + RSC_TCS(tcs_idx);
+
+	/* Prepare 6 VRM commands:
+	 * 0: ldoa13 voltage = 3300 mV
+	 * 1: ldoa13 mode    = HPM (4)
+	 * 2: ldoa13 enable  = 1
+	 * 3: ldoa14 voltage = 1800 mV
+	 * 4: ldoa14 mode    = HPM (4)
+	 * 5: ldoa14 enable  = 1
+	 */
+	uint32_t cmd_addrs[6] = {
+		ldo13_addr + VRM_REG_VOLTAGE,
+		ldo13_addr + VRM_REG_MODE,
+		ldo13_addr + VRM_REG_ENABLE,
+		ldo14_addr + VRM_REG_VOLTAGE,
+		ldo14_addr + VRM_REG_MODE,
+		ldo14_addr + VRM_REG_ENABLE,
+	};
+	uint32_t cmd_vals[6] = {
+		FTS_AVDD_MV,
+		RPMH_REGULATOR_MODE_HPM,
+		1,
+		FTS_DVDD_MV,
+		RPMH_REGULATOR_MODE_HPM,
+		1,
+	};
+
+	uint32_t all = (1u << 6) - 1; /* 0x3f */
+
+	wr(rsc_vaddr + RSC_IRQ_CLEAR, 1u << tcs_idx);
+	for (int i = 0; i < 6; i++) {
+		wr(tcs_vaddr + TCS_COMMAND(i), MSGID_WRITE_WAITED);
+		wr(tcs_vaddr + TCS_COMMAND(i) + 4, cmd_addrs[i]);
+		wr(tcs_vaddr + TCS_COMMAND(i) + 8, cmd_vals[i]);
+	}
+	wr(tcs_vaddr + TCS_WAIT_FOR_DONE, all);
+	wr(tcs_vaddr + TCS_ENABLED, all);
+	wr(tcs_vaddr + TCS_CONTROL, rd(tcs_vaddr + TCS_CONTROL) & ~TCS_TRIGGER);
+	wr(tcs_vaddr + TCS_CONTROL, rd(tcs_vaddr + TCS_CONTROL) | TCS_ACTIVE_MODE);
+	wr(tcs_vaddr + TCS_CONTROL, rd(tcs_vaddr + TCS_CONTROL) | TCS_TRIGGER);
+
+	/* Wait for completion with timeout (~50 ms) */
+	bool done = false;
+	uint32_t cmd_stat[6] = { 0 };
+	uint32_t irq_stat = 0;
+	for (int w = 0; w < 1000; w++) {
+		irq_stat = rd(rsc_vaddr + RSC_IRQ_STATUS);
+		uint32_t completed = 0;
+		for (int i = 0; i < 6; i++) {
+			cmd_stat[i] = rd(tcs_vaddr + TCS_COMMAND(i) + 12);
+			if ((cmd_stat[i] >> 16) & 1) {
+				completed++;
+			}
+		}
+		if ((irq_stat & (1u << tcs_idx)) || (completed == 6)) {
+			done = true;
+			break;
+		}
+		sleep_us(50);
+	}
+
+	wr(rsc_vaddr + RSC_IRQ_CLEAR, 1u << tcs_idx);
+	wr(tcs_vaddr + TCS_CONTROL, rd(tcs_vaddr + TCS_CONTROL) & ~(TCS_TRIGGER | TCS_ACTIVE_MODE));
+	wr(tcs_vaddr + TCS_ENABLED, 0);
+
+	if (done) {
+		pmsg_log("[PONG_FTS] pwr: vote ok tcs=%d irq=0x%x c0=0x%x c3=0x%x\n",
+		    tcs_idx, irq_stat, cmd_stat[0], cmd_stat[3]);
+		printf("Pong FTS touch: powered on ldoa13 (%u mV) & ldoa14 (%u mV) via RPMh\n",
+		    FTS_AVDD_MV, FTS_DVDD_MV);
+		/* Wait at least 350 ms for PMIC ramp-up and touch IC POR stabilization */
+		sleep_ms(350);
+		pmsg_log("[PONG_FTS] pwr: wait 350ms ok\n");
+	} else {
+		pmsg_log("[PONG_FTS] pwr: vote FAIL tcs=%d irq=0x%x c0=0x%x c3=0x%x\n",
+		    tcs_idx, irq_stat, cmd_stat[0], cmd_stat[3]);
+		printf("Pong FTS touch: RPMh power vote timed out\n");
+	}
+
+	return done;
+}
+
+/* GPIO accessors */
+static inline int
+scl_get(void)
+{
+	return rd(GPIO_IO(tlmm_vaddr, PIN_SCL)) & 1;
+}
+
+static inline int
+sda_get(void)
+{
+	return rd(GPIO_IO(tlmm_vaddr, PIN_SDA)) & 1;
+}
+
+static inline int
+int_get(void)
+{
+	return rd(GPIO_IO(tlmm_vaddr, PIN_INT)) & 1;
+}
+
+static inline void
+scl_set(int hi)
+{
+	if (hi) {
+		/* Input mode (float high via pull-up) */
+		wr(GPIO_CFG(tlmm_vaddr, PIN_SCL), rd(GPIO_CFG(tlmm_vaddr, PIN_SCL)) & ~(1u << 9));
+		/* Bounded clock stretching wait (max 40 us) to prevent preemption timeout */
+		for (int i = 0; i < 20; i++) {
+			if (scl_get()) {
+				break;
+			}
+			sleep_us(2);
+		}
+	} else {
+		/* Drive low */
+		wr(GPIO_IO(tlmm_vaddr, PIN_SCL), rd(GPIO_IO(tlmm_vaddr, PIN_SCL)) & ~2u);
+		wr(GPIO_CFG(tlmm_vaddr, PIN_SCL), rd(GPIO_CFG(tlmm_vaddr, PIN_SCL)) | (1u << 9));
+	}
+}
+
+static inline void
+sda_set(int hi)
+{
+	if (hi) {
+		/* Input mode (float high via pull-up) */
+		wr(GPIO_CFG(tlmm_vaddr, PIN_SDA), rd(GPIO_CFG(tlmm_vaddr, PIN_SDA)) & ~(1u << 9));
+	} else {
+		/* Drive low */
+		wr(GPIO_IO(tlmm_vaddr, PIN_SDA), rd(GPIO_IO(tlmm_vaddr, PIN_SDA)) & ~2u);
+		wr(GPIO_CFG(tlmm_vaddr, PIN_SDA), rd(GPIO_CFG(tlmm_vaddr, PIN_SDA)) | (1u << 9));
+	}
+}
+
+static inline void
+i2c_delay(void)
+{
+	sleep_us(i2c_delay_us);
+}
+
+static void
+i2c_start(void)
+{
+	sda_set(1);
+	scl_set(1);
+	i2c_delay();
+	sda_set(0);
+	i2c_delay();
+	scl_set(0);
+	i2c_delay();
+}
+
+static void
+i2c_stop(void)
+{
+	sda_set(0);
+	i2c_delay();
+	scl_set(1);
+	i2c_delay();
+	sda_set(1);
+	i2c_delay();
+}
+
+static int
+i2c_write_byte(uint8_t byte)
+{
+	for (int i = 7; i >= 0; i--) {
+		sda_set((byte >> i) & 1);
+		i2c_delay();
+		scl_set(1);
+		i2c_delay();
+		scl_set(0);
+		i2c_delay();
+	}
+	/* Read ACK from slave */
+	sda_set(1);
+	i2c_delay();
+	scl_set(1);
+	i2c_delay();
+	int ack = sda_get() == 0 ? 0 : -1;
+	scl_set(0);
+	i2c_delay();
+	return ack;
+}
+
+static uint8_t
+i2c_read_byte(int send_ack)
+{
+	uint8_t byte = 0;
+	sda_set(1);
+	for (int i = 7; i >= 0; i--) {
+		i2c_delay();
+		scl_set(1);
+		i2c_delay();
+		if (sda_get()) {
+			byte |= (1u << i);
+		}
+		scl_set(0);
+		i2c_delay();
+	}
+	/* Send ACK (0) or NAK (1) */
+	sda_set(send_ack ? 0 : 1);
+	i2c_delay();
+	scl_set(1);
+	i2c_delay();
+	scl_set(0);
+	i2c_delay();
+	sda_set(1);
+	return byte;
+}
+
+/* 0x03..0x77 address scan. Sends only address byte (write), no data. */
+static int
+fts_i2c_scan(uint8_t *first_hit)
+{
+	int hits = 0;
+	if (first_hit) {
+		*first_hit = 0;
+	}
+	pmsg_log("[PONG_FTS] scan: 0x03-0x77 start\n");
+	for (uint8_t addr = 0x03; addr <= 0x77; addr++) {
+		if (!scl_get() || !sda_get()) {
+			pmsg_log("[PONG_FTS] scan: bus low at 0x%02x (SCL=%d SDA=%d)\n",
+			    addr, scl_get(), sda_get());
+			break;
+		}
+		i2c_start();
+		int ack = i2c_write_byte((addr << 1) | 0);
+		i2c_stop();
+		if (ack == 0) {
+			hits++;
+			pmsg_log("[PONG_FTS] scan: hit 0x%02x\n", addr);
+			printf("Pong FTS touch: found I2C slave 0x%02x\n", addr);
+			if (first_hit && *first_hit == 0) {
+				*first_hit = addr;
+			}
+		}
+		sleep_us(20);
+	}
+	pmsg_log("[PONG_FTS] scan: done hits=%d\n", hits);
+	return hits;
+}
+
+static int
+fts_write_to(uint8_t addr, const uint8_t *buf, int len)
+{
+	if (!scl_get() || !sda_get()) {
+		pmsg_log("[PONG_FTS] write: bus low (SCL=%d SDA=%d)\n", scl_get(), sda_get());
+		return -1;
+	}
+
+	i2c_start();
+	if (i2c_write_byte((addr << 1) | 0) != 0) {
+		i2c_stop();
+		return -2;
+	}
+	for (int i = 0; i < len; i++) {
+		if (i2c_write_byte(buf[i]) != 0) {
+			i2c_stop();
+			return -3;
+		}
+	}
+	i2c_stop();
+	return 0;
+}
+
+static inline int
+fts_write(const uint8_t *buf, int len)
+{
+	return fts_write_to(FTS_I2C_ADDR, buf, len);
+}
+
+/*
+ * fts_read_from: reads len bytes from reg at slave addr.
+ * err_step output:
+ *   1: NACK on write address (addr | 0)
+ *   2: NACK on register address
+ *   3: NACK on read address (addr | 1)
+ */
+static int
+fts_read_from(uint8_t addr, uint8_t reg, uint8_t *buf, int len, int *err_step)
+{
+	if (err_step) {
+		*err_step = 0;
+	}
+	if (!scl_get() || !sda_get()) {
+		if (err_step) *err_step = -1;
+		pmsg_log("[PONG_FTS] read: bus low (SCL=%d SDA=%d)\n", scl_get(), sda_get());
+		return -1;
+	}
+
+	i2c_start();
+	int ack_addr_w = i2c_write_byte((addr << 1) | 0);
+	if (ack_addr_w != 0) {
+		i2c_stop();
+		if (err_step) *err_step = 1;
+		return -1;
+	}
+
+	int ack_reg = i2c_write_byte(reg);
+	if (ack_reg != 0) {
+		i2c_stop();
+		if (err_step) *err_step = 2;
+		return -1;
+	}
+
+	i2c_start(); /* Repeated start */
+	int ack_addr_r = i2c_write_byte((addr << 1) | 1);
+	if (ack_addr_r != 0) {
+		i2c_stop();
+		if (err_step) *err_step = 3;
+		return -1;
+	}
+
+	for (int i = 0; i < len; i++) {
+		buf[i] = i2c_read_byte(i < len - 1);
+	}
+	i2c_stop();
+	return 0;
+}
+
+static inline int
+fts_read(uint8_t reg, uint8_t *buf, int len)
+{
+	int step = 0;
+	return fts_read_from(FTS_I2C_ADDR, reg, buf, len, &step);
+}
+
+static void
+gpio_init_pins(void)
+{
+	uint32_t scl_cfg_raw = rd(GPIO_CFG(tlmm_vaddr, PIN_SCL));
+	uint32_t sda_cfg_raw = rd(GPIO_CFG(tlmm_vaddr, PIN_SDA));
+	uint32_t int_cfg_raw = rd(GPIO_CFG(tlmm_vaddr, PIN_INT));
+	int scl_in_raw = scl_get();
+	int sda_in_raw = sda_get();
+	int int_in_raw = int_get();
+
+	pmsg_log("[PONG_FTS] pins raw: SCL(cfg=0x%x in=%d) SDA(cfg=0x%x in=%d) INT(cfg=0x%x in=%d)\n",
+	    scl_cfg_raw, scl_in_raw, sda_cfg_raw, sda_in_raw, int_cfg_raw, int_in_raw);
+
+	/* 1. Diagnose external pull levels with SoC internal pull-ups DISABLED (bias-disable / pull=0) */
+	wr(GPIO_CFG(tlmm_vaddr, PIN_SCL), (rd(GPIO_CFG(tlmm_vaddr, PIN_SCL)) & ~0x3ffu));
+	wr(GPIO_CFG(tlmm_vaddr, PIN_SDA), (rd(GPIO_CFG(tlmm_vaddr, PIN_SDA)) & ~0x3ffu));
+	wr(GPIO_CFG(tlmm_vaddr, PIN_INT), (rd(GPIO_CFG(tlmm_vaddr, PIN_INT)) & ~0x3ffu));
+	sleep_us(10);
+
+	int scl_in_nopull = scl_get();
+	int sda_in_nopull = sda_get();
+	int int_in_nopull = int_get();
+
+	pmsg_log("[PONG_FTS] pins nopull: SCL(in=%d) SDA(in=%d) INT(in=%d)\n",
+	    scl_in_nopull, sda_in_nopull, int_in_nopull);
+
+	/* 2. Configure SCL (GPIO 13), SDA (GPIO 12), INT (GPIO 15): func=0 (GPIO), pull=3 (pull-up), input (0) */
+	wr(GPIO_CFG(tlmm_vaddr, PIN_SCL), (rd(GPIO_CFG(tlmm_vaddr, PIN_SCL)) & ~0x3ffu) | 3u);
+	wr(GPIO_CFG(tlmm_vaddr, PIN_SDA), (rd(GPIO_CFG(tlmm_vaddr, PIN_SDA)) & ~0x3ffu) | 3u);
+	wr(GPIO_CFG(tlmm_vaddr, PIN_INT), (rd(GPIO_CFG(tlmm_vaddr, PIN_INT)) & ~0x3ffu) | 3u);
+
+	scl_set(1);
+	sda_set(1);
+
+	/* Bus clear: pulse SCL 9 times with SDA released high in case slave was interrupted */
+	for (int p = 0; p < 9; p++) {
+		scl_set(0);
+		sleep_us(5);
+		scl_set(1);
+		sleep_us(5);
+	}
+	i2c_stop();
+
+	int scl_in_ready = scl_get();
+	int sda_in_ready = sda_get();
+	int int_in_ready = int_get();
+
+	pmsg_log("[PONG_FTS] pins ready: SCL(in=%d) SDA(in=%d) INT(in=%d)\n",
+	    scl_in_ready, sda_in_ready, int_in_ready);
+
+	if (!scl_in_ready || !sda_in_ready) {
+		pmsg_log("[PONG_FTS] WARNING: I2C line stuck low: SCL=%d SDA=%d\n",
+		    scl_in_ready, sda_in_ready);
+		printf("Pong FTS touch: WARNING: I2C bus stuck low (SCL=%d, SDA=%d)\n",
+		    scl_in_ready, sda_in_ready);
+	}
+}
+
+static bool
+fts_hw_init(void)
+{
+	uint8_t id[5] = { 0 };
+	bool probed = false;
+	uint8_t hit_addr = 0;
+	uint8_t active_addr = FTS_I2C_ADDR;
+
+	/* 1. Scan bus 0x03..0x77 */
+	fts_i2c_scan(&hit_addr);
+
+	/* 2. Try probe at ~100 kHz (i2c_delay_us = 4) */
+	i2c_delay_us = 4;
+	pmsg_log("[PONG_FTS] probe: try 100k addr=0x%02x\n", FTS_I2C_ADDR);
+	for (int retry = 0; retry < 5; retry++) {
+		int step = 0;
+		if (fts_read_from(FTS_I2C_ADDR, FTS_READ_DEVICE_ID, id, sizeof(id), &step) == 0) {
+			pmsg_log("[PONG_FTS] probe: 100k got %02x %02x %02x %02x %02x\n",
+			    id[0], id[1], id[2], id[3], id[4]);
+			if ((id[2] == FTS_ID0 || id[2] == FTS_ID0_1BA90A) && id[3] == FTS_ID1) {
+				probed = true;
+				active_addr = FTS_I2C_ADDR;
+				break;
+			}
+		} else {
+			pmsg_log("[PONG_FTS] probe: 100k try %d nack step=%d (SCL=%d SDA=%d INT=%d)\n",
+			    retry, step, scl_get(), sda_get(), int_get());
+		}
+		sleep_ms(20);
+	}
+
+	/* 3. If failed, lower speed to ~10 kHz (i2c_delay_us = 45) and retry */
+	if (!probed) {
+		i2c_delay_us = 45;
+		pmsg_log("[PONG_FTS] probe: try 10k addr=0x%02x\n", FTS_I2C_ADDR);
+		for (int retry = 0; retry < 5; retry++) {
+			int step = 0;
+			if (fts_read_from(FTS_I2C_ADDR, FTS_READ_DEVICE_ID, id, sizeof(id), &step) == 0) {
+				pmsg_log("[PONG_FTS] probe: 10k got %02x %02x %02x %02x %02x\n",
+				    id[0], id[1], id[2], id[3], id[4]);
+				if ((id[2] == FTS_ID0 || id[2] == FTS_ID0_1BA90A) && id[3] == FTS_ID1) {
+					probed = true;
+					active_addr = FTS_I2C_ADDR;
+					break;
+				}
+			} else {
+				pmsg_log("[PONG_FTS] probe: 10k try %d nack step=%d (SCL=%d SDA=%d INT=%d)\n",
+				    retry, step, scl_get(), sda_get(), int_get());
+			}
+			sleep_ms(20);
+		}
+	}
+
+	/* 4. If probe failed on 0x49 but scan found another slave, try that address once */
+	if (!probed && hit_addr != 0 && hit_addr != FTS_I2C_ADDR) {
+		pmsg_log("[PONG_FTS] probe: try alt addr=0x%02x\n", hit_addr);
+		int step = 0;
+		if (fts_read_from(hit_addr, FTS_READ_DEVICE_ID, id, sizeof(id), &step) == 0) {
+			pmsg_log("[PONG_FTS] probe: alt got %02x %02x %02x %02x %02x\n",
+			    id[0], id[1], id[2], id[3], id[4]);
+			if ((id[2] == FTS_ID0 || id[2] == FTS_ID0_1BA90A) && id[3] == FTS_ID1) {
+				probed = true;
+				active_addr = hit_addr;
+			}
+		} else {
+			pmsg_log("[PONG_FTS] probe: alt nack step=%d\n", step);
+		}
+	}
+
+	if (!probed) {
+		pmsg_log("[PONG_FTS] probe: FAIL chip=%02x%02x (SCL=%d SDA=%d INT=%d) (SKIP)\n",
+		    id[2], id[3], scl_get(), sda_get(), int_get());
+		printf("Pong FTS touch: unexpected or missing chip id: %02x %02x %02x %02x %02x; SKIP\n",
+		    id[0], id[1], id[2], id[3], id[4]);
+		return false;
+	}
+
+	pmsg_log("[PONG_FTS] probe: MATCH id=0x%02x%02x rev=0x%02x addr=0x%02x spd=%uk\n",
+	    id[2], id[3], id[4], active_addr, i2c_delay_us == 45 ? 10 : 100);
+	printf("Pong FTS touch: found STM FTS chip 0x%02x%02x rev 0x%02x (addr 0x%02x)\n",
+	    id[2], id[3], id[4], active_addr);
+
+	/* System reset */
+	static const uint8_t rst_cmd[] = { 0xfa, 0x20, 0x00, 0x00, 0x24, 0x81 };
+	fts_write_to(active_addr, rst_cmd, sizeof(rst_cmd));
+	sleep_ms(10);
+
+	/* Wait for ready event */
+	for (int retry = 0; retry < 50; retry++) {
+		uint8_t ev[FTS_EVENT_SIZE];
+		if (fts_read_from(active_addr, FTS_READ_ONE_EVENT, ev, sizeof(ev), NULL) == 0) {
+			if ((ev[0] & 0x03) == FTS_EV_STATUS &&
+			    ((ev[0] >> 2) & 0x0f) == FTS_STYPE_INFO &&
+			    ev[1] == FTS_INFO_READY) {
+				break;
+			}
+		}
+		sleep_ms(20);
+	}
+
+	/* Clear events */
+	static const uint8_t clr_cmd = FTS_CMD_CLEAR_ALL_EVENT;
+	fts_write_to(active_addr, &clr_cmd, 1);
+
+	/* Touch type: TOUCH | PALM | WET */
+	static const uint8_t tt_cmd[] = { FTS_CMD_SET_TOUCHTYPE,
+		(uint8_t)(FTS_TOUCHTYPE_DEFAULT & 0xff),
+		(uint8_t)(FTS_TOUCHTYPE_DEFAULT >> 8) };
+	fts_write_to(active_addr, tt_cmd, sizeof(tt_cmd));
+
+	/* Interrupt on */
+	static const uint8_t int_on[] = { 0xa4, 0x01, 0x01 };
+	fts_write_to(active_addr, int_on, sizeof(int_on));
+	sleep_ms(10);
+
+	/* Scan on */
+	static const uint8_t scan_on[] = { 0xa0, 0x00, 0x01 };
+	fts_write_to(active_addr, scan_on, sizeof(scan_on));
+	sleep_ms(50);
+
+	pmsg_log("[PONG_FTS] init ok (rot=%d)\n", pong_touch_rot);
+	printf("Pong FTS touch: hardware initialized, rot=%d\n", pong_touch_rot);
+	return true;
+}
+
+static void
+fts_touch_thread(__unused void *param, __unused wait_result_t wr)
+{
+	if (pong_touch_delay_sec > 0) {
+		pmsg_log("[PONG_FTS] delay init %ds\n", pong_touch_delay_sec);
+		printf("Pong FTS touch: delaying init by %d sec\n", pong_touch_delay_sec);
+		for (int s = 0; s < pong_touch_delay_sec; s++) {
+			sleep_ms(1000);
+		}
+	}
+
+	/* Turn on touch power rails via RPMh VRM */
+	rpmh_power_on_touch();
+
+	pmsg_log("[PONG_FTS] map TLMM 0x%08lx\n", (unsigned long)TLMM_NORTH_PHYS);
+	tlmm_vaddr = ml_io_map(TLMM_NORTH_PHYS, TLMM_MAP_SIZE);
+	if (!tlmm_vaddr) {
+		pmsg_log("[PONG_FTS] map TLMM FAIL (SKIP)\n");
+		printf("Pong FTS touch: ml_io_map failed; SKIP\n");
+		thread_terminate(current_thread());
+		return;
+	}
+
+	gpio_init_pins();
+
+	if (!fts_hw_init()) {
+		thread_terminate(current_thread());
+		return;
+	}
+
+	if (!pong_touch_device_ready()) {
+		pmsg_log("[PONG_FTS] pong_touch_device_ready FAIL (SKIP)\n");
+		printf("Pong FTS touch: cannot ready /dev/pong-touch; SKIP\n");
+		thread_terminate(current_thread());
+		return;
+	}
+
+	uint32_t logged_touches = 0;
+	unsigned idle_count = 0;
+
+	for (;;) {
+		bool int_asserted = (rd(GPIO_IO(tlmm_vaddr, PIN_INT)) & 1) == 0;
+		if (int_asserted || ++idle_count >= 10) {
+			idle_count = 0;
+			for (int drain = 0; drain < 16; drain++) {
+				uint8_t ev[FTS_EVENT_SIZE];
+				if (fts_read(FTS_READ_ONE_EVENT, ev, sizeof(ev)) != 0) {
+					break;
+				}
+				uint8_t id = ev[0] & 0x03;
+				uint8_t tid = (ev[0] >> 2) & 0x0f;
+				uint8_t action = ev[0] >> 6;
+
+				if (id == FTS_EV_COORDINATE && tid < FTS_FINGER_MAX) {
+					uint32_t raw_x = (uint32_t)((ev[1] << 4) | (ev[3] >> 4));
+					uint32_t raw_y = (uint32_t)((ev[2] << 4) | (ev[3] & 0x0f));
+
+					uint32_t sx = raw_x;
+					uint32_t sy = raw_y;
+					uint32_t max_x = 1752;
+					uint32_t max_y = 2800;
+
+					if (pong_touch_rot & 1) {
+						uint32_t tmp = sx; sx = sy; sy = tmp;
+						tmp = max_x; max_x = max_y; max_y = tmp;
+					}
+					if (pong_touch_rot & 2) {
+						sx = (max_x > 1 && sx < max_x) ? (max_x - 1 - sx) : 0;
+					}
+					if (pong_touch_rot & 4) {
+						sy = (max_y > 1 && sy < max_y) ? (max_y - 1 - sy) : 0;
+					}
+
+					uint32_t post_x = max_x > 1 ? (uint32_t)((uint64_t)sx * 65535 / (max_x - 1)) : sx;
+					uint32_t post_y = max_y > 1 ? (uint32_t)((uint64_t)sy * 65535 / (max_y - 1)) : sy;
+					if (post_x > 65535) post_x = 65535;
+					if (post_y > 65535) post_y = 65535;
+
+					pong_touch_post(action, tid, post_x, post_y);
+
+					if (logged_touches < 4) {
+						logged_touches++;
+						pmsg_log("[PONG_FTS] touch#%u: act=%u tid=%u raw=(%u,%u) post=(%u,%u)\n",
+						    logged_touches, action, tid, raw_x, raw_y, post_x, post_y);
+					}
+				}
+
+				uint8_t left = ev[7] & 0x1f;
+				if (left == 0) {
+					break;
+				}
+			}
+		}
+		sleep_ms(8);
+	}
+}
+
+void
+pong_fts_init(void)
+{
+	int en = 0;
+	if (PE_parse_boot_argn("pong_touch_fts", &en, sizeof(en)) && en > 0) {
+		pong_touch_fts = en;
+	}
+	if (!pong_touch_fts) {
+		return;
+	}
+	int rot = 0;
+	if (PE_parse_boot_argn("pong_touch_rot", &rot, sizeof(rot))) {
+		pong_touch_rot = rot;
+	}
+	int delay = 0;
+	if (PE_parse_boot_argn("pong_touch_delay", &delay, sizeof(delay))) {
+		pong_touch_delay_sec = delay;
+	}
+	thread_t th = THREAD_NULL;
+	if (kernel_thread_start(fts_touch_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	}
+}
+#endif /* PONG */
