+/*
+ * tick: the fallback's settings and, per core, idle-timer wake-ups since the previous `tick`.
+ * idletick N: idle cores wake after N microseconds (0 off, at most 1000000). Works only when the boot argument
+ * armcpu-idle-tick-us registered the idle callbacks (registered=1).
+ * timeripi N: 1 = every timer interrupt also runs the IPI callback.
+ */
+static void
+cmd_handle_tick(const char *args, int which)
+{
+	static uint64_t last[8];
+	const char *p = args;
+	char reply[320];
+	int n;
+
+	if (which == 1) {
+		uint32_t us = parse_num(&p);
+
+		armcpu_idle_tick_us = us <= 1000000 ? us : 0;
+	} else if (which == 2) {
+		armcpu_timer_ipi = parse_num(&p) == 1 ? 1 : 0;
+	}
+	n = snprintf(reply, sizeof(reply), "tick: registered=%u idle_us=%u timer_ipi=%u wakes:",
+	    armcpu_idle_registered, armcpu_idle_tick_us, armcpu_timer_ipi);
+	for (unsigned c = 0; c < 8; c++) {
+		uint64_t value = armcpu_idle_wakes[c];
+
+		if (n > 0 && n < (int)sizeof(reply) - 28) {
+			n += snprintf(reply + n, sizeof(reply) - (size_t)n, " c%u=%llu", c, value - last[c]);
+		}
+		last[c] = value;
+	}
+	if (n > 0 && n < (int)sizeof(reply) - 2) {
+		reply[n] = '\n';
+		reply[n + 1] = '\0';
+	}
+	send_str(reply);
+}
+
+/*
+ * ipitrace: per core, when it last took an IPI (ms of uptime, 0 = never) and how many of its IPIs were SGIs; then
+ * the distributor words read back when the core's IPI SPI was set up: enable / trigger / route / pending.
+ */
+static void
+cmd_handle_ipitrace(void)
+{
+	char reply[700];
+	int n = snprintf(reply, sizeof(reply), "ipitrace: now=%llu last/sgi:", armcpu_now_ms());
+
+	for (unsigned c = 0; c < 8; c++) {
+		if (n > 0 && n < (int)sizeof(reply) - 48) {
+			n += snprintf(reply + n, sizeof(reply) - (size_t)n, " c%u=%llu/%llu", c, armcpu_ipi_last_ms[c],
+			    armcpu_sgi_recv[c]);
+		}
+	}
+	if (n > 0 && n < (int)sizeof(reply) - 32) {
+		n += snprintf(reply + n, sizeof(reply) - (size_t)n, " setup en/cfg/rt/pend:");
+	}
+	for (unsigned c = 0; c < 8; c++) {
+		if (n > 0 && n < (int)sizeof(reply) - 44) {
+			n += snprintf(reply + n, sizeof(reply) - (size_t)n, " %x/%x/%x/%x", armcpu_ipi_cfg[c][0],
+			    armcpu_ipi_cfg[c][1], armcpu_ipi_cfg[c][2], armcpu_ipi_cfg[c][3]);
+		}
+	}
+	if (n > 0 && n < (int)sizeof(reply) - 2) {
+		reply[n] = '\n';
+		reply[n + 1] = '\0';
+	}
+	send_str(reply);
+}
