+/*
+ * wifiup: power PCIe0 up, train the link to the Wi-Fi chip and read its ID (about 0.4 s, at most about 1.7 s).
+ * wifidown: put the chip back in reset. The reply is pong_wifi_link.c's result line.
+ */
+static void
+cmd_handle_wifi(bool up)
+{
+	char reply[400];
+
+	reply[0] = '\0';
+	if (up) {
+		(void)pong_wifi_link_up(reply, sizeof(reply));
+	} else {
+		(void)pong_wifi_link_down(reply, sizeof(reply));
+	}
+	send_str(reply[0] ? reply : "wifi: no reply\n");
+}
