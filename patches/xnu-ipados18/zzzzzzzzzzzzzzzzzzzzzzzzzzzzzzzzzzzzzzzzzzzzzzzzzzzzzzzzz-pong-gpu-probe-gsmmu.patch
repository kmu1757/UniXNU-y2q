  * A650Gmu.c:194-223). The CM3 reset is NOT released; icache/dummy blocks are only summarized.
  * `gpuprobe rsc` (mode 9) then sets up and wakes the GMU's RSC (A650Gmu.c Phase 2 and 3); the CM3
  * reset is still not released. Modes 8 and up answer with a short line.
+ * `gpuprobe gsmmu` (mode 10) adds the test whether the GPU SMMU takes a write (one unused SMR, restored).
  *
  * Ported from UniXNU-gts7xlwifi (https://github.com/rui12366B/UniXNU-gts7xlwifi, c2aa790):
  *   package/GpuPowerBoard.h and package/GpuProbe.cpp (modes 1, 3, 5, and 6).
@@ -923,6 +924,46 @@ pong_gpu_probe_usb(char *reply, size_t reply_cap, int mode)
 		}
 	}
 
+	/*
+	 * Mode 10 (`gpuprobe gsmmu`): does this SMMU take a write from here? The precedent had to settle that before
+	 * its GMU context (GpuProbe.cpp:314-325): the highest stream match register gets a valid-looking value, is
+	 * read back, and gets its old value back. The slot must be unused (valid bit clear); its S2CR is not
+	 * touched, so a stream matching the value for those few microseconds would only fault as before.
+	 * Also lists the six SMR / S2CR pairs: the GMU context will want slots 2 and 3 (streams 5 and 0x405) and
+	 * the GPU's slots 0, 1, 4 and 5 (GpuProbe.cpp:249, 637-640).
+	 */
+	char gsmmu_extra[240];
+	gsmmu_extra[0] = '\0';
+	if (mode >= 10) {
+		uint32_t smr[6], s2cr[6];
+
+		for (unsigned int i = 0; i < 6; i++) {
+			smr[i] = gpu_probe_rd32(g_smmu_gr0_page, SMMU_GR0_SMR_BASE_OFF + i * 4u);
+			s2cr[i] = gpu_probe_rd32(g_smmu_gr0_page, SMMU_GR0_S2CR_BASE_OFF + i * 4u);
+		}
+		if (smr_count < 1u || smr_count > 6u) {
+			snprintf(gsmmu_extra, sizeof(gsmmu_extra), " gsmmu[stop=slots n=%u]", smr_count);
+		} else if (smr[smr_count - 1u] & 0x80000000u) {
+			snprintf(gsmmu_extra, sizeof(gsmmu_extra), " gsmmu[stop=last_slot_in_use n=%u smr=%#x]", smr_count,
+			    smr[smr_count - 1u]);
+		} else {
+			const unsigned int off = SMMU_GR0_SMR_BASE_OFF + (smr_count - 1u) * 4u;
+			const uint32_t was = smr[smr_count - 1u];
+			uint32_t got, back;
+
+			gpu_probe_wr32(g_smmu_gr0_page, off, 0x8000007fu, 60);
+			got = gpu_probe_rd32(g_smmu_gr0_page, off);
+			gpu_probe_wr32(g_smmu_gr0_page, off, was, 61);
+			back = gpu_probe_rd32(g_smmu_gr0_page, off);
+			snprintf(gsmmu_extra, sizeof(gsmmu_extra),
+			    " gsmmu[n=%u smr=%x/%x/%x/%x/%x/%x s2cr=%x/%x/%x/%x/%x/%x wr=%#x>%#x>%#x %s gfsr=%#x]",
+			    smr_count, smr[0], smr[1], smr[2], smr[3], smr[4], smr[5],
+			    s2cr[0], s2cr[1], s2cr[2], s2cr[3], s2cr[4], s2cr[5], was, got, back,
+			    got == 0x8000007fu ? "writable" : got == was ? "refused" : "partial",
+			    gpu_probe_rd32(g_smmu_gr0_page, SMMU_GR0_SGFSR_OFF));
+		}
+	}
+
 	bool gmu_read = false;
 	bool gmupre_read = false;
 	uint32_t gmu_rst = 0, gmu_fw = 0, gmu_gx = 0, gmu_hfi = 0, gmu_irq = 0, gmu_fence = 0;
@@ -1164,6 +1205,10 @@ pong_gpu_probe_usb(char *reply, size_t reply_cap, int mode)
 		extra_len += (size_t)snprintf(gmuclk_extra + extra_len, sizeof(gmuclk_extra) - extra_len,
 		    "%s", rsc_extra);
 	}
+	if (mode >= 10 && gsmmu_extra[0] != '\0' && extra_len < sizeof(gmuclk_extra)) {
+		extra_len += (size_t)snprintf(gmuclk_extra + extra_len, sizeof(gmuclk_extra) - extra_len,
+		    "%s", gsmmu_extra);
+	}
 
