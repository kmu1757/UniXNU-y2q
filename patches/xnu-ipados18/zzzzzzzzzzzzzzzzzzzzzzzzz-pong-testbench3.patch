 		cmd_handle_prefer(cmd + 7);
 	} else if (strcmp(cmd, "top") == 0) {
 		cmd_handle_top();
+	} else if (strcmp(cmd, "ipis") == 0) {
+		cmd_handle_ipis();
 	} else if (strncmp(cmd, "tgprefer ", 9) == 0) {
 		cmd_handle_tgprefer(cmd + 9);
 	} else {
-		send_str("ERROR: unknown command. Available: ping, status, log, reboot, reboot-recovery, screenshot, tap, swipe, threads, cpus, prefer, top, tgprefer\n");
+		send_str("ERROR: unknown command. Available: ping, status, log, reboot, reboot-recovery, screenshot, tap, swipe, threads, cpus, prefer, top, tgprefer, ipis\n");
 	}
 }
 
