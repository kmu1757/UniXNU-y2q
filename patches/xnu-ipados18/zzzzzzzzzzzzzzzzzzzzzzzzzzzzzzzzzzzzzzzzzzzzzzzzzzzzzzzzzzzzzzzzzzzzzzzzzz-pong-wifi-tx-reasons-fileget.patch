+/* ---- fileget: a file from the Photos folder (a screenshot taken on the tablet), in base64 pieces ---- */
+#define FG_PREFIX "/private/var/mobile/Media/DCIM/"
+#define FG_PIECE  1024u
+
+/* `fileget <path> <offset>` -> "fileget: <size> <offset> <n> <base64 of n bytes>"; read-only, nothing outside FG_PREFIX */
+int
+pong_wifi_tools_fileget(char *reply, size_t cap, const char *args)
+{
+	static const char b64[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+	static uint8_t piece[FG_PIECE];
+	char path[160];
+	size_t pl = 0;
+	uint64_t offset = 0;
+	vfs_context_t ctx;
+	vnode_t vp = NULLVP;
+	struct vnode_attr va;
+	int e, n = 0, resid = 0;
+	size_t o;
+	uint64_t size = 0;
+
+	while (args && *args == ' ') {
+		args++;
+	}
+	while (args && *args && *args != ' ' && pl + 1 < sizeof(path)) {
+		path[pl++] = *args++;
+	}
+	path[pl] = '\0';
+	while (args && *args == ' ') {
+		args++;
+	}
+	while (args && *args >= '0' && *args <= '9' && offset < (1ull << 40)) {
+		offset = offset * 10u + (uint64_t)(*args++ - '0');
+	}
+	if (cap < 4 * FG_PIECE / 3 + 96 || pl <= sizeof(FG_PREFIX) - 1 || strncmp(path, FG_PREFIX, sizeof(FG_PREFIX) - 1) != 0) {
+		strlcpy(reply, "fileget: only files under " FG_PREFIX "\n", cap);
+		return -1;
+	}
+	for (size_t i = 0; i + 1 < pl; i++) {
+		if (path[i] == '.' && path[i + 1] == '.') {
+			strlcpy(reply, "fileget: no .. in the path\n", cap);
+			return -1;
+		}
+	}
+	ctx = vfs_context_create(NULL);
+	e = vnode_open(path, FREAD | O_NOFOLLOW, 0, VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+	if (e == 0) {
+		VATTR_INIT(&va);
+		VATTR_WANTED(&va, va_data_size);
+		e = vnode_getattr(vp, &va, ctx);
+		if (e == 0 && VATTR_IS_SUPPORTED(&va, va_data_size)) {
+			size = va.va_data_size;
+		}
+		if (e == 0 && offset < size) {
+			n = (int)(size - offset < FG_PIECE ? size - offset : FG_PIECE);
+			e = vn_rdwr(UIO_READ, vp, (caddr_t)piece, n, (off_t)offset, UIO_SYSSPACE, IO_NODELOCKED | IO_UNIT,
+			    vfs_context_ucred(ctx), &resid, current_proc());
+			n -= resid;
+		}
+		(void)vnode_close(vp, FREAD, ctx);
+	}
+	vfs_context_rele(ctx);
+	if (e != 0) {
+		(void)snprintf(reply, cap, "fileget: error %d\n", e);
+		return -1;
+	}
+	o = (size_t)snprintf(reply, cap, "fileget: %llu %llu %d ", (unsigned long long)size, (unsigned long long)offset, n);
+	for (int i = 0; i < n && o + 5 < cap; i += 3) {
+		uint32_t v = (uint32_t)piece[i] << 16 | (i + 1 < n ? (uint32_t)piece[i + 1] << 8 : 0) | (i + 2 < n ? piece[i + 2] : 0);
+
+		reply[o++] = b64[v >> 18 & 63];
+		reply[o++] = b64[v >> 12 & 63];
+		reply[o++] = i + 1 < n ? b64[v >> 6 & 63] : '=';
+		reply[o++] = i + 2 < n ? b64[v & 63] : '=';
+	}
+	if (o + 2 > cap) {
+		o = cap - 2;
+	}
+	reply[o++] = '\n';
+	reply[o] = '\0';
+	return 0;
+}
