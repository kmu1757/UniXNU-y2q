+/*
+ * Read-only lookup of a resource by its 8-byte ASCII name in the AOP Command DB (0x80860000).
+ * Reads strictly through 32-bit volatile `gpu_probe_rd32` accesses (no memcpy/memcmp on Device memory,
+ * following `GpuPowerBoard.h:346-380` and `pong_wifi_link.c:321-358`).
+ * Returns 0 on match, 1 if not found, -1 if header/offsets are invalid.
+ */
+static int
+gpu_cmddb_find(vm_offset_t db_va, const char *name, uint32_t *out_addr, uint32_t *out_len)
+{
+	uint32_t key[2] = { 0, 0 };
+
+	*out_addr = 0;
+	*out_len = 0;
+	if (!db_va) {
+		return -1;
+	}
+	for (unsigned int i = 0; i < 8 && name[i] != '\0'; i++) {
+		key[i / 4] |= (uint32_t)(uint8_t)name[i] << (8 * (i % 4));
+	}
+	if (gpu_probe_rd32(db_va, 4) != GPB_CMD_DB_MAGIC) {
+		return -1;
+	}
+	for (unsigned int s = 0; s < 8; s++) {
+		const uint32_t h0 = gpu_probe_rd32(db_va, 8u + s * 16u);
+		const uint32_t h1 = gpu_probe_rd32(db_va, 8u + s * 16u + 4u);
+		const uint32_t slave = h0 & 0xffffu;
+		const uint32_t heads = h0 >> 16;
+		const uint32_t data  = h1 & 0xffffu;
+		const uint32_t count = h1 >> 16;
+
+		if (!slave) {
+			break;
+		}
+		if ((heads & 3u) != 0 || heads > GPB_CMD_DB_SIZE - GPB_CMD_DB_DATA_OFF ||
+		    count > (GPB_CMD_DB_SIZE - GPB_CMD_DB_DATA_OFF - heads) / 24u) {
+			return -1;
+		}
+		for (uint32_t e = 0; e < count; e++) {
+			const unsigned int ent_off = GPB_CMD_DB_DATA_OFF + heads + e * 24u;
+			if (gpu_probe_rd32(db_va, ent_off) == key[0] &&
+			    gpu_probe_rd32(db_va, ent_off + 4u) == key[1]) {
+				const uint32_t addr = gpu_probe_rd32(db_va, ent_off + 16u);
+				const uint32_t len_off = gpu_probe_rd32(db_va, ent_off + 20u);
+				const uint32_t aux_len = len_off & 0xffffu;
+				const uint32_t aux_off = len_off >> 16;
+				if (GPB_CMD_DB_DATA_OFF + data + aux_off + aux_len > GPB_CMD_DB_SIZE) {
+					return -1;
+				}
+				*out_addr = addr;
+				*out_len = aux_len;
+				return 0;
+			}
+		}
+	}
+	return 1;
+}
