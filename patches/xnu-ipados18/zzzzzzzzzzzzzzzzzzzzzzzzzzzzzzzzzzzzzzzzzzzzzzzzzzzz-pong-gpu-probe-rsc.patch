+/* ---- Mode 9 helpers ------------------------------------------------------------------------------ */
+/* gmu_poll_timeout(.., 100, 10000) as A650Gmu.c:57-72: a read every 100 us for at most 10 ms. 0 = matched. */
+static int
+gpu_probe_poll32(vm_offset_t base, unsigned int byte_off, uint32_t mask, uint32_t expected, uint32_t *seen)
+{
+	const uint64_t start = gpu_probe_now_us();
+
+	for (;;) {
+		*seen = gpu_probe_rd32(base, byte_off);
+		if ((*seen & mask) == expected) {
+			return 0;
+		}
+		if (gpu_probe_now_us() - start >= 10000) {
+			return 1;
+		}
+		gpu_probe_spin_us(100);
+	}
+}
