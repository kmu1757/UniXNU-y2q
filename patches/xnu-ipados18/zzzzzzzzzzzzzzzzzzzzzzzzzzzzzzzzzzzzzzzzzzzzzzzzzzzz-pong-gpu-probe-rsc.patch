+/* a6xx_gmu_rpmh_init for the a650 family, in the order A650Gmu.c:157-173 writes it. pdc: 0 = the RSCC page,
+ * 1 = the PDC page (the PDC's own sequence belongs to the AOP; only its start address and enable are written). */
+static const struct { uint8_t pdc; uint16_t off; uint32_t val; } gmu_rsc_table[] = {
+	{ 0, GMU_RSCC_RSC_STATUS0_OFF, 1u << 24 },              /* disable SDE clock gating */
