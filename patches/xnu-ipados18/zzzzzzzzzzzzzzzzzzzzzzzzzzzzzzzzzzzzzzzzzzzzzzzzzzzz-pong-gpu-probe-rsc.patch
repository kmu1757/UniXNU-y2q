+	{ 0, GMU_RSCC_HIDDEN_TCS_DATA_OFF, 0 },
+	{ 0, GMU_RSCC_HIDDEN_TCS_ADDR_OFF, 0 },
+	{ 0, GMU_RSCC_HIDDEN_TCS_DATA_OFF + 8, 0 },             /* dword + 2 */
+	{ 0, GMU_RSCC_HIDDEN_TCS_ADDR_OFF + 8, 0 },
+	{ 0, GMU_RSCC_HIDDEN_TCS_DATA_OFF + 16, 0x80000000u },  /* dword + 4 */
+	{ 0, GMU_RSCC_HIDDEN_TCS_ADDR_OFF + 16, 0 },
+	{ 0, GMU_RSCC_OVERRIDE_START_OFF, 0 },
+	{ 0, GMU_RSCC_PDC_SEQ_START_ADDR_OFF, 0x4520 },
+	{ 0, GMU_RSCC_PDC_MATCH_VALUE_LO_OFF, 0x4510 },
+	{ 0, GMU_RSCC_PDC_MATCH_VALUE_HI_OFF, 0x4514 },
+	{ 0, GMU_RSCC_SEQ_MEM_0_OFF, 0xeaaae5a0u },             /* the a650 family's sleep / wake-up microcode */
+	{ 0, GMU_RSCC_SEQ_MEM_0_OFF + 4, 0xe1a1ebabu },
+	{ 0, GMU_RSCC_SEQ_MEM_0_OFF + 8, 0xa2e0a581u },
+	{ 0, GMU_RSCC_SEQ_MEM_0_OFF + 12, 0xecac82e2u },
+	{ 0, GMU_RSCC_SEQ_MEM_0_OFF + 16, 0x0020edadu },
+	{ 1, GMU_PDC_GPU_SEQ_START_ADDR_OFF, 0 },
+	{ 1, GMU_PDC_GPU_ENABLE_PDC_OFF, 0x80000001u },
+};
