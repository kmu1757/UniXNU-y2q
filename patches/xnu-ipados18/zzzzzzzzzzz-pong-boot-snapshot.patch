+
+typedef int (*proc_iterate_fn_t)(proc_t, void *);
+#define PROC_ALLPROCLIST  (1U << 0)
+#define PROC_RETURNED     (0)
+extern void proc_iterate(unsigned int flags, proc_iterate_fn_t callout,
+    void *arg, proc_iterate_fn_t filterfn, void *filterarg);
+extern void pong_dump_task_threads_pmsg(task_t task, const char *comm, int pid, uint32_t snap_sec);
+
+static int
+pong_snap_proc_callback(proc_t p, void *arg)
+{
+	const char *comm = p->p_comm;
+	if (!comm) return PROC_RETURNED;
+	int pid = proc_pid(p);
+	if (pid == 1 ||
+	    strcmp(comm, "SpringBoard") == 0 ||
+	    strcmp(comm, "backboardd") == 0 ||
+	    strcmp(comm, "runningboardd") == 0 ||
+	    strcmp(comm, "lockdownd") == 0 ||
+	    strcmp(comm, "keybagd") == 0 ||
+	    strcmp(comm, "containermanagerd") == 0 ||
+	    strcmp(comm, "PurpleBuddy") == 0 ||
+	    strcmp(comm, "mobileactivationd") == 0 ||
+	    strcmp(comm, "cfprefsd") == 0) {
+		task_t task = proc_task(p);
+		if (task != TASK_NULL) {
+			uint32_t target_sec = *(uint32_t *)arg;
+			pong_dump_task_threads_pmsg(task, comm, pid, target_sec);
+		}
+	}
+	return PROC_RETURNED;
+}
