 	return th;
 }
+
+extern void pong_ramoops_diagnostic_write(const char *, int);
+extern const char *pong_thread_get_wmesg(thread_t);
+
+void pong_dump_task_threads_pmsg(task_t task, const char *comm, int pid, uint32_t snap_sec);
+void
+pong_dump_task_threads_pmsg(task_t task, const char *comm, int pid, uint32_t snap_sec)
+{
+	if (task == TASK_NULL || comm == NULL) {
+		return;
+	}
+
+	task_lock(task);
+	if (!task->active) {
+		task_unlock(task);
+		return;
+	}
+
+	thread_t th_list[32];
+	uint32_t nth = 0;
+	thread_t th = THREAD_NULL;
+
+	queue_iterate(&task->threads, th, thread_t, task_threads) {
+		if (nth < 32) {
+			thread_reference(th);
+			th_list[nth++] = th;
+		}
+	}
+	task_unlock(task);
+
+	for (uint32_t i = 0; i < nth; i++) {
+		thread_t cur_th = th_list[i];
+		int th_state = cur_th->state;
+		uint64_t wait_event = (uint64_t)cur_th->wait_event;
+		uint64_t continuation = cur_th->continuation ? (uint64_t)VM_KERNEL_UNSLIDE(cur_th->continuation) : 0;
+
+		const char *wmesg = pong_thread_get_wmesg(cur_th);
+
+		const char *state_str = "UNK";
+		if (th_state & 0x01 /* TH_WAIT */) {
+			state_str = "WAIT";
+		} else if (th_state & 0x04 /* TH_RUN */) {
+			state_str = "RUN";
+		} else if (th_state & 0x02 /* TH_SUSP */) {
+			state_str = "SUSP";
+		}
+
+		uint64_t kframes[4] = { 0 };
+		int nkframes = 0;
+		if (continuation != 0) {
+			kframes[0] = continuation;
+			nkframes = 1;
+		} else if (cur_th->kernel_stack != 0) {
+			vm_offset_t kstack_bottom = cur_th->kernel_stack;
+			vm_offset_t kstack_top = kstack_bottom + kernel_stack_size;
+			arm_kernel_saved_state_t *kstate = &thread_get_kernel_state(cur_th)->machine.ss;
+			uint64_t fp = kstate->fp;
+			uint64_t lr = kstate->lr;
+			if (lr != 0) {
+#if defined(HAS_APPLE_PAC)
+				lr = (uint64_t)ptrauth_strip((void *)lr, ptrauth_key_return_address);
+#endif
+				kframes[nkframes++] = (uint64_t)VM_KERNEL_UNSLIDE(lr);
+			}
+			while (nkframes < 4) {
+				if (fp < kstack_bottom || fp + 16 > kstack_top || (fp & 7) != 0) {
+					break;
+				}
+				uint64_t next_fp = *(uint64_t *)fp;
+				uint64_t next_lr = *(uint64_t *)(fp + 8);
+#if defined(HAS_APPLE_PAC)
+				next_lr = (uint64_t)ptrauth_strip((void *)next_lr, ptrauth_key_return_address);
+#endif
+				next_lr = (uint64_t)VM_KERNEL_UNSLIDE(next_lr);
+				if (next_lr == 0) break;
+				kframes[nkframes++] = next_lr;
+				if (next_fp <= fp || next_fp >= kstack_top) break;
+				fp = next_fp;
+			}
+		}
+
+		uint64_t user_pc = 0;
+		uint64_t user_lr = 0;
+		const arm_saved_state_t *ustate = get_user_regs(cur_th);
+		if (ustate != NULL && is_saved_state64(ustate)) {
+			user_pc = (uint64_t)get_saved_state_pc(ustate);
+			user_lr = (uint64_t)get_saved_state_lr(ustate);
+		}
+
+		char line[384];
+		int n = snprintf(line, sizeof(line),
+		    "[SNAP %us] %s[%d] th#%u st=%s ev=0x%llx wm='%s' u_pc=0x%llx u_lr=0x%llx",
+		    snap_sec, comm, pid, i, state_str, wait_event, wmesg, user_pc, user_lr);
+		if (n > 0 && n < (int)sizeof(line) && nkframes > 0) {
+			int used = snprintf(line + n, sizeof(line) - (size_t)n, " k_bt=[");
+			if (used > 0 && n + used < (int)sizeof(line)) {
+				n += used;
+				for (int f = 0; f < nkframes; f++) {
+					used = snprintf(line + n, sizeof(line) - (size_t)n, "%s0x%llx", (f > 0 ? "," : ""), kframes[f]);
+					if (used > 0 && n + used < (int)sizeof(line)) {
+						n += used;
+					}
+				}
+				used = snprintf(line + n, sizeof(line) - (size_t)n, "]");
+				if (used > 0 && n + used < (int)sizeof(line)) {
+					n += used;
+				}
+			}
+		}
+		if (n > 0 && n < (int)sizeof(line)) {
+			line[n++] = '\n';
+			line[n] = '\0';
+		}
+		if (n > 0) {
+			pong_ramoops_diagnostic_write(line, n < (int)sizeof(line) ? n : (int)sizeof(line) - 1);
+		}
+
+		thread_deallocate(cur_th);
+	}
+}
 #endif
