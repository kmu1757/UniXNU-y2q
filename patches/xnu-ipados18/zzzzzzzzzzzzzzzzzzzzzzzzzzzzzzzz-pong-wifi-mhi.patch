+static void
+cmd_handle_wifimhi(void)
+{
+	char reply[400];
+
+	reply[0] = '\0';
+	(void)pong_wifi_mhi_read(reply, sizeof(reply));
+	send_str(reply[0] ? reply : "wifimhi: no reply\n");
+}
