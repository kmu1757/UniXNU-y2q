+++ b/bsd/dev/pong_buttons.c
@@ -373,6 +373,26 @@ static bool write_register(const struct peripheral *p, uint8_t reg, uint8_t valu
     return (status & 0xf) == 1;
 }
 
+/* The boot loader's restart reason: PM8150 PON_SOFT_RB_SPARE (0x8f), bits 7:1 on this PON generation, values as
+ * Linux drivers/power/reset/qcom-pon.c with "qcom,pm8998-pon" and pm8150.dtsi (mode-recovery = 1, mode-bootloader = 2;
+ * no code taken). The stock kernel sets it next to the IMEM word; the IMEM word alone came back as a normal boot
+ * (11-10). The key polling stops for good: the caller restarts the board next. */
+bool pong_pmic_restart_reason(unsigned reason);
+bool pong_pmic_restart_reason(unsigned reason)
+{
+    uint8_t was = 0, now = 0;
+
+    if (reason > 0x7f) return false;
+    __atomic_store_n(&power_down_started, 1, __ATOMIC_RELEASE);
+    delay_for_interval(80, NSEC_PER_MSEC);          /* the polling loop's last read is over */
+    const uint8_t want = (uint8_t)((reason << 1) & 0xfe);
+    bool ok = read_registers(&pon, 0x8f, &was, 1) && write_register(&pon, 0x8f, (uint8_t)((was & 1) | want)) &&
+        read_registers(&pon, 0x8f, &now, 1) && (now & 0xfe) == want;
+
+    pmsg_log("[PONG_PWR] restart reason %u: spare %02x>%02x ok=%d\n", reason, was, now, ok);
+    return ok;
+}
+
 /* howto: reboot(2) flags. Returns only when the board stayed up. */
 void pong_power_down(int howto)
 {
