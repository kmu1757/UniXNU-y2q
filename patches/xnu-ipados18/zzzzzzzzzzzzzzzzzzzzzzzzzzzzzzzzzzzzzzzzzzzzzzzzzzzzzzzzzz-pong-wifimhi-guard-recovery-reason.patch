diff --git a/bsd/dev/pong_wifi_link.c b/bsd/dev/pong_wifi_link.c
index 5308e98..bd5ec07 100644
--- a/bsd/dev/pong_wifi_link.c
+++ b/bsd/dev/pong_wifi_link.c
@@ -868,6 +868,23 @@ wm_run(struct wm *w)
 	}
 	w->step = 17;
 
+	/* A second call once the endpoint's bus mastering is on (stage 3c and later): the firmware is running, and
+	 * steps 18-20 would turn memory decoding and bus mastering off, re-size BAR0 and leave bus mastering off.
+	 * 11-13: after exactly that the firmware stayed in SBL past a complete BHIe transfer and went to SYS_ERR.
+	 * From here the call only reads. */
+	cmd = rd(EP_COMMAND);
+	if (cmd & 0x4u) {
+		w->rpcmd = rd(DBI_COMMAND);
+		w->memwin = rd(DBI_MEM_WINDOW);
+		w->mask = 0;
+		w->bar = rd(EP_BAR0);
+		w->cmd = cmd;
+		w->cls1 = w->cls0;
+		address = w->bar & ~0xfu;
+		w->why = "OK read-only";
+		goto mapped;
+	}
+
 	/* 18: outbound iATU region 1 = memory, identity, the whole DTS window; root port window and
 	 * Memory Space. Prerequisite: DBI/iATU reachable (step 17). Nothing goes on the wire here. */
 	wm_mark(18);
@@ -941,6 +958,7 @@ wm_run(struct wm *w)
 	w->cls1 = rd(EP_CLASS);
 	w->step = 20;
 
+mapped:
 	/* 21: the first memory request to the chip: one 16K page at BAR0, MHI registers, reads only.
 	 * Prerequisite: link up and data link active right now, window + BAR + decoding in place. */
 	wm_mark(21);
