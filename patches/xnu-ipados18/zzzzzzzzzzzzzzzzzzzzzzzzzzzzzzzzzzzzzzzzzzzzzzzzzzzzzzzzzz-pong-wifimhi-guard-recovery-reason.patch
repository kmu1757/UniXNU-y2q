+			/* 11-13: 0x8000007f read back 0. The camera SMMU of the same tablet took only the stock kernel's exact
+			 * stream ids (rui camera-notes.md), so the same slot gets the GMU's stream 5 with no mask, and its old
+			 * value back. The slot's S2CR is type FAULT and the GMU is in reset: nothing can match meanwhile. */
+			gpu_probe_wr32(g_smmu_gr0_page, off, 0x80000005u, 62);
+			const uint32_t got5 = gpu_probe_rd32(g_smmu_gr0_page, off);
+			gpu_probe_wr32(g_smmu_gr0_page, off, was, 63);
 			snprintf(gsmmu_extra, sizeof(gsmmu_extra),
-			    " gsmmu[n=%u smr=%x/%x/%x/%x/%x/%x s2cr=%x/%x/%x/%x/%x/%x wr=%#x>%#x>%#x %s gfsr=%#x]",
+			    " gsmmu[n=%u smr=%x/%x/%x/%x/%x/%x s2cr=%x/%x/%x/%x/%x/%x wr=%#x>%#x>%#x %s gfsr=%#x sid5=%#x>%#x scr0=%#x acr=%#x]",
 			    smr_count, smr[0], smr[1], smr[2], smr[3], smr[4], smr[5],
 			    s2cr[0], s2cr[1], s2cr[2], s2cr[3], s2cr[4], s2cr[5], was, got, back,
 			    got == 0x8000007fu ? "writable" : got == was ? "refused" : "partial",
