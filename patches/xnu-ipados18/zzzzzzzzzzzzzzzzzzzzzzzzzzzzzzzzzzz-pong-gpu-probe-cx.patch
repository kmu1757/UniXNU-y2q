+/*
+ * Log `[PONG_GPU] W<n>` to pmsg BEFORE every MMIO write (same discipline as `wl_mark` in
+ * `pong_wifi_link.c:270-279`), so a bus hang or silent SoC reset identifies the exact write:
+ *   W1: GPU_CC_CX_GDSCR (0x03d9106c) clear SW_COLLAPSE (bit 0)
+ *   W2: GPU_CC_AHB_CBCR (0x03d91078) set CLK_ENABLE (bit 0)
+ *   W3: GPU_CC_HLOS1_VOTE_GPU_SMMU_CLK (0x03d95000) set CLK_ENABLE (bit 0)
+ */
+static void
+gpu_probe_wmark(unsigned int wstep)
+{
+	char line[24];
+	int n = snprintf(line, sizeof(line), "[PONG_GPU] W%u\n", wstep);
+
+	if (n > 0) {
+		pong_ramoops_diagnostic_write(line, n < (int)sizeof(line) ? n : (int)sizeof(line) - 1);
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+}
+
+static inline void
+gpu_probe_wr32(vm_offset_t base, unsigned int byte_off, uint32_t val, unsigned int wstep)
+{
+	gpu_probe_wmark(wstep);
+	*(volatile uint32_t *)(base + byte_off) = val;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static uint64_t
+gpu_probe_now_us(void)
+{
+	uint64_t ns = 0;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000;
+}
+
+static void
+gpu_probe_spin_us(uint32_t us)
+{
+	uint64_t end = gpu_probe_now_us() + us;
+
+	while (gpu_probe_now_us() < end) {
+	}
+}
