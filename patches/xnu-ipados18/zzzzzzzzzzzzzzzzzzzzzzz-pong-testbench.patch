+		cmd_handle_cpus();
+	} else if (strncmp(cmd, "prefer ", 7) == 0) {
+		cmd_handle_prefer(cmd + 7);
 	} else {
-		send_str("ERROR: unknown command. Available: ping, status, log, reboot, reboot-recovery, screenshot, tap, swipe, threads\n");
