+/* cpus: how busy each core was since the previous `cpus` (the first call: since boot). */
+static void
+cmd_handle_cpus(void)
+{
+	static uint64_t last_idle[8], last_time;
+	char reply[160];
+	uint64_t now = mach_absolute_time(), elapsed = now - last_time, ms = 0;
+	int n;
+
+	absolutetime_to_nanoseconds(elapsed, &ms);
+	n = snprintf(reply, sizeof(reply), "cpus: %llu ms prefer=%d busy%%:", ms / NSEC_PER_MSEC, pong_prefer_cluster);
+	for (unsigned c = 0; c < 8; c++) {
+		uint64_t idle = pong_cpu_idle_mach(c);
+		uint64_t delta = idle - last_idle[c];
+		unsigned busy = (idle == UINT64_MAX || elapsed == 0 || delta >= elapsed) ? 0 : (unsigned)(100 - delta * 100 / elapsed);
+
+		last_idle[c] = idle;
+		if (n > 0 && n < (int)sizeof(reply) - 6) {
+			n += snprintf(reply + n, sizeof(reply) - (size_t)n, " %u", busy);
+		}
+	}
+	last_time = now;
+	if (n > 0 && n < (int)sizeof(reply) - 2) {
+		reply[n] = '\n';
+		reply[n + 1] = '\0';
+	}
+	send_str(reply);
+}
+
+/* prefer N: the cluster every thread group prefers (0 Silver, 1 Gold, 2 Prime; 99: as before). */
+static void
+cmd_handle_prefer(const char *args)
+{
+	const char *p = args;
+	unsigned value = parse_uint(&p);
+	char reply[48];
+
+	pong_prefer_cluster = value <= 2 ? (int)value : -1;
+	snprintf(reply, sizeof(reply), "prefer: %d\n", pong_prefer_cluster);
+	send_str(reply);
+}
