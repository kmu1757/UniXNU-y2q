--- /dev/null
+++ b/bsd/dev/pong_adsp.c
@@ -0,0 +1,208 @@
+/*
+ * SM-T970 audio DSP (ADSP), first step toward sound: `adspup` (mode 0) is a read-only survey of what the
+ * boot loader left in the memory the application processor shares with the DSPs. Nothing is written.
+ *
+ *   SMEM          0x80900000 + 0x200000 (gts7xlwifi.dts smem_region@80900000): the table of contents in its last
+ *                 4 KiB, the partition this processor (host 0) shares with the ADSP (host 2), and that partition's
+ *                 uncached items (SMP2P in 443 / out 429, GLINK 478 / 479 / 480)
+ *   AOSS QMP      0x0c300000 (qmp-aop): the descriptor words (magic, version, link and channel state of both sides)
+ *   TCSR mutex 3  0x01f40000 + 3 * 0x1000: the hardware mutex SMEM allocations take (0 = free)
+ *
+ * Layouts and addresses from UniXNU-gts7xlwifi (https://github.com/rui12366B/UniXNU-gts7xlwifi, c2aa790,
+ * BSD-2-Clause-Patent): package/QcomSmem.c (table of contents, partition header, uncached entries),
+ * package/QcomQmp.c:4-18 (descriptor words), package/T970Adsp.cpp:54-58 (addresses, hosts, item numbers).
+ *
+ * SMEM is 2 MiB and the kernel's I/O map is small (67 windows of 64 KiB ran it out of space on 11-11), so it is
+ * read through at most eight 16 KiB windows made on demand; a walk that needs more stops with `win`.
+ */
+
+#include <pexpert/arm64/board_config.h>
+#if defined(PONG)
+#include <kern/clock.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern void pong_ramoops_diagnostic_write(const char *buf, int len);
+
+int pong_adsp_usb(char *reply, size_t reply_cap, int mode);
+
+#define ADSP_SMEM_PHYS      0x80900000UL
+#define ADSP_SMEM_SIZE      0x200000u
+#define ADSP_WIN            0x4000u
+#define ADSP_WINS           8u
+#define ADSP_QMP_PHYS       0x0c300000UL
+#define ADSP_MUTEX3_PHYS    (0x01f40000UL + 3UL * 0x1000UL)
+#define SMEM_TOC_MAGIC      0x434f5424u   /* "$TOC" */
+#define SMEM_PART_MAGIC     0x54525024u   /* "$PRT" */
+#define SMEM_TOC_HEADER     32u
+#define SMEM_TOC_ENTRY      48u
+#define SMEM_PART_HEADER    32u
+#define SMEM_ENTRY          16u
+#define SMEM_CANARY         0xa5a5u
+#define SMEM_HOST_APPS      0u
+#define SMEM_HOST_ADSP      2u
+#define QMP_MAGIC           0x4d41494cu
+
+static struct { uint32_t off; vm_offset_t va; } g_adsp_win[ADSP_WINS];
+static vm_offset_t g_adsp_qmp, g_adsp_mutex;
+
+/* One aligned word of SMEM. 0 = read; -1 = no window left or the mapping failed. */
+static int
+adsp_smem_rd(uint32_t off, uint32_t *value)
+{
+	const uint32_t base = off & ~(ADSP_WIN - 1u);
+	unsigned i;
+
+	if (off > ADSP_SMEM_SIZE - 4u || (off & 3u)) {
+		return -1;
+	}
+	for (i = 0; i < ADSP_WINS && g_adsp_win[i].va; i++) {
+		if (g_adsp_win[i].off == base) {
+			break;
+		}
+	}
+	if (i == ADSP_WINS) {
+		return -1;
+	}
+	if (!g_adsp_win[i].va) {
+		g_adsp_win[i].va = ml_io_map(ADSP_SMEM_PHYS + base, ADSP_WIN);
+		if (!g_adsp_win[i].va) {
+			return -1;
+		}
+		g_adsp_win[i].off = base;
+	}
+	*value = *(volatile uint32_t *)(g_adsp_win[i].va + (off - base));
+	return 0;
+}
+
+/* Append to line[]: never writes outside it, k stays below sizeof(line). */
+#define ADSP_ADD(...) do { \
+	if (k < (int)sizeof(line) - 1) { \
+		int a_ = snprintf(line + k, sizeof(line) - (size_t)k, __VA_ARGS__); \
+		if (a_ > 0) { k += a_; } \
+	} \
+	if (k > (int)sizeof(line) - 1) { k = (int)sizeof(line) - 1; } \
+} while (0)
+
+int
+pong_adsp_usb(char *reply, size_t reply_cap, int mode)
+{
+	char line[896];
+	int k = 0;
+	const uint32_t toc = ADSP_SMEM_SIZE - 0x1000u;
+	uint32_t magic = 0, version = 0, count = 0, part = 0, part_size = 0;
+	bool global = false;
+
+	if (!reply || reply_cap == 0) {
+		return -1;
+	}
+	if (mode != 0) {
+		snprintf(reply, reply_cap, "adspup: mode %d unsupported\n", mode);
+		return -1;
+	}
+	pong_ramoops_diagnostic_write("[PONG_ADSP] survey\n", 19);
+
+	/* the table of contents: magic, version, entry count, then 48-byte entries (QcomSmem.c:24-45) */
+	if (adsp_smem_rd(toc, &magic) || adsp_smem_rd(toc + 4, &version) || adsp_smem_rd(toc + 8, &count)) {
+		ADSP_ADD("adspup: smem[map-failed]");
+	} else if (magic != SMEM_TOC_MAGIC || version != 1 || count > (0x1000u - SMEM_TOC_HEADER) / SMEM_TOC_ENTRY) {
+		ADSP_ADD("adspup: smem[bad-toc magic=%#x ver=%u count=%u]", magic, version, count);
+	} else {
+		ADSP_ADD("adspup: smem[toc ver=%u parts=%u", version, count);
+		for (uint32_t i = 0; i < count; i++) {
+			const uint32_t e = toc + SMEM_TOC_HEADER + i * SMEM_TOC_ENTRY;
+			uint32_t offset = 0, size = 0, hosts = 0;
+
+			if (adsp_smem_rd(e, &offset) || adsp_smem_rd(e + 4, &size) || adsp_smem_rd(e + 12, &hosts)) {
+				break;
+			}
+			if (!offset || !size) {
+				continue;
+			}
+			ADSP_ADD(" %x:%x@%x+%x", hosts & 0xffffu, hosts >> 16, offset, size);
+			if (hosts == 0xfffefffeu) {
+				global = true;
+			}
+			if (hosts == (SMEM_HOST_APPS | SMEM_HOST_ADSP << 16) || hosts == (SMEM_HOST_ADSP | SMEM_HOST_APPS << 16)) {
+				part = offset;
+				part_size = size;
+			}
+		}
+		ADSP_ADD(" global=%u]", global ? 1u : 0u);
+	}
+
+	/* this processor's partition with the ADSP: header, then the uncached items (QcomSmem.c:34-66) */
+	if (!part) {
+		ADSP_ADD(" part[none]");
+	} else if ((part & 7u) || part > toc || part_size > toc - part || part_size < SMEM_PART_HEADER + 2u * SMEM_ENTRY) {
+		ADSP_ADD(" part[bad off=%#x size=%#x]", part, part_size);
+	} else {
+		uint32_t pm = 0, ph = 0, ps = 0, fu = 0, fc = 0, at = SMEM_PART_HEADER, items = 0, seen = 0;
+		const char *end = "ok";
+
+		if (adsp_smem_rd(part, &pm) || adsp_smem_rd(part + 4, &ph) || adsp_smem_rd(part + 8, &ps) ||
+		    adsp_smem_rd(part + 12, &fu) || adsp_smem_rd(part + 16, &fc)) {
+			ADSP_ADD(" part[win]");
+		} else if (pm != SMEM_PART_MAGIC || ps != part_size || fu < SMEM_PART_HEADER || fu > fc || fc > part_size) {
+			ADSP_ADD(" part[bad magic=%#x size=%#x free=%#x/%#x]", pm, ps, fu, fc);
+		} else {
+			ADSP_ADD(" part[size=%#x free=%#x/%#x items", ps, fu, fc);
+			while (at < fu) {
+				uint32_t w0 = 0, size = 0, pads = 0, id;
+
+				if (fu - at < SMEM_ENTRY) {
+					end = "corrupt";
+					break;
+				}
+				if (adsp_smem_rd(part + at, &w0) || adsp_smem_rd(part + at + 4, &size) ||
+				    adsp_smem_rd(part + at + 8, &pads)) {
+					end = "win";
+					break;
+				}
+				if ((w0 & 0xffffu) != SMEM_CANARY || size > fu - at - SMEM_ENTRY ||
+				    (pads >> 16) > fu - at - SMEM_ENTRY - size) {
+					end = "corrupt";
+					break;
+				}
+				id = w0 >> 16;
+				if (items < 10) {
+					ADSP_ADD(" %u:%x", id, size);
+				}
+				items++;
+				seen |= id == 443 ? 1u : id == 429 ? 2u : id == 478 ? 4u : id == 479 ? 8u : id == 480 ? 16u : 0u;
+				at += SMEM_ENTRY + (pads >> 16) + size;
+			}
+			ADSP_ADD(" n=%u seen=%#x end=%s]", items, seen, end);
+		}
+	}
+
+	/* AOSS QMP descriptor (QcomQmp.c:4-18), dwords 0, 1, 3..6 (the AOP's side), 9..14 (ours) */
+	if (!g_adsp_qmp) {
+		g_adsp_qmp = ml_io_map(ADSP_QMP_PHYS, 0x1000);
+	}
+	if (!g_adsp_qmp) {
+		ADSP_ADD(" qmp[map-failed]");
+	} else {
+		const volatile uint32_t *q = (const volatile uint32_t *)g_adsp_qmp;
+
+		ADSP_ADD(" qmp[magic=%#x(%s) ver=%u aop=%x/%x/%x/%x apps=%x/%x/%x/%x box=%#x+%#x]", q[0],
+		    q[0] == QMP_MAGIC ? "ok" : "bad", q[1], q[3], q[4], q[5], q[6], q[9], q[10], q[11], q[12], q[14], q[13]);
+	}
+
+	if (!g_adsp_mutex) {
+		g_adsp_mutex = ml_io_map(ADSP_MUTEX3_PHYS, 0x1000);
+	}
+	if (!g_adsp_mutex) {
+		ADSP_ADD(" mutex3[map-failed]");
+	} else {
+		ADSP_ADD(" mutex3=%#x", *(const volatile uint32_t *)g_adsp_mutex);
+	}
+	ADSP_ADD(" next=adspfw\n");
+	pong_ramoops_diagnostic_write(line, k);
+	strlcpy(reply, line, reply_cap);
+	return 0;
+}
+#endif /* PONG */
