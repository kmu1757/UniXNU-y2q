+struct pong_var_file {
+	const char *dst;
+	const char *tmp;
+	const char *content;
+	size_t len;
+};
+
+static void
+pong_var_ensure_dir(proc_t p, user_addr_t scratch, const char *path)
+{
+	size_t len = strlen(path) + 1;
+	if (copyout(path, scratch + 0x300, len) == 0) {
+		struct mkdir_args margs = {
+			.path = scratch + 0x300,
+			.mode = 0755,
+		};
+		int32_t retval = 0;
+		extern int mkdir(proc_t, struct mkdir_args *, int32_t *);
+		(void)mkdir(p, &margs, &retval);
+
+		vnode_t vp = NULLVP;
+		vfs_context_t ctx = vfs_context_current();
+		if (vnode_lookup(path, 0, &vp, ctx) == 0) {
+			struct vnode_attr va;
+			VATTR_INIT(&va);
+			VATTR_SET(&va, va_uid, (uid_t)501);
+			VATTR_SET(&va, va_gid, (gid_t)501);
+			VATTR_SET(&va, va_mode, (mode_t)0755);
+			vnode_setattr(vp, &va, ctx);
+			vnode_put(vp);
+		}
+	}
+}
+
+static void
+pong_var_seed_apply(proc_t p, user_addr_t scratch)
+{
+	uint32_t seed_arg = 0;
+	if (!PE_parse_boot_argn("pong_var_seed", &seed_arg, sizeof(seed_arg)) || seed_arg != 1) {
+		return;
+	}
+
+	extern void pong_ramoops_diagnostic_write(const char *, int);
+
+	pong_var_ensure_dir(p, scratch, "/private/var/mobile");
+	pong_var_ensure_dir(p, scratch, "/private/var/mobile/Library");
+	pong_var_ensure_dir(p, scratch, "/private/var/mobile/Library/Preferences");
+
+	const struct pong_var_file files[] = {
+		{
+			"/private/var/mobile/Library/Preferences/com.apple.springboard.plist",
+			"/private/var/mobile/Library/Preferences/.com.apple.springboard.plist.pong-tmp",
+			pong_seed_springboard,
+			sizeof(pong_seed_springboard) - 1,
+		},
+		{
+			"/private/var/mobile/Library/Preferences/com.apple.migration.plist",
+			"/private/var/mobile/Library/Preferences/.com.apple.migration.plist.pong-tmp",
+			pong_seed_migration,
+			sizeof(pong_seed_migration) - 1,
+		},
+		{
+			"/private/var/mobile/Library/Preferences/com.apple.managedconfiguration.notbackedup.plist",
+			"/private/var/mobile/Library/Preferences/.com.apple.managedconfiguration.notbackedup.plist.pong-tmp",
+			pong_seed_managedconfig,
+			sizeof(pong_seed_managedconfig) - 1,
+		},
+	};
+
+	vfs_context_t ctx = vfs_context_current();
+	int ok_count = 0;
+	int fail_count = 0;
+	int last_err = 0;
+
+	for (size_t i = 0; i < sizeof(files) / sizeof(files[0]); i++) {
+		const struct pong_var_file *pf = &files[i];
+		vnode_t vp = NULLVP;
+
+		int err = vnode_open(pf->tmp, O_CREAT | O_TRUNC | FWRITE, 0600, 0, &vp, ctx);
+		if (err) {
+			fail_count++;
+			last_err = err;
+			printf("Pong var seed: vnode_open failed tmp=%s err=%d\n", pf->tmp, err);
+			continue;
+		}
+
+		int resid = 0;
+		err = vn_rdwr(UIO_WRITE, vp, (caddr_t)pf->content, (int)pf->len, 0,
+		    UIO_SYSSPACE, IO_NODELOCKED, vfs_context_ucred(ctx), &resid, p);
+		if (err) {
+			vnode_close(vp, FWRITE, ctx);
+			fail_count++;
+			last_err = err;
+			printf("Pong var seed: vn_rdwr failed tmp=%s err=%d\n", pf->tmp, err);
+			continue;
+		}
+
+		struct vnode_attr va;
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_uid, (uid_t)501);
+		VATTR_SET(&va, va_gid, (gid_t)501);
+		VATTR_SET(&va, va_mode, (mode_t)0600);
+		vnode_setattr(vp, &va, ctx);
+
+		vnode_close(vp, FWRITE, ctx);
+
+		user_addr_t u_tmp = scratch + 0x300;
+		user_addr_t u_dst = scratch + 0x400;
+		size_t tmp_len = strlen(pf->tmp) + 1;
+		size_t dst_len = strlen(pf->dst) + 1;
+
+		if (copyout(pf->tmp, u_tmp, tmp_len) || copyout(pf->dst, u_dst, dst_len)) {
+			fail_count++;
+			last_err = EFAULT;
+			printf("Pong var seed: copyout failed for rename\n");
+			continue;
+		}
+
+		struct rename_args rargs = {
+			.from = u_tmp,
+			.to = u_dst,
+		};
+		int32_t retval = 0;
+		extern int rename(proc_t, struct rename_args *, int32_t *);
+		err = rename(p, &rargs, &retval);
+		if (err) {
+			fail_count++;
+			last_err = err;
+			printf("Pong var seed: rename failed %s -> %s err=%d\n", pf->tmp, pf->dst, err);
+		} else {
+			ok_count++;
