+/* Unsigned number, decimal or 0x hexadecimal */
+static uint32_t
+parse_num(const char **p)
+{
+	uint32_t val = 0;
+
+	while (**p == ' ') {
+		(*p)++;
+	}
+	if ((*p)[0] != '0' || ((*p)[1] != 'x' && (*p)[1] != 'X')) {
+		return parse_uint(p);
+	}
+	for (*p += 2;; (*p)++) {
+		char c = **p;
+
+		if (c >= '0' && c <= '9') {
+			val = (val << 4) | (uint32_t)(c - '0');
+		} else if (c >= 'a' && c <= 'f') {
+			val = (val << 4) | (uint32_t)(c - 'a' + 10);
+		} else if (c >= 'A' && c <= 'F') {
+			val = (val << 4) | (uint32_t)(c - 'A' + 10);
+		} else {
+			return val;
+		}
+	}
+}
