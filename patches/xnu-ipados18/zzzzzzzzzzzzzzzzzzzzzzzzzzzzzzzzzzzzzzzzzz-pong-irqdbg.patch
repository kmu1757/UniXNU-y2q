+/*
+ * irqdbg [N]: read, and with N set, the development kernel's "interrupts were held disabled too long" check
+ * (kern.interrupt_masked_debug_mode: 0 off, 1 trace, 2 panic). On 11-11 this check panicked the tablet twice, in
+ * bzero_phys / bcopy_phys of ordinary user tasks, 0.66 ms and about 2.5 ms against a 0.625 ms limit; the cause of
+ * the long section is not known yet. Setting it from here, after boot, leaves early boot exactly as it was.
+ */
+static void
+cmd_handle_irqdbg(const char *arg)
+{
+	char reply[120];
+	const char *p = arg;
+	unsigned was = 0xffffffffu, now = 0xffffffffu, mode = 0;
+	size_t len = sizeof(was);
+	int rc, rc_set = 0, rc_now;
+	bool set = false;
+
+	while (*p == ' ') {
+		p++;
+	}
+	rc = kernel_sysctlbyname("kern.interrupt_masked_debug_mode", &was, &len, NULL, 0);
+	if (*p >= '0' && *p <= '2') {
+		set = true;
+		mode = parse_num(&p);
+		rc_set = kernel_sysctlbyname("kern.interrupt_masked_debug_mode", NULL, NULL, &mode, sizeof(mode));
+	}
+	len = sizeof(now);
+	rc_now = kernel_sysctlbyname("kern.interrupt_masked_debug_mode", &now, &len, NULL, 0);
+	snprintf(reply, sizeof(reply), "irqdbg: was %u (rc %d) set %u (%s rc %d) now %u (rc %d)\n",
+	    was, rc, mode, set ? "yes" : "no", rc_set, now, rc_now);
+	send_str(reply);
+}
