diff --git a/bsd/kern/kern_exit.c b/bsd/kern/kern_exit.c
index cc27546..e1f0e42 100644
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -1953,5 +1953,27 @@ proc_prepareexit(proc_t p, int rv, boolean_t perf_notify)
 		}
 	}
+	{
+		extern int pong_pmsg_exec;
+		extern void pong_ramoops_diagnostic_write(const char *, int);
+		extern uint64_t mach_absolute_time(void);
+		extern void absolutetime_to_nanoseconds(uint64_t, uint64_t *);
+		if (pong_pmsg_exec) {
+			uint64_t now_ns = 0;
+			absolutetime_to_nanoseconds(mach_absolute_time(), &now_ns);
+			os_reason_t reason = p->p_exit_reason;
+			char line[256];
+			int len = snprintf(line, sizeof(line),
+			    "Pong exit: pid=%d comm=%s signal=%d status=%d ns=%u code=0x%llx +%llums\n",
+			    proc_getpid(p), p->p_comm ? p->p_comm : "unknown",
+			    WTERMSIG(rv), WEXITSTATUS(rv),
+			    reason ? reason->osr_namespace : 0,
+			    reason ? reason->osr_code : 0ULL,
+			    now_ns / 1000000ULL);
+			if (len > 0) {
+				pong_ramoops_diagnostic_write(line, len < (int)sizeof(line) ? len : (int)sizeof(line) - 1);
+			}
+		}
+	}
 #endif
 
