--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -6212,5 +6212,23 @@ exec_extract_strings(struct image_params *imgp)
 		if (imgp->ip_ndp && PE_parse_boot_argn("pong_exec_trace", &pong_exec_trace, sizeof(pong_exec_trace)) && pong_exec_trace)
 			printf("Pong exec: pid=%d %.*s\n", proc_getpid(current_proc()),
