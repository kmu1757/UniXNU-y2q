diff --git a/iokit/Kernel/PongBacklightT970.cpp b/iokit/Kernel/PongBacklightT970.cpp
new file mode 100644
index 0000000..688baa6
--- /dev/null
+++ b/iokit/Kernel/PongBacklightT970.cpp
@@ -0,0 +1,192 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent
+ *
+ * SM-T970 (SM8250 / kona, Galaxy Tab S7+) panel backlight presented to iPadOS as
+ * AppleARMBacklight, so the Settings / Control Center brightness slider drives the real panel.
+ *
+ * The transport is the DSI0 DCS three-packet write already in bsd/dev/pong_backlight_t970.c
+ * (the same one the USB `bl` command uses): 68 19 20 00 14 -> 51 DBV[7:0] DBV[10:8] -> 53 20.
+ * This file only adds the IOKit service on top of that entry point (pong_backlight_set_dbv);
+ * it does not re-implement the transfer, does not do the DCS 0x52 read-back (a bus turnaround
+ * halted this SoC in rui's v84-v86), and never touches DSI1, the PLL, the PHY or a DMA buffer.
+ *
+ * Gated by the boot argument pong_backlight=1 (off by default): without it the kernel behaves
+ * exactly as before. The service publishes IODisplayParameters.brightness = {min=10, max=2047,
+ * value=...} and accepts brightness / FadePeriod in setProperties. The value CoreBrightness
+ * sends is the panel DBV directly (linear for now; a curve can replace brightness_to_dbv later).
+ * The service never writes a level at boot: it publishes a placeholder and waits for the first
+ * request, so the panel keeps whatever brightness the boot loader left until the user moves the
+ * slider. A failed transfer leaves one pmsg line and the next request is still served.
+ *
+ * The AppleARMBacklight conformance is the source-level getMetaClass override (the same shape as
+ * ref/UniXNU-pong/drivers/PongPower/PongBacklight.cpp:393-403): the class is registered under its
+ * own name at static-init, and getMetaClass answers the real Apple metaclass only for the one
+ * published instance. No vtable slot is guessed and no duplicate class name is registered.
+ *
+ * Ported from UniXNU-gts7xlwifi (https://github.com/rui12366B/UniXNU-gts7xlwifi, c2aa790)
+ * package/BacklightProbe.cpp (the T970Backlight service :194-321) and from UniXNU-pong
+ * PongBacklight.cpp (the getMetaClass override and the 22H374 property set). Both are
+ * BSD-2-Clause-Patent. Copyright (c) 2026, UniXNU-gts7xlwifi contributors. All rights reserved.
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(PONG) && (DEVELOPMENT || DEBUG) && !SECURE_KERNEL
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSSymbol.h>
+#include <libkern/OSKextLib.h>
+#include <pexpert/pexpert.h>
+
+extern "C" int pong_backlight_set_dbv(uint32_t dbv);
+
+namespace {
+const OSMetaClass *gAppleClass;
+class T970Backlight;
+T970Backlight *gPublished;
+
+/* The one place the service's brightness unit maps to a panel DBV. Linear for now: the unit IS
+ * the DBV, clamped to the panel's 10..2047 range (0..9 are not a valid DBV; the panel is off via
+ * a different command, not via DBV 0). A later curve replaces only this function. */
+static uint32_t
+brightness_to_dbv(uint32_t value)
+{
+	if (value < 10) {
+		return 10;
+	}
+	if (value > 2047) {
+		return 2047;
+	}
+	return value;
+}
+} // namespace
+
+class T970Backlight : public IOService {
+	OSDeclareDefaultStructors(T970Backlight)
+	uint32_t level = 1029;   /* the last value CoreBrightness asked for; never written at boot */
+
+	void publishLevel();
+public:
+	bool start(IOService *provider) override;
+	IOReturn setProperties(OSObject *properties) override;
+	void free() override;
+};
+
+void
+T970Backlight::publishLevel()
+{
+	OSDictionary *item = OSDictionary::withCapacity(3);
+	OSDictionary *parameters = OSDictionary::withCapacity(1);
+	OSNumber *minimum = OSNumber::withNumber(10ULL, 32);
+	OSNumber *maximum = OSNumber::withNumber(2047ULL, 32);
+	OSNumber *value = OSNumber::withNumber((uint64_t)level, 32);
+
+	if (item && parameters && minimum && maximum && value) {
+		item->setObject("min", minimum);
+		item->setObject("max", maximum);
+		item->setObject("value", value);
+		parameters->setObject("brightness", item);
+		setProperty("IODisplayParameters", parameters);
+	}
+	OSSafeReleaseNULL(item);
+	OSSafeReleaseNULL(parameters);
+	OSSafeReleaseNULL(minimum);
+	OSSafeReleaseNULL(maximum);
+	OSSafeReleaseNULL(value);
+}
+
+bool
+T970Backlight::start(IOService *provider)
+{
+	(void)provider;
+	const OSSymbol *name = OSSymbol::withCString("AppleARMBacklight");
+
+	gAppleClass = name ? OSMetaClass::getMetaClassWithName(name) : nullptr;
+	OSSafeReleaseNULL(name);
+	if (!gAppleClass) {
+		IOLog("T970Backlight: native AppleARMBacklight class unavailable; keep current brightness\n");
+		return false;
+	}
+	gPublished = this;
+	setName("AppleARMBacklight");
+	setProperty("NativeSandboxGrantProcess", "backboardd");
+	setProperty("backlight-control", true);
+	setProperty("built-in", true);
+	/* Matching key for the 22H374 CoreBrightness adapter in userland/ui_compat18.c; not a panel
+	 * description. The adapter only installs when this exact string is present. */
+	setProperty("PongPanel", "NT37705 Visionox / SM8475 DSI0");
+	publishLevel();
+	registerService();
+	IOLog("T970Backlight: DCS service ready (pong_backlight=1), level=%u\n", level);
+	return true;
+}
+
+IOReturn
+T970Backlight::setProperties(OSObject *properties)
+{
+	OSDictionary *dictionary = OSDynamicCast(OSDictionary, properties);
+
+	if (!dictionary) {
+		return kIOReturnBadArgument;
+	}
+	OSNumber *brightness = OSDynamicCast(OSNumber, dictionary->getObject("brightness"));
+	if (!brightness) {
+		return kIOReturnSuccess;
+	}
+	const uint32_t dbv = brightness_to_dbv(brightness->unsigned32BitValue());
+
+	level = dbv;
+	/* A failed transfer already left a pmsg line inside pong_backlight_set_dbv; keep serving. */
+	(void)pong_backlight_set_dbv(dbv);
+	publishLevel();
+	return kIOReturnSuccess;
+}
+
+void
+T970Backlight::free()
+{
+	if (gPublished == this) {
+		gPublished = nullptr;
+	}
+	IOService::free();
+}
+
+/* Manual metaclass definition with a source-level getMetaClass override (PongBacklight.cpp:395-404).
+ * gMetaClass is a global object, so its constructor registers "T970Backlight" at static-init; no
+ * preModLoad/postModLoad and no late-init object rewrite are needed. */
+T970Backlight::MetaClass T970Backlight::gMetaClass;
+const OSMetaClass *const T970Backlight::metaClass = &T970Backlight::gMetaClass;
+const OSMetaClass *const T970Backlight::superClass = &IOService::gMetaClass;
+T970Backlight::T970Backlight(const OSMetaClass *meta) : IOService(meta) {}
+T970Backlight::~T970Backlight() {}
+const OSMetaClass *
+T970Backlight::getMetaClass() const
+{
+	return __atomic_load_n(&gPublished, __ATOMIC_ACQUIRE) == this ? gAppleClass : &gMetaClass;
+}
+OSMetaClassConstructorInit(T970Backlight, IOService, )
+OSDefineDefaultStructors(T970Backlight, IOService)
+
+extern "C" void
+pong_backlight_t970_start(IOService *display)
+{
+	static T970Backlight *backlight;
+	unsigned enabled = 0;
+
+	PE_parse_boot_argn("pong_backlight", &enabled, sizeof(enabled));
+	if (!enabled || backlight || !display) {
+		return;
+	}
+	T970Backlight *service = OSTypeAlloc(T970Backlight);
+	if (!service) {
+		return;
+	}
+	if (!service->init() || !service->attach(display) || !service->start(display)) {
+		if (service->getProvider()) {
+			service->detach(display);
+		}
+		service->release();
+		return;
+	}
+	backlight = service;   /* the service and the DSI0 handoff persist until reboot */
+}
+#endif /* PONG && (DEVELOPMENT || DEBUG) && !SECURE_KERNEL */
