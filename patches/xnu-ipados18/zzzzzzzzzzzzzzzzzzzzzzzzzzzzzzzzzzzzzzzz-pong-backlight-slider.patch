index 8fb1e11..32c9947 100644
--- a/bsd/dev/pong_backlight_t970.c
+++ b/bsd/dev/pong_backlight_t970.c
@@ -46,6 +46,7 @@ extern void pong_ramoops_diagnostic_write(const char *buf, int len);
 extern uint64_t mach_absolute_time(void);
 
 int pong_backlight_usb(char *reply, size_t reply_cap, int mode, uint32_t level);
+int pong_backlight_set_dbv(uint32_t dbv);
 
 /* ---- addresses ---------------------------------------------------------------------------- */
 /* One 0x4000 window at ae94000 (one ml_io_map call). Every register this file touches is inside the
@@ -87,6 +88,7 @@ int pong_backlight_usb(char *reply, size_t reply_cap, int mode, uint32_t level);
 
 /* ---- state -------------------------------------------------------------------------------- */
 static vm_offset_t g_bl_dsi;
+static int g_bl_busy;   /* one in-flight transfer guard (USB `bl` and the iOS service share the FIFO) */
 
 /* ---- small helpers ------------------------------------------------------------------------ */
 /* Strict 32-bit volatile helpers with barriers; no memcpy/memmove on Device memory. */
@@ -393,4 +395,71 @@ done:
 	bl_pmsg(reply);
 	return -1;
 }
+
+/*
+ * The iOS-facing entry point: set the panel DBV once, reusing the same bl_send/bl_pack transport
+ * as the USB `bl` command (no second transmitter). The service calls this from its work loop; the
+ * USB command calls pong_backlight_usb from the CDC-ACM thread. The TPG FIFO is not reentrant, so
+ * a single atomic in-flight guard serializes the two callers: a second caller returns -2 instead
+ * of corrupting a transfer in progress.
+ *
+ * Returns 0 on success, -1 if the DBV is out of range or the link is not ready, -2 if a transfer
+ * is already in flight, -3 if a packet failed. On failure one pmsg line is left and the caller
+ * keeps accepting requests (no panic, no unbounded wait).
+ */
+int
+pong_backlight_set_dbv(uint32_t dbv)
+{
+	if (dbv < BL_DBV_MIN || dbv > BL_DBV_MAX) {
+		return -1;
+	}
+	if (__atomic_exchange_n(&g_bl_busy, 1, __ATOMIC_ACQUIRE)) {
+		return -2;
+	}
+	if (!g_bl_dsi) {
+		g_bl_dsi = ml_io_map(BL_DSI0_PHYS, BL_DSI0_WINDOW);
+	}
+	int rc = -1;
+	if (!g_bl_dsi) {
+		bl_pmsg("[PONG_BL] svc map ae94000 failed\n");
+	} else {
+		const uint32_t hw = bl_rd32(BL_REG_HW_VERSION);
+		const uint32_t ctrl = bl_rd32(BL_REG_CTRL);
+		const uint32_t tpg_before = bl_rd32(BL_REG_TPG_CTRL);
+
+		if (!hw || hw == ~0u || (ctrl & 1u) == 0 || (tpg_before & 1u) != 0) {
+			rc = -1;
+		} else {
+			static const uint8_t gamma[] = { 0x68, 0x19, 0x20, 0x00, 0x14 };
+			const uint8_t dbv_bytes[3] = {
+				BL_DCS_BRIGHTNESS,
+				(uint8_t)(dbv & 0xffu),
+				(uint8_t)((dbv >> 8) & 0x7u),
+			};
+			const uint8_t control[2] = { BL_DCS_CONTROL, 0x20 };
+			uint32_t words[4];
+			unsigned int step = 1;
+
+			rc = 0;
+			if (bl_send(words, bl_pack(gamma, (unsigned)sizeof gamma, words, 4), &step)) {
+				rc = -3;
+			} else if (bl_send(words, bl_pack(dbv_bytes, 3u, words, 4), &step)) {
+				rc = -3;
+			} else if (bl_send(words, bl_pack(control, 2u, words, 4), &step)) {
+				rc = -3;
+			}
+			if (rc) {
+				char line[64];
+				int n = snprintf(line, sizeof(line), "[PONG_BL] svc set dbv=%u rc=%d step=%u\n",
+				    dbv, rc, step);
+
+				if (n > 0) {
+					pong_ramoops_diagnostic_write(line, n < (int)sizeof(line) ? n : (int)sizeof(line) - 1);
+				}
+			}
+		}
+	}
+	__atomic_store_n(&g_bl_busy, 0, __ATOMIC_RELEASE);
+	return rc;
+}
 #endif /* PONG */
