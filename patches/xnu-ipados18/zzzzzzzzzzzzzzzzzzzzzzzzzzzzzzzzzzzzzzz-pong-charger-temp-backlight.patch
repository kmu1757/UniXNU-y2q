+/*
+ * bl: read-only survey of the DSI0 register block the backlight transfer uses (mode 0, zero writes).
+ * `bl N` with N = 10..2047: send the three DCS long-write packets for that DBV once (mode 1).
+ * The reply is pong_backlight_t970.c's single result line; an out-of-range N is rejected there.
+ */
+static void
+cmd_handle_bl(const char *arg)
+{
+	char reply[512];
+	const char *p = arg;
+	bool has_num = false;
+	uint32_t level = 0;
+
+	reply[0] = '\0';
+	while (*p == ' ') {
+		p++;
+	}
+	if (*p >= '0' && *p <= '9') {
+		has_num = true;
+		level = parse_num(&p);
+	}
+	(void)pong_backlight_usb(reply, sizeof(reply), has_num ? 1 : 0, level);
+	send_str(reply[0] ? reply : "bl: no reply\n");
+}
+
+/*
+ * temp: the SoC's temperature sensors, read only. TSENS v2: sensor n at TM + 0xa0 + 4n, bits 11:0 signed tenths
+ * of a degree, bit 21 valid (UniXNU-gts7xlwifi package/CpuFreqProbe.cpp:121-134, same tablet). Stock DTS:
+ * tsens@c222000 TM 0xc263000, sensors 0-15 = aoss-0, cpu-0-0..3, cpuss-0, cpuss-1, cpu-1-0..7, gpuss-0;
+ * tsens@c223000 TM 0xc265000, sensors 0-8 = aoss-1, cwlan, video, ddr, q6-hvx, camera, cmpss, npu, gpuss-1.
+ * The reply lists whole degrees in that order ("-" = no valid reading), the hottest, and the battery's
+ * temperature in tenths when the battery worker has read the fuel gauge.
+ */
+static vm_offset_t tsens_va[2];
+
+static void
+cmd_handle_temp(void)
+{
+	static const vm_offset_t tm[2] = { 0x0c263000UL, 0x0c265000UL };
+	static const unsigned sensors[2] = { 16, 9 };
+	char reply[400];
+	int n = 0, k, hottest = -32768;
+
+	for (unsigned b = 0; b < 2; b++) {
+		if (!tsens_va[b]) {
+			tsens_va[b] = ml_io_map(tm[b], 0x1000);
+		}
+		k = snprintf(reply + n, sizeof(reply) - (size_t)n, "%s", b ? " | t1" : "temp: t0");
+		n += k > 0 && k < (int)sizeof(reply) - n ? k : 0;
+		if (!tsens_va[b]) {
+			k = snprintf(reply + n, sizeof(reply) - (size_t)n, " map-failed");
