+/* Diagnostic pmsg output with synchronous barrier flush */
+static void
+pmsg_log(const char *fmt, ...)
+{
+	char buf[128];
+	va_list ap;
+	va_start(ap, fmt);
+	int n = vsnprintf(buf, sizeof(buf), fmt, ap);
+	va_end(ap);
+	if (n > 0) {
+		pong_ramoops_diagnostic_write(buf, n);
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+}
