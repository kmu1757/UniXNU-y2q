+/* Descriptors: Standard CDC-ACM */
+static const uint8_t dev_desc[18] = {
+	18, 1, 0x00, 0x02,  /* bcdUSB 2.0 */
+	2, 0, 0,            /* Class 2 (CDC), SubClass 0, Protocol 0 */
+	64,                 /* bMaxPacketSize0 = 64 */
+	0x09, 0x12,         /* idVendor = 0x1209 (pid.codes open source) */
+	0x6d, 0x31,         /* idProduct = 0x316d */
+	0x00, 0x01,         /* bcdDevice = 1.00 */
+	1, 2, 3,            /* iManufacturer, iProduct, iSerialNumber */
+	1                   /* bNumConfigurations = 1 */
+};
+
+static uint8_t cfg_desc[67] = {
+	9, 2, 67, 0, 2, 1, 0, 0xc0, 50, /* 67 bytes, 2 ifaces, self-powered, 100mA */
+	/* Interface 0: CDC Communication */
+	9, 4, 0, 0, 1, 2, 2, 1, 0,
+	5, 0x24, 0x00, 0x10, 0x01,       /* Header: CDC 1.10 */
+	5, 0x24, 0x01, 0x00, 0x01,       /* Call Management: Data iface 1 */
+	4, 0x24, 0x02, 0x02,             /* ACM: Support Set/Get Line Coding */
+	5, 0x24, 0x06, 0x00, 0x01,       /* Union: Master if 0, Slave if 1 */
+	7, 5, 0x82, 3, 16, 0, 16,        /* EP2 IN (Interrupt), 16B, 16ms */
+	/* Interface 1: CDC Data */
+	9, 4, 1, 0, 2, 10, 0, 0, 0,      /* if 1, 2 endpoints, Class 10 */
+	7, 5, 0x81, 2, 64, 0, 0,         /* EP1 IN (Bulk) */
+	7, 5, 0x01, 2, 64, 0, 0          /* EP1 OUT (Bulk) */
+};
+
+static unsigned
+string_descriptor(unsigned index, uint8_t *out)
+{
+	if (index == 0) {
+		out[0] = 4; out[1] = 3; out[2] = 0x09; out[3] = 0x04;
+		return 4;
+	}
+	const char *str = (index == 1) ? "UniXNU" :
+	                  (index == 2) ? "SM-T970 iOS Control Port" :
+	                  (index == 3) ? "SM8250-GTS7XLWIFI" : "";
+	unsigned len = (unsigned)strlen(str);
+	if (len > 32) len = 32;
+	out[0] = (uint8_t)(2 + 2 * len);
+	out[1] = 3;
+	for (unsigned i = 0; i < len; i++) {
+		out[2 + 2 * i] = (uint8_t)str[i];
+		out[3 + 2 * i] = 0;
+	}
+	return out[0];
+}
+
+/* Event processing forward declaration */
+static void process_events(void);
+
+/* Bulk IN Transmission Helper (synchronous wait for transfer complete) */
+static void
+send_response(const void *data, unsigned len)
+{
+	if (!ctl_configured || len == 0) return;
+	const uint8_t *src = (const uint8_t *)data;
+	unsigned remaining = len;
+
+	while (remaining > 0) {
+		unsigned chunk = (remaining > 4096) ? 4096 : remaining;
+		for (unsigned w = 0; w < 500 && ctl_tx_active; w++) {
+			process_events();
+			delay_for_interval(1, NSEC_PER_MSEC);
+		}
+		if (ctl_tx_active) {
+			pmsg_log("[PONG_USB] tx busy drop\n");
+			return;
+		}
+		memcpy((void *)(dma_wcomb + OFF_TX_DATA), src, chunk);
+		ctl_tx_active = true;
+		ep_transfer(3, OFF_TX_TRB, OFF_TX_DATA, chunk, DWC3_TRBCTL_NORMAL);
+		src += chunk;
+		remaining -= chunk;
+	}
+	for (unsigned w = 0; w < 500 && ctl_tx_active; w++) {
+		process_events();
+		delay_for_interval(1, NSEC_PER_MSEC);
+	}
+}
+
+/* Process scan callback for 'status' command */
+struct proc_scan_state {
+	bool launchd;
+	bool backboardd;
+	bool SpringBoard;
+};
+
+static int
+proc_scan_callback(proc_t p, void *arg)
+{
+	struct proc_scan_state *st = (struct proc_scan_state *)arg;
+	const char *name = proc_best_name(p);
+	if (name) {
+		if (!st->launchd && strcmp(name, "launchd") == 0) st->launchd = true;
+		if (!st->backboardd && strcmp(name, "backboardd") == 0) st->backboardd = true;
+		if (!st->SpringBoard && strcmp(name, "SpringBoard") == 0) st->SpringBoard = true;
+	}
+	return 0;
+}
+
+/* Stream console ring for 'log' command */
+static void
+stream_console_log(void)
+{
+	if (!ramoops_console_base) {
+		ramoops_console_base = ml_io_map(PONG_RAMOOPS_PHYS_BASE + PONG_RAMOOPS_CONSOLE_OFFSET,
+		    PONG_RAMOOPS_CONSOLE_BYTES);
+	}
+	if (!ramoops_console_base) {
+		send_response("[LOG] error: ml_io_map ramoops failed\n", 37);
+		return;
+	}
+	struct pong_ramoops_header *h = (struct pong_ramoops_header *)ramoops_console_base;
+	if (h->sig != PONG_RAMOOPS_MAGIC) {
+		send_response("[LOG] error: ramoops magic invalid\n", 35);
+		return;
+	}
+	uint32_t capacity = PONG_RAMOOPS_CONSOLE_BYTES - PONG_RAMOOPS_HEADER_BYTES;
+	uint32_t start = h->start;
+	uint32_t size = h->size;
+	if (size > capacity) size = capacity;
+	if (start >= capacity) start = 0;
+
+	if (size == 0) {
+		send_response("[LOG] (ring buffer empty)\n[LOG_END]\n", 36);
+		return;
+	}
+
+	send_response("[LOG_START]\n", 12);
+	volatile uint8_t *data = (volatile uint8_t *)(ramoops_console_base + PONG_RAMOOPS_HEADER_BYTES);
+
+	if (size >= capacity) {
+		/* Ring wrapped: part 1 from start to capacity, part 2 from 0 to start */
+		if (capacity > start) {
+			send_response((const void *)(data + start), capacity - start);
+		}
+		if (start > 0) {
+			send_response((const void *)data, start);
+		}
+	} else {
+		/* Ring not wrapped: 0 to size */
+		send_response((const void *)data, size);
+	}
+	send_response("\n[LOG_END]\n", 11);
+}
+
+/* Thread snapshot walk callback for 'threads' command */
+static int
+pong_threads_snap_cb(proc_t p, void *arg)
+{
+	task_t task = proc_task(p);
+	const char *comm = proc_best_name(p);
+	int pid = proc_pid(p);
+	uint32_t sec = *(uint32_t *)arg;
+	if (task && comm) {
+		pong_dump_task_threads_pmsg(task, comm, pid, sec);
+	}
+	return 0;
+}
+
+static void
+handle_threads(void)
+{
+	uint64_t uptime_ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &uptime_ns);
+	uint32_t sec = (uint32_t)(uptime_ns / 1000000000ULL);
+	pmsg_log("[PONG_USB] cmd: threads (snap sec=%u)\n", sec);
+	proc_iterate(PROC_ALLPROCLIST, pong_threads_snap_cb, &sec, NULL, NULL);
+	send_response("threads: ok (snapshot written to pmsg ramoops)\n", 48);
+}
+
+/* Touch Input Injection Helpers (Stage 3) */
+static void
+handle_tap(unsigned x, unsigned y)
+{
+	if (x >= 2800) x = 2799;
+	if (y >= 1752) y = 1751;
+	uint32_t nx = (x * 65535U) / 2800U;
+	uint32_t ny = (y * 65535U) / 1752U;
+	pong_touch_post(1, 0, nx, ny); /* PONG_TOUCH_DOWN = 1 */
+	delay_for_interval(50, NSEC_PER_MSEC);
+	pong_touch_post(3, 0, nx, ny); /* PONG_TOUCH_UP = 3 */
+	pmsg_log("[PONG_USB] tap (%u,%u) -> (%u,%u)\n", x, y, nx, ny);
+	send_response("tap: ok\n", 8);
+}
+
+static void
+handle_swipe(unsigned x1, unsigned y1, unsigned x2, unsigned y2, unsigned ms)
+{
+	if (x1 >= 2800) x1 = 2799;
+	if (y1 >= 1752) y1 = 1751;
+	if (x2 >= 2800) x2 = 2799;
+	if (y2 >= 1752) y2 = 1751;
+	if (ms < 50) ms = 50;
+	if (ms > 2000) ms = 2000;
+
+	uint32_t sx = (x1 * 65535U) / 2800U;
+	uint32_t sy = (y1 * 65535U) / 1752U;
+	uint32_t ex = (x2 * 65535U) / 2800U;
+	uint32_t ey = (y2 * 65535U) / 1752U;
+
+	unsigned steps = ms / 10;
+	if (steps == 0) steps = 1;
+
+	pong_touch_post(1, 0, sx, sy); /* DOWN */
+	delay_for_interval(10, NSEC_PER_MSEC);
+
+	for (unsigned i = 1; i < steps; i++) {
+		uint32_t cx = (uint32_t)((int32_t)sx + (int32_t)(ex - sx) * (int32_t)i / (int32_t)steps);
+		uint32_t cy = (uint32_t)((int32_t)sy + (int32_t)(ey - sy) * (int32_t)i / (int32_t)steps);
+		pong_touch_post(2, 0, cx, cy); /* MOVE */
+		delay_for_interval(10, NSEC_PER_MSEC);
+	}
+
+	pong_touch_post(3, 0, ex, ey); /* UP */
+	pmsg_log("[PONG_USB] swipe (%u,%u)->(%u,%u) %ums\n", x1, y1, x2, y2, ms);
+	send_response("swipe: ok\n", 10);
+}
+
+/* Raw Framebuffer Screenshot Streaming (Stage 3) */
+static void
+handle_screenshot(void)
+{
+	pmsg_log("[PONG_USB] cmd: screenshot\n");
+	if (!vinfo.v_baseaddr || vinfo.v_width == 0 || vinfo.v_height == 0) {
+		send_response("SCREENSHOT_ERROR: framebuffer not mapped\n", 41);
+		return;
+	}
+	uint32_t w = vinfo.v_width;
+	uint32_t h = vinfo.v_height;
+	uint32_t rowbytes = vinfo.v_rowbytes;
+	uint32_t total_bytes = h * rowbytes;
+
+	char header[64];
+	int n = snprintf(header, sizeof(header), "SCREENSHOT %u %u BGRA %u\n", w, h, total_bytes);
+	if (n > 0) {
+		send_response(header, (unsigned)n);
+	}
+
+	const uint8_t *fb = (const uint8_t *)vinfo.v_baseaddr;
+	uint32_t sent = 0;
+	while (sent < total_bytes && ctl_configured) {
+		uint32_t chunk = total_bytes - sent;
+		if (chunk > 4096) chunk = 4096;
+
+		for (unsigned w_idx = 0; w_idx < 500 && ctl_tx_active; w_idx++) {
+			process_events();
+			delay_for_interval(1, NSEC_PER_MSEC);
+		}
+		if (ctl_tx_active) {
+			pmsg_log("[PONG_USB] screenshot: tx timeout\n");
+			return;
+		}
+
+		memcpy((void *)(dma_wcomb + OFF_TX_DATA), fb + sent, chunk);
+		ctl_tx_active = true;
+		ep_transfer(3, OFF_TX_TRB, OFF_TX_DATA, chunk, DWC3_TRBCTL_NORMAL);
+		sent += chunk;
+	}
+
+	for (unsigned w_idx = 0; w_idx < 500 && ctl_tx_active; w_idx++) {
+		process_events();
+		delay_for_interval(1, NSEC_PER_MSEC);
+	}
+}
+
+/* Command Dispatcher (Stage 3: complete command set) */
+static void
+handle_command(const char *cmd)
+{
+	if (strcmp(cmd, "ping") == 0) {
+		pmsg_log("[PONG_USB] cmd: ping -> pong\n");
+		send_response("pong\n", 5);
+	} else if (strcmp(cmd, "status") == 0) {
+		pmsg_log("[PONG_USB] cmd: status\n");
+		uint64_t uptime_ns = 0;
+		absolutetime_to_nanoseconds(mach_absolute_time(), &uptime_ns);
+		uint32_t uptime_sec = (uint32_t)(uptime_ns / 1000000000ULL);
+		unsigned free_pages = vm_page_free_count;
+		unsigned free_mb = (unsigned)((uint64_t)free_pages * 4096 / (1024 * 1024));
+
+		struct proc_scan_state st = { false, false, false };
+		proc_iterate(PROC_ALLPROCLIST, proc_scan_callback, &st, NULL, NULL);
+
+		char buf[256];
+		int n = snprintf(buf, sizeof(buf),
+		    "STATUS: OK\n"
+		    "uptime: %us\n"
+		    "free_pages: %u (%u MB)\n"
+		    "proc_launchd: %s\n"
+		    "proc_backboardd: %s\n"
+		    "proc_SpringBoard: %s\n",
+		    uptime_sec, free_pages, free_mb,
+		    st.launchd ? "RUNNING" : "NOT_FOUND",
+		    st.backboardd ? "RUNNING" : "NOT_FOUND",
+		    st.SpringBoard ? "RUNNING" : "NOT_FOUND");
+		if (n > 0) {
+			send_response(buf, (unsigned)n);
+		}
+	} else if (strcmp(cmd, "log") == 0) {
+		pmsg_log("[PONG_USB] cmd: log\n");
+		stream_console_log();
+	} else if (strcmp(cmd, "reboot") == 0) {
+		pmsg_log("[PONG_USB] cmd: reboot\n");
+		send_response("reboot: ok\n", 11);
+		delay_for_interval(50, NSEC_PER_MSEC);
+		reboot_kernel(RB_AUTOBOOT, NULL);
+	} else if (strcmp(cmd, "reboot-recovery") == 0 || strcmp(cmd, "reboot_recovery") == 0) {
+		pmsg_log("[PONG_USB] cmd: reboot-recovery\n");
+		if (!imem_base) {
+			imem_base = ml_io_map(IMEM_PHYS_BASE, IMEM_SIZE);
+		}
+		if (imem_base) {
+			*(volatile uint32_t *)(imem_base + IMEM_RECOVERY_OFFSET) = IMEM_MAGIC_RECOVERY;
+			__asm__ volatile("dsb sy" ::: "memory");
+			pmsg_log("[PONG_USB] imem: 0x146bf65c = 0x77665502 latched\n");
+		}
+		send_response("reboot-recovery: ok (rebooting to TWRP)\n", 39);
+		delay_for_interval(50, NSEC_PER_MSEC);
+		reboot_kernel(RB_QUICK, "reboot recovery");
+	} else if (strcmp(cmd, "screenshot") == 0) {
+		handle_screenshot();
+	} else if (strncmp(cmd, "tap ", 4) == 0) {
+		const char *p = cmd + 4;
+		unsigned x = parse_uint(&p);
+		unsigned y = parse_uint(&p);
+		handle_tap(x, y);
+	} else if (strncmp(cmd, "swipe ", 6) == 0) {
+		const char *p = cmd + 6;
+		unsigned x1 = parse_uint(&p);
+		unsigned y1 = parse_uint(&p);
+		unsigned x2 = parse_uint(&p);
+		unsigned y2 = parse_uint(&p);
+		unsigned ms = parse_uint(&p);
+		handle_swipe(x1, y1, x2, y2, ms);
+	} else if (strcmp(cmd, "threads") == 0) {
+		handle_threads();
+	} else {
+		pmsg_log("[PONG_USB] unknown cmd: %s\n", cmd);
+		send_response("ERR: unknown command\n", 21);
+	}
+}
+
+static void
+feed_input(const uint8_t *data, unsigned size)
+{
+	for (unsigned i = 0; i < size; i++) {
+		char c = (char)data[i];
+		if (c == '\r' || c == '\n') {
+			if (cmd_len > 0) {
+				cmd_buf[cmd_len] = '\0';
+				handle_command(cmd_buf);
+				cmd_len = 0;
+			}
+		} else if (c >= 32 && c <= 126 && cmd_len < sizeof(cmd_buf) - 1) {
+			cmd_buf[cmd_len++] = c;
+		}
+	}
+}
+
+/* Control Pipe Request Handler */
+static void
+handle_setup(void)
+{
+	volatile uint8_t *in = (volatile uint8_t *)(dma_wcomb + OFF_EP_DATA);
+	uint8_t type = in[0];
+	uint8_t req = in[1];
+	uint16_t val = (uint16_t)(in[2] | (in[3] << 8));
+	uint16_t idx = (uint16_t)(in[4] | (in[5] << 8));
+	uint16_t len = (uint16_t)(in[6] | (in[7] << 8));
+	ctl_control_bytes = len;
+	ctl_status_dep = (type & 0x80) ? 0 : 1;
+
+	uint8_t *out = (uint8_t *)(dma_wcomb + OFF_EP_DATA + 0x100);
+	unsigned resp_len = 0;
+
+	if ((type & 0x60) == 0 && req == 6 && (type & 0x80)) {
+		/* GET_DESCRIPTOR */
+		switch (val >> 8) {
+		case 1: /* Device */
+			memcpy(out, dev_desc, sizeof(dev_desc));
+			resp_len = sizeof(dev_desc);
+			break;
+		case 2: /* Configuration */
+			memcpy(out, cfg_desc, sizeof(cfg_desc));
+			resp_len = sizeof(cfg_desc);
+			break;
+		case 3: /* String */
+			resp_len = string_descriptor(val & 0xff, out);
+			break;
+		case 6: { /* Device Qualifier */
+			uint8_t q[10] = {10, 6, 0x00, 0x02, dev_desc[4], dev_desc[5], dev_desc[6], 64, 1, 0};
+			memcpy(out, q, 10);
+			resp_len = 10;
+			break;
+		}
+		default:
+			stall_control();
+			return;
+		}
+	} else if (type == 0 && req == 5 && !len && val < 128) {
+		/* SET_ADDRESS */
+		core_w(DWC3_DCFG, (core_r(DWC3_DCFG) & ~(127u << 3)) | ((uint32_t)val << 3));
+		status_stage(1);
+		return;
+	} else if (type == 0 && req == 9 && !len && val <= 1) {
+		/* SET_CONFIGURATION */
+		if (ctl_configured && val == 1) {
+			status_stage(1);
+			return;
+		}
+		ctl_configured = (val != 0);
+		if (ctl_configured) {
+			if (!ep_config(2, 2, ctl_packet_size) ||
+			    !ep_config(3, 2, ctl_packet_size) ||
+			    !ep_config(5, 3, 16)) {
+				stall_control();
+				return;
+			}
+			core_w(DWC3_DALEPENA, core_r(DWC3_DALEPENA) | (1u << 2) | (1u << 3) | (1u << 5));
+			pmsg_log("[PONG_USB] configured: speed=%s packet=%u\n",
+			    (ctl_packet_size == 512) ? "HS" : "FS", ctl_packet_size);
+		} else {
+			ctl_dtr = false;
+		}
+		status_stage(1);
+		return;
+	} else if (type == 0x02 && req == 1 && !len) {
+		/* CLEAR_FEATURE (ENDPOINT_HALT) */
+		unsigned ep = ((idx & 15) << 1) | ((idx >> 7) & 1);
+		if (ep == 2 || ep == 3 || ep == 5) {
+			ep_cmd(ep, DWC3_DEPCMD_CLEARSTALL, 0, 0, 0);
+		}
+		status_stage(1);
+		return;
+	} else if (type == 0x80 && req == 0 && len == 2) {
+		/* GET_STATUS (DEVICE) */
+		out[0] = 1; out[1] = 0; /* Self-powered */
+		resp_len = 2;
+	} else if (type == 0x81 && req == 0 && len == 2) {
+		/* GET_STATUS (INTERFACE) */
+		out[0] = 0; out[1] = 0;
+		resp_len = 2;
+	} else if (type == 0x82 && req == 0 && len == 2) {
+		/* GET_STATUS (ENDPOINT) */
+		out[0] = 0; out[1] = 0;
+		resp_len = 2;
+	} else if (type == 0xa1 && req == 0x21 && len == 7) {
+		/* CDC: GET_LINE_CODING */
+		uint8_t coding[7] = {0x00, 0xc2, 0x01, 0x00, 0x00, 0x00, 0x08}; /* 115200 8N1 */
+		memcpy(out, coding, 7);
+		resp_len = 7;
+	} else if (type == 0x21 && req == 0x20 && len == 7) {
+		/* CDC: SET_LINE_CODING */
+		control_data(0, 7);
+		return;
+	} else if (type == 0x21 && req == 0x22 && !len) {
+		/* CDC: SET_CONTROL_LINE_STATE */
+		ctl_dtr = (val & 1) != 0;
+		cmd_len = 0;
+		status_stage(1);
+		if (ctl_configured && ctl_dtr && !ctl_rx_active) {
+			ctl_rx_active = ep_transfer(2, OFF_RX_TRB, OFF_RX_DATA, ctl_packet_size, DWC3_TRBCTL_NORMAL);
+		}
+		return;
+	} else if (type == 0x21 && req == 0x23 && !len) {
+		/* CDC: SEND_BREAK */
+		status_stage(1);
+		return;
+	} else {
+		stall_control();
+		return;
+	}
+
+	if (resp_len > len) resp_len = len;
+	if (len > 0) control_data(1, resp_len);
+	else status_stage(ctl_status_dep);
+}
+
+/* Endpoint Event Handler */
+static void
+handle_ep_event(uint32_t event)
+{
+	unsigned ep = (event >> 1) & 31;
+	unsigned kind = (event >> 6) & 15;
+	unsigned status = (event >> 12) & 15;
+
+	if (ep >= 2) {
+		if (kind == DWC3_DEPEVT_XFERCOMPLETE) {
+			if (ep == 3) {
+				ctl_tx_active = false;
+			}
+			if (ep == 2 && ctl_rx_active) {
+				__asm__ volatile("dsb sy" ::: "memory");
+				uint32_t residual = *(volatile uint32_t *)(dma_wcomb + OFF_RX_TRB + 8) & 0xffffff;
+				if (!(status & 1) && residual <= ctl_packet_size) {
+					unsigned rcvd = ctl_packet_size - residual;
+					if (rcvd > 0) {
+						feed_input((const uint8_t *)(dma_wcomb + OFF_RX_DATA), rcvd);
+					}
+				}
+				ctl_rx_active = false;
+				if (ctl_configured && ctl_dtr) {
+					ctl_rx_active = ep_transfer(2, OFF_RX_TRB, OFF_RX_DATA, ctl_packet_size, DWC3_TRBCTL_NORMAL);
+				}
+			}
+		}
+		return;
+	}
+
+	/* Control EP0/EP1 */
+	if (kind == DWC3_DEPEVT_XFERNOTREADY && ctl_stage == 2 && status == 1) {
+		status_stage(ep);
+		return;
+	}
+	if (kind != DWC3_DEPEVT_XFERCOMPLETE) return;
+
+	if (ctl_stage == 0) {
+		handle_setup();
+		return;
+	}
+	if (ctl_stage == 1) {
+		ctl_stage = 2;
+		return;
+	}
+	if (ctl_stage == 3) {
+		arm_setup();
+		return;
+	}
+}
+
+/* Event Ring Processing */
+static void
+process_events(void)
+{
+	unsigned count = core_r(DWC3_GEVNTCOUNT(0)) & 0xfffc;
+	if (count > 4096) {
+		pmsg_log("[PONG_USB] event ring overflow\n");
+		return;
+	}
+	for (unsigned done = 0; done < count; done += 4) {
+		uint32_t event = *(volatile uint32_t *)(dma_wcomb + OFF_EVT_RING + ctl_event_offset);
+		ctl_event_offset = (ctl_event_offset + 4) & 4095;
+		if (!(event & 1)) {
+			handle_ep_event(event);
+		} else {
+			unsigned dev_evt = (event >> 8) & 15;
+			switch (dev_evt) {
+			case 0: /* Disconnect */
+				ctl_configured = false;
+				ctl_dtr = false;
+				break;
+			case 1: /* USB Reset */
+				pmsg_log("[PONG_USB] usb_reset\n");
+				core_w(DWC3_DCFG, core_r(DWC3_DCFG) & ~(127u << 3));
+				reset_endpoints();
+				break;
+			case 2: { /* Connection speed done */
+				uint32_t spd = DWC3_DSTS_CONNECTSPD(core_r(DWC3_DSTS));
+				ctl_packet_size = (spd == 0) ? 512 : 64;
+				cfg_desc[57] = cfg_desc[64] = (uint8_t)ctl_packet_size;
+				cfg_desc[58] = cfg_desc[65] = (uint8_t)(ctl_packet_size >> 8);
+				break;
+			}
+			default:
+				break;
+			}
+		}
+	}
+	if (count > 0) {
+		core_w(DWC3_GEVNTCOUNT(0), count);
+	}
+}
+
+/* Worker Thread */
+static void
+pong_usb_ctl_worker(__unused void *param, __unused wait_result_t wr)
+{
+	pmsg_log("[PONG_USB] ready: listening on CDC-ACM\n");
+	while (1) {
+		process_events();
+		if (ctl_configured && ctl_dtr && !ctl_rx_active) {
+			ctl_rx_active = ep_transfer(2, OFF_RX_TRB, OFF_RX_DATA, ctl_packet_size, DWC3_TRBCTL_NORMAL);
+		}
+		delay_for_interval(2, NSEC_PER_MSEC);
+	}
+}
+
+/* Public Initialization Routine */
+void
+pong_usb_ctl_init(void)
+{
+	uint32_t enabled = 0;
+	if (!PE_parse_boot_argn("pong_usb_ctl", &enabled, sizeof(enabled)) || enabled != 1) {
+		return;
+	}
+	ctl_enabled = true;
+	pmsg_log("[PONG_USB] init: starting SM-T970 USB CDC-ACM control channel\n");
+
+	/* 1. Map TLMM and route MAX77705 MUIC */
+	tlmm_base = ml_io_map(TLMM_NORTH_PHYS, TLMM_SIZE);
+	if (!tlmm_base) {
+		pmsg_log("[PONG_USB] fail: ml_io_map(TLMM_NORTH)\n");
+		return;
+	}
+	cfg_sda = rd(GPIO_CFG(tlmm_base, PIN_SDA)) & ~(CFG_FUNCTION | CFG_OUTPUT_ENABLE);
+	cfg_scl = rd(GPIO_CFG(tlmm_base, PIN_SCL)) & ~(CFG_FUNCTION | CFG_OUTPUT_ENABLE);
+	wr(GPIO_CFG(tlmm_base, PIN_SDA), cfg_sda);
+	wr(GPIO_CFG(tlmm_base, PIN_SCL), cfg_scl);
+	spin_us(100);
+
+	if (pong_muic_route()) {
+		pmsg_log("[PONG_USB] muic: i2c slave 0x25 route ok\n");
+	} else {
+		pmsg_log("[PONG_USB] muic: warning route no ack\n");
+	}
+
+	/* 2. Configure SMMU SID 0 Bypass */
+	smmu_base = ml_io_map(APPS_SMMU_PHYS, APPS_SMMU_SIZE);
+	if (smmu_base) {
+		pong_smmu_setup_sid0_bypass(smmu_base);
+	}
+
+	/* 3. Allocate DMA contiguous buffer (32 KiB) */
+	dma_phys = 0;
+	dma_virt = IOMallocContiguous(USB_DMA_BYTES, 4096, &dma_phys);
+	if (!dma_virt || !dma_phys) {
+		pmsg_log("[PONG_USB] fail: IOMallocContiguous 32K\n");
+		return;
+	}
+	dma_wcomb = ml_io_map_wcomb((vm_offset_t)dma_phys, USB_DMA_BYTES);
+	if (!dma_wcomb) {
+		pmsg_log("[PONG_USB] fail: ml_io_map_wcomb DMA\n");
+		return;
+	}
+	memset((void *)dma_wcomb, 0, USB_DMA_BYTES);
+	__asm__ volatile("dsb sy" ::: "memory");
+	pmsg_log("[PONG_USB] dma: allocated phys=0x%llx\n", (uint64_t)dma_phys);
+
+	/* 4. Map DWC3 Core and QSCRATCH */
+	core_base = ml_io_map(DWC3_CORE_PHYS, DWC3_CORE_SIZE);
+	qscratch_base = ml_io_map(QSCRATCH_PHYS, QSCRATCH_SIZE);
+	if (!core_base || !qscratch_base) {
+		pmsg_log("[PONG_USB] fail: ml_io_map core/qscratch\n");
+		return;
+	}
+
+	uint32_t id = core_r(DWC3_GSNPSID) & 0xffff0000;
+	pmsg_log("[PONG_USB] dwc3: core id=0x%08x\n", core_r(DWC3_GSNPSID));
+	if (id != 0x55330000 && id != 0x55340000 && id != 0x33310000) {
+		pmsg_log("[PONG_USB] fail: unexpected core id\n");
+		return;
+	}
+
+	/* Stop controller */
+	core_w(DWC3_DCTL, core_r(DWC3_DCTL) & ~DWC3_DCTL_RUN_STOP);
+	for (unsigned i = 0; i < 250; i++) {
+		if (core_r(DWC3_DSTS) & DWC3_DSTS_DEVCTRLHLT) break;
+		delay_for_interval(1, NSEC_PER_MSEC);
+	}
+	core_w(DWC3_DEVTEN, 0);
+	core_w(DWC3_DALEPENA, 0);
+
+	/* Soft reset core */
+	core_w(DWC3_DCTL, core_r(DWC3_DCTL) | DWC3_DCTL_CSFTRST);
+	for (unsigned i = 0; i < 250; i++) {
+		if (!(core_r(DWC3_DCTL) & DWC3_DCTL_CSFTRST)) break;
+		delay_for_interval(1, NSEC_PER_MSEC);
+	}
+
+	/* Setup PHY and DCFG */
+	core_w(DWC3_GUSB2PHYCFG(0), core_r(DWC3_GUSB2PHYCFG(0)) & ~(DWC3_GUSB2PHYCFG_SUSPHY | DWC3_GUSB2PHYCFG_ENBLSLPM));
+	core_w(DWC3_DCFG, (core_r(DWC3_DCFG) & ~0x3ffu) | 0);
+
+	/* Event Ring */
+	core_w(DWC3_GEVNTADRLO(0), (uint32_t)dma_phys);
+	core_w(DWC3_GEVNTADRHI(0), (uint32_t)(dma_phys >> 32));
+	core_w(DWC3_GEVNTSIZ(0), 4096u | (1u << 31));
+	core_w(DWC3_GEVNTCOUNT(0), 0);
+	ctl_event_offset = 0;
+
+	/* Force Device Mode and disable clock gating */
+	core_w(DWC3_GCTL, (core_r(DWC3_GCTL) & ~(3u << 12)) | (2u << 12) | DWC3_GCTL_DSBLCLKGTNG);
+
+	/* Reset Endpoints and arm EP0 SETUP */
+	reset_endpoints();
+
+	/* Enable Events */
+	core_w(DWC3_DEVTEN, 0x0f);
+
+	/* 5. QSCRATCH VBUS Override */
+	qs_w(0x30, qs_r(0x30) | (1u << 24));
+	qs_w(0x10, qs_r(0x10) | (1u << 20) | (1u << 28));
+	if ((qs_r(0x10) & ((1u << 20) | (1u << 28))) == ((1u << 20) | (1u << 28))) {
+		pmsg_log("[PONG_USB] qscratch: vbus override latched\n");
+	}
+
+	/* Start Controller */
+	core_w(DWC3_DCTL, core_r(DWC3_DCTL) | DWC3_DCTL_RUN_STOP);
+
+	/* Start worker thread */
+	thread_t t = NULL;
+	if (kernel_thread_start(pong_usb_ctl_worker, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	} else {
+		pmsg_log("[PONG_USB] fail: kernel_thread_start\n");
+	}
+}
