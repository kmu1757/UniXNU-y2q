+/* TLMM North Tile: GPIO 28 (SDA), GPIO 29 (SCL) */
+#define TLMM_NORTH_PHYS         0x0f900000UL
+#define TLMM_SIZE               0x100000UL
+#define PIN_SDA                 28
+#define PIN_SCL                 29
+#define GPIO_CFG(tlmm, n)       ((tlmm) + 0x1000UL * (n))
+#define GPIO_IO(tlmm, n)        ((tlmm) + 0x1000UL * (n) + 4)
+#define CFG_FUNCTION            (0xfu << 2)
+#define CFG_OUTPUT_ENABLE       (1u << 9)
+#define HALF_BIT_US             5
+#define STRETCH_US              1000
+#define MUIC_I2C_ADDR           0x25
+
+/* SMMUv2 Base */
+#define APPS_SMMU_PHYS          0x15000000UL
+#define APPS_SMMU_SIZE          0x100000UL
+
+/* DWC3 and QSCRATCH MMIO Bases */
+#define DWC3_CORE_PHYS          0x0a600000UL
+#define DWC3_CORE_SIZE          0x10000UL
+#define QSCRATCH_PHYS           0x0a6f8800UL
+#define QSCRATCH_SIZE           0x400UL
+
+/* IMEM Reboot Target Base */
+#define IMEM_PHYS_BASE          0x146bf000UL
+#define IMEM_SIZE               0x1000UL
+#define IMEM_RECOVERY_OFFSET    0x65c
+#define IMEM_MAGIC_RECOVERY     0x77665502U
+
+/* Ramoops Console Ring Buffer */
+#define PONG_RAMOOPS_PHYS_BASE      0x9FA00000ULL
+#define PONG_RAMOOPS_CONSOLE_OFFSET 0x00040000U
+#define PONG_RAMOOPS_CONSOLE_BYTES  0x00040000U
+#define PONG_RAMOOPS_MAGIC          0x43474244U
+#define PONG_RAMOOPS_HEADER_BYTES   12U
+
+struct pong_ramoops_header {
+	volatile uint32_t sig;
+	volatile uint32_t start;
+	volatile uint32_t size;
+};
+
+/* DWC3 Register Offsets */
+#define DWC3_GCTL               0xC110
+#define DWC3_GSNPSID            0xC120
+#define DWC3_GUSB2PHYCFG(n)     (0xC200 + ((n) * 4))
+#define DWC3_GEVNTADRLO(n)      (0xC400 + ((n) * 0x10))
+#define DWC3_GEVNTADRHI(n)      (0xC404 + ((n) * 0x10))
+#define DWC3_GEVNTSIZ(n)        (0xC408 + ((n) * 0x10))
+#define DWC3_GEVNTCOUNT(n)      (0xC40C + ((n) * 0x10))
+#define DWC3_DCFG               0xC700
+#define DWC3_DCTL               0xC704
+#define DWC3_DEVTEN             0xC708
+#define DWC3_DSTS               0xC70C
+#define DWC3_DALEPENA           0xC720
+#define DWC3_DEPCMDPAR2(n)      (0xC800 + ((n) * 0x10))
+#define DWC3_DEPCMDPAR1(n)      (0xC804 + ((n) * 0x10))
+#define DWC3_DEPCMDPAR0(n)      (0xC808 + ((n) * 0x10))
+#define DWC3_DEPCMD(n)          (0xC80C + ((n) * 0x10))
+
+#define DWC3_DCTL_RUN_STOP      (1u << 31)
+#define DWC3_DCTL_CSFTRST       (1u << 30)
+#define DWC3_DSTS_DEVCTRLHLT    (1u << 22)
+#define DWC3_DSTS_CONNECTSPD(n) ((n) & 7u)
+#define DWC3_GCTL_DSBLCLKGTNG   (1u << 0)
+#define DWC3_GUSB2PHYCFG_SUSPHY (1u << 6)
+#define DWC3_GUSB2PHYCFG_ENBLSLPM (1u << 8)
+
+#define DWC3_DEPCMD_DEPSTARTCFG         (9u | (1u << 10))
+#define DWC3_DEPCMD_SETEPCONFIG         (1u | (1u << 10))
+#define DWC3_DEPCMD_SETTRANSFRESOURCE   (2u | (1u << 10))
+#define DWC3_DEPCMD_STARTTRANSFER       (6u | (1u << 10))
+#define DWC3_DEPCMD_CLEARSTALL          (5u | (1u << 10))
+#define DWC3_DEPCMD_SETSTALL            (4u | (1u << 10))
+#define DWC3_DEPCMD_CMDACT              (1u << 10)
+#define DWC3_DEPCMD_STATUS(x)           (((x) >> 12) & 0x0Fu)
+
+#define DWC3_DEPCFG_EP_TYPE(x)          ((x) << 1)
+#define DWC3_DEPCFG_MAX_PACKET_SIZE(x)  ((x) << 3)
+#define DWC3_DEPCFG_FIFO_NUMBER(x)      ((x) << 17)
+#define DWC3_DEPCFG_EP_NUMBER(x)        ((x) << 1)
+#define DWC3_DEPCFG_XFER_COMPLETE_EN    (1u << 8)
+#define DWC3_DEPCFG_XFER_NOT_READY_EN   (1u << 10)
+
+#define DWC3_TRBCTL_NORMAL              1u
+#define DWC3_TRBCTL_CONTROL_SETUP       2u
+#define DWC3_TRBCTL_CONTROL_STATUS2     3u
+#define DWC3_TRBCTL_CONTROL_STATUS3     4u
+#define DWC3_TRBCTL_CONTROL_DATA        5u
+
+#define DWC3_TRB_CTRL_HWO               (1u << 0)
+#define DWC3_TRB_CTRL_LST               (1u << 1)
+#define DWC3_TRB_CTRL_IOC               (1u << 11)
+
+#define DWC3_DEPEVT_XFERCOMPLETE        1u
+#define DWC3_DEPEVT_XFERNOTREADY        3u
+
+/* DMA Buffer Offsets inside 32 KiB Allocation */
+#define USB_DMA_BYTES           32768
+#define OFF_EVT_RING            0x0000
+#define OFF_EP_TRB              0x1000
+#define OFF_EP_DATA             0x1100
+#define OFF_RX_TRB              0x2000
+#define OFF_RX_DATA             0x2100
+#define OFF_TX_TRB              0x3000
+#define OFF_TX_DATA             0x3100
