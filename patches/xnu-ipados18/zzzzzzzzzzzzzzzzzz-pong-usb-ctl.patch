+/* Low-level MMIO helpers */
+static inline uint32_t rd(vm_offset_t a) { return *(volatile uint32_t *)a; }
+static inline void wr(vm_offset_t a, uint32_t v) { *(volatile uint32_t *)a = v; }
+
+static inline uint32_t core_r(unsigned o) {
+	uint32_t v = *(volatile uint32_t *)(core_base + o);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+static inline void core_w(unsigned o, uint32_t v) {
+	*(volatile uint32_t *)(core_base + o) = v;
+	__asm__ volatile("dsb oshst" ::: "memory");
+}
+static inline uint32_t qs_r(unsigned o) {
+	uint32_t v = *(volatile uint32_t *)(qscratch_base + o);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+static inline void qs_w(unsigned o, uint32_t v) {
+	*(volatile uint32_t *)(qscratch_base + o) = v;
+	__asm__ volatile("dsb oshst" ::: "memory");
+}
+
+/* Microsecond spin loop using mach_absolute_time */
+static void
+spin_us(uint32_t us)
+{
+	uint64_t interval = 0, deadline = 0;
+	nanoseconds_to_absolutetime((uint64_t)us * NSEC_PER_USEC, &interval);
+	deadline = mach_absolute_time() + interval;
+	while (mach_absolute_time() < deadline) {
+	}
+}
+
+/* Simple unsigned integer parser for command arguments */
+static unsigned
+parse_uint(const char **p)
+{
+	while (**p == ' ') (*p)++;
+	unsigned val = 0;
+	while (**p >= '0' && **p <= '9') {
+		val = val * 10 + (**p - '0');
+		(*p)++;
+	}
+	return val;
+}
+
+/* Open-drain bit-bang I2C */
+static void
+line(unsigned pin, uint32_t cfg, bool high)
+{
+	if (high) {
+		wr(GPIO_CFG(tlmm_base, pin), cfg & ~CFG_OUTPUT_ENABLE);
+	} else {
+		wr(GPIO_IO(tlmm_base, pin), 0);
+		wr(GPIO_CFG(tlmm_base, pin), cfg | CFG_OUTPUT_ENABLE);
+	}
+	spin_us(HALF_BIT_US);
+}
+
+static bool
+scl_release(void)
+{
+	line(PIN_SCL, cfg_scl, true);
+	for (unsigned waited = 0; !(rd(GPIO_IO(tlmm_base, PIN_SCL)) & 1); waited++) {
+		if (waited >= STRETCH_US) {
+			return false;
+		}
+		spin_us(1);
+	}
+	return true;
+}
+
+static void sda(bool high) { line(PIN_SDA, cfg_sda, high); }
+static void scl_low(void) { line(PIN_SCL, cfg_scl, false); }
+
+static void
+bus_start(void)
+{
+	sda(true);
+	scl_release();
+	sda(false);
+	scl_low();
+}
+
+static void
+bus_stop(void)
+{
+	sda(false);
+	scl_release();
+	sda(true);
+}
+
+static bool
+bus_recover(void)
+{
+	unsigned pulses = 0;
+	if ((rd(GPIO_IO(tlmm_base, PIN_SDA)) & 1) && (rd(GPIO_IO(tlmm_base, PIN_SCL)) & 1)) {
+		return true;
+	}
+	if (!(rd(GPIO_IO(tlmm_base, PIN_SCL)) & 1)) {
+		return false;
+	}
+	while (!(rd(GPIO_IO(tlmm_base, PIN_SDA)) & 1) && pulses < 9) {
+		scl_low();
+		scl_release();
+		pulses++;
+	}
+	bus_stop();
+	return (rd(GPIO_IO(tlmm_base, PIN_SDA)) & 1) && (rd(GPIO_IO(tlmm_base, PIN_SCL)) & 1);
+}
+
+static bool
+bus_put(uint8_t byte)
+{
+	for (int bit = 7; bit >= 0; bit--) {
+		sda((byte >> bit) & 1);
+		if (!scl_release()) return false;
+		scl_low();
+	}
+	sda(true);
+	if (!scl_release()) return false;
+	bool ack = !(rd(GPIO_IO(tlmm_base, PIN_SDA)) & 1);
+	scl_low();
+	return ack;
+}
+
+static bool
+muic_write_reg(uint8_t slave_addr, uint8_t reg, const uint8_t *val, unsigned len)
+{
+	if (!bus_recover()) return false;
+	bus_start();
+	if (!bus_put(slave_addr << 1)) { bus_stop(); return false; }
+	if (!bus_put(reg)) { bus_stop(); return false; }
+	for (unsigned i = 0; i < len; i++) {
+		if (!bus_put(val[i])) { bus_stop(); return false; }
+	}
+	bus_stop();
+	return true;
+}
+
+static bool
+pong_muic_route(void)
+{
+	uint8_t cmd1[2] = {0x06, 0x09};
+	uint8_t cmd2[1] = {0x00};
+	bool ok1 = muic_write_reg(MUIC_I2C_ADDR, 0x21, cmd1, 2);
+	bool ok2 = muic_write_reg(MUIC_I2C_ADDR, 0x41, cmd2, 1);
+	return ok1 && ok2;
+}
+
+/* GCC Clocks and Power Domain Pre-Check (SM8250 / SM-T970) */
+static bool
+pong_usb_check_clocks_and_power(void)
+{
+	vm_offset_t gcc_base = ml_io_map(GCC_PHYS_BASE, GCC_MAP_SIZE);
+	if (!gcc_base) {
+		pmsg_log("[PONG_USB] gcc: ml_io_map failed (skip check)\n");
+		return true;
+	}
+	uint32_t gdscr = *(volatile uint32_t *)(gcc_base + GCC_USB30_PRIM_GDSCR);
+	uint32_t master_cbcr = *(volatile uint32_t *)(gcc_base + GCC_USB30_PRIM_MASTER_CBCR);
+	uint32_t mock_cbcr = *(volatile uint32_t *)(gcc_base + GCC_USB30_PRIM_MOCK_CBCR);
+	uint32_t sleep_cbcr = *(volatile uint32_t *)(gcc_base + GCC_USB30_PRIM_SLEEP_CBCR);
+
+	pmsg_log("[PONG_USB] gcc: gdscr=0x%08x master=0x%08x mock=0x%08x sleep=0x%08x\n",
+	    gdscr, master_cbcr, mock_cbcr, sleep_cbcr);
+
+	/* Check GDSC power status (bit 31: PWR_ON) */
+	if (!(gdscr & (1u << 31))) {
+		pmsg_log("[PONG_USB] fail: USB30_PRIM_GDSC is not powered on (0x%08x)\n", gdscr);
+		return false;
+	}
+
+	/* Check Master clock status (bit 31: CLK_OFF, bit 0: ENABLE) */
+	if ((master_cbcr & (1u << 31)) || !(master_cbcr & 1u)) {
+		pmsg_log("[PONG_USB] fail: USB30 master clk is not active (0x%08x)\n", master_cbcr);
+		return false;
+	}
+
+	return true;
+}
+
+/* SMMUv2 SID 0 Check (Read-Only)
+ * On Qualcomm SM8250, Apps SMMU global register space (0x15000000)
+ * is owned by TrustZone / Hypervisor. Non-secure EL1 must NOT write
+ * to global SMR/S2CR registers (triggers SError / XPU reset).
+ * UEFI already configured SID 0 bypass during bootloader handoff.
+ */
+static bool
+pong_smmu_check_sid0_bypass(vm_offset_t smmu)
+{
+	uint32_t idr0 = *(volatile uint32_t *)(smmu + 0x20);
+	unsigned count = idr0 & 0xff;
+	if (count > 128) count = 128;
+	int sid0_slot = -1;
+
+	for (unsigned i = 0; i < count; i++) {
+		uint32_t smr = *(volatile uint32_t *)(smmu + 0x800 + 4 * i);
+		if (!(smr & 0x80000000U)) continue;
+		if ((smr & 0x7fff) == 0) {
+			sid0_slot = (int)i;
+			uint32_t s2cr = *(volatile uint32_t *)(smmu + 0xc00 + 4 * i);
+			pmsg_log("[PONG_USB] smmu: SID 0 found slot=%d smr=0x%08x s2cr=0x%08x (ro)\n",
+			    sid0_slot, smr, s2cr);
+			return true;
+		}
+	}
+
+	pmsg_log("[PONG_USB] smmu: SID 0 not found in %u slots (continuing)\n", count);
+	return false;
+}
+
+/* DWC3 Endpoint Commands and Transfers */
+static bool
+ep_cmd(unsigned ep, unsigned command, uint32_t p0, uint32_t p1, uint32_t p2)
+{
+	core_w(DWC3_DEPCMDPAR0(ep), p0);
+	core_w(DWC3_DEPCMDPAR1(ep), p1);
+	core_w(DWC3_DEPCMDPAR2(ep), p2);
+	core_w(DWC3_DEPCMD(ep), command | DWC3_DEPCMD_CMDACT);
+	for (unsigned i = 0; i < 1000; i++) {
+		uint32_t v = core_r(DWC3_DEPCMD(ep));
+		if (!(v & DWC3_DEPCMD_CMDACT)) {
+			return (DWC3_DEPCMD_STATUS(v) == 0);
+		}
+		spin_us(1);
+	}
+	return false;
+}
+
+static bool
+ep_transfer(unsigned ep, unsigned trb_off, unsigned buf_off, unsigned size, unsigned type)
+{
+	volatile uint32_t *p = (volatile uint32_t *)(dma_wcomb + trb_off);
+	uint64_t addr = dma_phys + buf_off;
+	p[0] = (uint32_t)addr;
+	p[1] = (uint32_t)(addr >> 32);
+	p[2] = size;
+	__asm__ volatile("dsb sy" ::: "memory");
+	p[3] = type | DWC3_TRB_CTRL_LST | DWC3_TRB_CTRL_IOC | DWC3_TRB_CTRL_ISP_IMI | DWC3_TRB_CTRL_HWO;
+	__asm__ volatile("dsb sy" ::: "memory");
+	uint64_t trb_addr = dma_phys + trb_off;
+	return ep_cmd(ep, DWC3_DEPCMD_STARTTRANSFER, (uint32_t)(trb_addr >> 32), (uint32_t)trb_addr, 0);
+}
+
+static bool
+ep_config(unsigned ep, unsigned type, unsigned max_pkt)
+{
+	unsigned p0 = DWC3_DEPCFG_EP_TYPE(type) | DWC3_DEPCFG_MAX_PACKET_SIZE(max_pkt);
+	if (ep & 1) p0 |= DWC3_DEPCFG_FIFO_NUMBER(ep >> 1);
+	unsigned p1 = DWC3_DEPCFG_EP_NUMBER(ep) | DWC3_DEPCFG_XFER_COMPLETE_EN | DWC3_DEPCFG_XFER_NOT_READY_EN;
+	bool ok = ep_cmd(ep, DWC3_DEPCMD_SETEPCONFIG, p0, p1, 0);
+	ep_cmd(ep, DWC3_DEPCMD_SETTRANSFRESOURCE, 1, 0, 0);
+	return ok;
+}
+
+static void
+arm_setup(void)
+{
+	ctl_stage = 0;
+	ep_transfer(0, OFF_EP_TRB, OFF_EP_DATA, 8, DWC3_TRBCTL_CONTROL_SETUP);
+}
+
+static void
+stall_control(void)
+{
+	ep_cmd(0, DWC3_DEPCMD_SETSTALL, 0, 0, 0);
+	arm_setup();
+}
+
+static void
+status_stage(unsigned ep)
+{
+	ctl_stage = 3;
+	ep_transfer(ep, OFF_EP_TRB, OFF_EP_DATA, 0,
+	    ctl_control_bytes ? DWC3_TRBCTL_CONTROL_STATUS3 : DWC3_TRBCTL_CONTROL_STATUS2);
+}
+
+static void
+control_data(unsigned ep, unsigned length)
+{
+	ctl_stage = 1;
+	ep_transfer(ep, OFF_EP_TRB, OFF_EP_DATA + 0x100, ep ? length : 64, DWC3_TRBCTL_CONTROL_DATA);
+}
+
+/* Send CDC ACM SERIAL_STATE notification (Interrupt IN EP5) */
+static void
+send_serial_state(void)
+{
+	if (!ctl_configured) return;
+	uint8_t *p = (uint8_t *)(dma_wcomb + OFF_INTR_DATA);
+	p[0] = 0xa1; /* bmRequestType: Device-to-Host, Class, Interface */
+	p[1] = 0x20; /* bNotification: SERIAL_STATE */
+	p[2] = 0; p[3] = 0; /* wValue = 0 */
+	p[4] = 0; p[5] = 0; /* wIndex = 0 (Interface 0) */
+	p[6] = 2; p[7] = 0; /* wLength = 2 */
+	p[8] = 0x03;        /* bRxCarrier=1 (DCD), bTxCarrier=1 (DSR) */
+	p[9] = 0x00;
+	ep_transfer(5, OFF_INTR_TRB, OFF_INTR_DATA, 10, DWC3_TRBCTL_NORMAL);
+}
+
+static void
+reset_endpoints(void)
+{
+	ctl_configured = false;
+	ctl_dtr = false;
+	ctl_rts = false;
+	ctl_tx_active = false;
+	ctl_rx_active = false;
+	cmd_len = 0;
+	core_w(DWC3_DALEPENA, 0);
+	ep_cmd(0, DWC3_DEPCMD_DEPSTARTCFG, 0, 0, 0);
+	ep_config(0, 0, 64);
+	ep_config(1, 0, 64);
+	core_w(DWC3_DALEPENA, 3);
+	arm_setup();
+}
+
+/* Descriptors: Standard CDC-ACM */
+static const uint8_t dev_desc[18] = {
+	18, 1, 0x00, 0x02,  /* bcdUSB 2.0 */
+	2, 0, 0,            /* Class 2 (CDC), SubClass 0, Protocol 0 */
+	64,                 /* bMaxPacketSize0 = 64 */
+	0x09, 0x12,         /* idVendor = 0x1209 (pid.codes open source) */
+	0x6d, 0x31,         /* idProduct = 0x316d */
+	0x00, 0x01,         /* bcdDevice = 1.00 */
+	1, 2, 3,            /* iManufacturer, iProduct, iSerialNumber */
+	1                   /* bNumConfigurations = 1 */
+};
+
+static uint8_t cfg_desc[67] = {
+	9, 2, 67, 0, 2, 1, 0, 0xc0, 50, /* 67 bytes, 2 ifaces, self-powered, 100mA */
+	/* Interface 0: CDC Communication */
+	9, 4, 0, 0, 1, 2, 2, 1, 0,
+	5, 0x24, 0x00, 0x10, 0x01,       /* Header: CDC 1.10 */
+	5, 0x24, 0x01, 0x00, 0x01,       /* Call Management: Data iface 1 */
+	4, 0x24, 0x02, 0x02,             /* ACM: Support Set/Get Line Coding */
+	5, 0x24, 0x06, 0x00, 0x01,       /* Union: Master if 0, Slave if 1 */
+	7, 5, 0x82, 3, 16, 0, 16,        /* EP2 IN (Interrupt), 16B, 16ms */
+	/* Interface 1: CDC Data */
+	9, 4, 1, 0, 2, 10, 0, 0, 0,      /* if 1, 2 endpoints, Class 10 */
+	7, 5, 0x81, 2, 64, 0, 0,         /* EP1 IN (Bulk) */
+	7, 5, 0x01, 2, 64, 0, 0          /* EP1 OUT (Bulk) */
+};
+
+static unsigned
+string_descriptor(unsigned index, uint8_t *out)
+{
+	if (index == 0) {
+		out[0] = 4; out[1] = 3; out[2] = 0x09; out[3] = 0x04;
+		return 4;
+	}
+	const char *str = (index == 1) ? "UniXNU" :
+	                  (index == 2) ? "SM-T970 iOS Control Port" :
+	                  (index == 3) ? "SM8250-GTS7XLWIFI" : "";
+	unsigned len = (unsigned)strlen(str);
+	if (len > 32) len = 32;
+	out[0] = (uint8_t)(2 + 2 * len);
+	out[1] = 3;
+	for (unsigned i = 0; i < len; i++) {
+		out[2 + 2 * i] = (uint8_t)str[i];
+		out[3 + 2 * i] = 0;
+	}
+	return out[0];
+}
+
+/* Event processing forward declaration */
+static void process_events(void);
+
+/* Bulk IN Transmission Helper (synchronous wait for transfer complete) */
+static void
+send_response(const void *data, unsigned len)
+{
+	if (!ctl_configured || len == 0) return;
+	const uint8_t *src = (const uint8_t *)data;
+	unsigned remaining = len;
+
+	while (remaining > 0) {
+		unsigned chunk = (remaining > 4096) ? 4096 : remaining;
+		for (unsigned w = 0; w < 500 && ctl_tx_active; w++) {
+			process_events();
+			delay_for_interval(1, NSEC_PER_MSEC);
+		}
+		if (ctl_tx_active) {
+			pmsg_log("[PONG_USB] tx busy drop\n");
+			return;
+		}
+		memcpy((void *)(dma_wcomb + OFF_TX_DATA), src, chunk);
+		ctl_tx_active = true;
+		ep_transfer(3, OFF_TX_TRB, OFF_TX_DATA, chunk, DWC3_TRBCTL_NORMAL);
+		src += chunk;
+		remaining -= chunk;
+	}
+	for (unsigned w = 0; w < 500 && ctl_tx_active; w++) {
+		process_events();
+		delay_for_interval(1, NSEC_PER_MSEC);
+	}
+	/* ZLP termination if total transfer length is an exact multiple of packet size */
+	if (len > 0 && ctl_packet_size > 0 && (len % ctl_packet_size) == 0 && !ctl_tx_active) {
+		ctl_tx_active = true;
+		ep_transfer(3, OFF_TX_TRB, OFF_TX_DATA, 0, DWC3_TRBCTL_NORMAL);
+		for (unsigned w = 0; w < 500 && ctl_tx_active; w++) {
+			process_events();
+			delay_for_interval(1, NSEC_PER_MSEC);
+		}
+	}
+}
+
+static void
+send_str(const char *s)
+{
+	send_response(s, (unsigned)strlen(s));
+}
+
+/* Command Execution Handlers */
+struct proc_search {
+	const char *target;
+	bool found;
+};
+
+static int
+proc_find_callout(proc_t p, void *arg)
+{
+	struct proc_search *ps = (struct proc_search *)arg;
+	const char *name = proc_best_name(p);
+	if (name && strcmp(name, ps->target) == 0) {
+		ps->found = true;
+		return 1;
+	}
+	return 0;
+}
+
+static void
+cmd_handle_status(void)
+{
+	char reply[256];
+	uint64_t uptime_sec = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &uptime_sec);
+	uptime_sec /= NSEC_PER_SEC;
+
+	unsigned free_pages = vm_page_free_count;
+	unsigned free_mb = (free_pages * 4096u) / (1024u * 1024u);
+
+	struct proc_search ps_launchd = {"launchd", false};
+	struct proc_search ps_bbd = {"backboardd", false};
+	struct proc_search ps_sb = {"SpringBoard", false};
+
+	proc_iterate(PROC_ALLPROCLIST, proc_find_callout, &ps_launchd, NULL, NULL);
+	proc_iterate(PROC_ALLPROCLIST, proc_find_callout, &ps_bbd, NULL, NULL);
+	proc_iterate(PROC_ALLPROCLIST, proc_find_callout, &ps_sb, NULL, NULL);
+
+	snprintf(reply, sizeof(reply),
+	    "STATUS: OK\nuptime: %llus\nfree_pages: %u (%u MB)\nproc_launchd: %s\nproc_backboardd: %s\nproc_SpringBoard: %s\n",
+	    uptime_sec, free_pages, free_mb,
+	    ps_launchd.found ? "RUNNING" : "NOT_FOUND",
+	    ps_bbd.found ? "RUNNING" : "NOT_FOUND",
+	    ps_sb.found ? "RUNNING" : "NOT_FOUND");
+	send_str(reply);
+}
+
+static void
+cmd_handle_log(void)
+{
+	if (!ramoops_console_base) {
+		ramoops_console_base = ml_io_map(PONG_RAMOOPS_PHYS_BASE + PONG_RAMOOPS_CONSOLE_OFFSET, PONG_RAMOOPS_CONSOLE_BYTES);
+	}
+	if (!ramoops_console_base) {
+		send_str("ERROR: cannot map ramoops console\n");
+		return;
+	}
+
+	struct pong_ramoops_header *hdr = (struct pong_ramoops_header *)ramoops_console_base;
+	if (hdr->sig != PONG_RAMOOPS_MAGIC) {
+		send_str("ERROR: ramoops console bad magic\n");
+		return;
+	}
+
+	uint32_t capacity = PONG_RAMOOPS_CONSOLE_BYTES - PONG_RAMOOPS_HEADER_BYTES;
+	uint32_t start = hdr->start;
+	uint32_t size = hdr->size;
+	if (start >= capacity || size > capacity) {
+		send_str("ERROR: corrupt ramoops indices\n");
+		return;
+	}
+
+	send_str("[LOG_START]\n");
+	const char *buffer = (const char *)(ramoops_console_base + PONG_RAMOOPS_HEADER_BYTES);
+
+	if (size == capacity) {
+		uint32_t tail = capacity - start;
+		if (tail > 0) send_response(buffer + start, tail);
+		if (start > 0) send_response(buffer, start);
+	} else {
+		if (size > 0) send_response(buffer, size);
+	}
+	send_str("\n[LOG_END]\n");
+}
+
+static void
+cmd_handle_reboot(bool to_recovery)
+{
+	if (to_recovery) {
+		if (!imem_base) {
+			imem_base = ml_io_map(IMEM_PHYS_BASE, IMEM_SIZE);
+		}
+		if (imem_base) {
+			*(volatile uint32_t *)(imem_base + IMEM_RECOVERY_OFFSET) = IMEM_MAGIC_RECOVERY;
+			__asm__ volatile("dsb sy" ::: "memory");
+			pmsg_log("[PONG_USB] recovery flag 0x%08x set\n", IMEM_MAGIC_RECOVERY);
+			send_str("reboot-recovery: ok (rebooting to TWRP)\n");
+		} else {
+			send_str("reboot-recovery: error mapping IMEM; falling back to normal reboot\n");
+		}
+	} else {
+		send_str("reboot: ok\n");
+	}
+
+	delay_for_interval(50, NSEC_PER_MSEC);
+	if (to_recovery && imem_base) {
+		reboot_kernel(RB_QUICK, "reboot recovery");
+	} else {
+		reboot_kernel(RB_AUTOBOOT, NULL);
+	}
+}
+
+static void
+cmd_handle_screenshot(void)
+{
+	if (!vinfo.v_baseaddr) {
+		send_str("ERROR: video framebuffer not available\n");
+		return;
+	}
+	unsigned width = (unsigned)vinfo.v_width;
+	unsigned height = (unsigned)vinfo.v_height;
+	unsigned depth = (unsigned)vinfo.v_depth;
+	unsigned rowbytes = (unsigned)vinfo.v_rowbytes;
+
+	if (width != 2800 || height != 1752 || depth != 32) {
+		send_str("ERROR: unexpected framebuffer geometry\n");
+		return;
+	}
+
+	char header[64];
+	unsigned total_bytes = rowbytes * height;
+	snprintf(header, sizeof(header), "SCREENSHOT %u %u BGRA %u\n", width, height, total_bytes);
+	send_str(header);
+
+	const uint8_t *fb = (const uint8_t *)vinfo.v_baseaddr;
+	unsigned sent = 0;
+	while (sent < total_bytes && ctl_configured) {
+		unsigned chunk = total_bytes - sent;
+		if (chunk > 4096) chunk = 4096;
+
+		for (unsigned w = 0; w < 500 && ctl_tx_active; w++) {
+			process_events();
+			delay_for_interval(1, NSEC_PER_MSEC);
+		}
+		if (ctl_tx_active) {
+			pmsg_log("[PONG_USB] screenshot tx drop\n");
+			return;
+		}
+
+		memcpy((void *)(dma_wcomb + OFF_TX_DATA), fb + sent, chunk);
+		ctl_tx_active = true;
+		ep_transfer(3, OFF_TX_TRB, OFF_TX_DATA, chunk, DWC3_TRBCTL_NORMAL);
+		sent += chunk;
+	}
+	for (unsigned w = 0; w < 500 && ctl_tx_active; w++) {
+		process_events();
+		delay_for_interval(1, NSEC_PER_MSEC);
+	}
+}
+
+static void
+cmd_handle_tap(const char *args)
+{
+	const char *p = args;
+	unsigned x = parse_uint(&p);
+	unsigned y = parse_uint(&p);
+
+	if (x > 65535 || y > 65535) {
+		send_str("ERROR: coordinates out of range (0..65535)\n");
+		return;
+	}
+
+	pong_touch_post(1, 0, x, y); /* DOWN */
+	delay_for_interval(30, NSEC_PER_MSEC);
+	pong_touch_post(3, 0, x, y); /* UP */
+
+	char reply[64];
+	snprintf(reply, sizeof(reply), "tap: ok (%u, %u)\n", x, y);
+	send_str(reply);
+}
+
+static void
+cmd_handle_swipe(const char *args)
+{
+	const char *p = args;
+	unsigned x1 = parse_uint(&p);
+	unsigned y1 = parse_uint(&p);
+	unsigned x2 = parse_uint(&p);
+	unsigned y2 = parse_uint(&p);
+	unsigned duration_ms = parse_uint(&p);
+
+	if (duration_ms < 50) duration_ms = 50;
+	if (duration_ms > 5000) duration_ms = 5000;
+
+	unsigned steps = duration_ms / 10;
+	if (steps < 5) steps = 5;
+
+	pong_touch_post(1, 0, x1, y1); /* DOWN */
+	delay_for_interval(10, NSEC_PER_MSEC);
+
+	for (unsigned i = 1; i <= steps; i++) {
+		unsigned cur_x = x1 + (int)((int)x2 - (int)x1) * (int)i / (int)steps;
+		unsigned cur_y = y1 + (int)((int)y2 - (int)y1) * (int)i / (int)steps;
+		pong_touch_post(2, 0, cur_x, cur_y); /* MOVE */
+		delay_for_interval(10, NSEC_PER_MSEC);
+	}
+
+	pong_touch_post(3, 0, x2, y2); /* UP */
+
+	char reply[64];
+	snprintf(reply, sizeof(reply), "swipe: ok (%u,%u)->(%u,%u) in %ums\n", x1, y1, x2, y2, duration_ms);
+	send_str(reply);
+}
+
+static int
+proc_thread_snapshot_callout(proc_t p, __unused void *arg)
+{
+	task_t t = proc_task(p);
+	if (!t) return 0;
+	const char *name = proc_best_name(p);
+	if (!name) name = "unknown";
+	int pid = proc_pid(p);
+
+	uint64_t snap_sec = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &snap_sec);
+	snap_sec /= NSEC_PER_SEC;
+
+	pong_dump_task_threads_pmsg(t, name, pid, (uint32_t)snap_sec);
+	return 0;
+}
+
+static void
+cmd_handle_threads(void)
+{
+	proc_iterate(PROC_ALLPROCLIST, proc_thread_snapshot_callout, NULL, NULL, NULL);
+	send_str("threads: snapshot written to pmsg; use 'log' to read\n");
+}
+
+/* Dispatch Received Command String */
+static void
+dispatch_command(const char *cmd)
+{
+	pmsg_log("[PONG_USB] cmd: '%s'\n", cmd);
+
+	if (strcmp(cmd, "ping") == 0) {
+		send_str("pong\n");
+	} else if (strcmp(cmd, "status") == 0) {
+		cmd_handle_status();
+	} else if (strcmp(cmd, "log") == 0) {
+		cmd_handle_log();
+	} else if (strcmp(cmd, "reboot") == 0) {
+		cmd_handle_reboot(false);
+	} else if (strcmp(cmd, "reboot-recovery") == 0) {
+		cmd_handle_reboot(true);
+	} else if (strcmp(cmd, "screenshot") == 0) {
+		cmd_handle_screenshot();
+	} else if (strncmp(cmd, "tap ", 4) == 0) {
+		cmd_handle_tap(cmd + 4);
+	} else if (strncmp(cmd, "swipe ", 6) == 0) {
+		cmd_handle_swipe(cmd + 6);
+	} else if (strcmp(cmd, "threads") == 0) {
+		cmd_handle_threads();
+	} else {
+		send_str("ERROR: unknown command. Available: ping, status, log, reboot, reboot-recovery, screenshot, tap, swipe, threads\n");
+	}
+}
+
+/* Feed Incoming Bulk OUT Characters into Line Buffer */
+static void
+feed_input(const uint8_t *data, unsigned len)
+{
+	for (unsigned i = 0; i < len; i++) {
+		char c = (char)data[i];
+		if (c == '\r' || c == '\n') {
+			if (cmd_len > 0) {
+				while (cmd_len > 0 && (cmd_buf[cmd_len - 1] == ' ' || cmd_buf[cmd_len - 1] == '\t')) {
+					cmd_len--;
+				}
+				cmd_buf[cmd_len] = '\0';
+				if (cmd_len > 0) {
+					if (diag_rx_line_count < 8) {
+						pmsg_log("[PONG_USB] rx_line #%u: '%s'\n", ++diag_rx_line_count, cmd_buf);
+					}
+					dispatch_command(cmd_buf);
+				}
+				cmd_len = 0;
+			}
+		} else if (cmd_len + 1 < sizeof(cmd_buf)) {
+			cmd_buf[cmd_len++] = c;
+		} else {
+			cmd_len = 0; /* Overflow: discard */
+		}
+	}
+}
+
+/* EP0 Setup Packet Dispatch */
+static void
+handle_setup(void)
+{
+	__asm__ volatile("dsb sy" ::: "memory");
+	volatile const uint8_t *setup_pkt = (volatile const uint8_t *)(dma_wcomb + OFF_EP_DATA);
+	uint8_t type = setup_pkt[0];
+	uint8_t req = setup_pkt[1];
+	uint16_t val = (uint16_t)setup_pkt[2] | ((uint16_t)setup_pkt[3] << 8);
+	uint16_t idx = (uint16_t)setup_pkt[4] | ((uint16_t)setup_pkt[5] << 8);
+	uint16_t len = (uint16_t)setup_pkt[6] | ((uint16_t)setup_pkt[7] << 8);
+
+	if (diag_setup_count < 8) {
+		pmsg_log("[PONG_USB] setup #%u: %02x %02x v=%04x i=%04x l=%u\n",
+		    ++diag_setup_count, type, req, val, idx, len);
+	}
+
+	ctl_control_bytes = len;
+	ctl_status_dep = (type & 0x80) ? 0 : 1;
+	ctl_req_type = type;
+	ctl_req_cmd = req;
+	uint8_t *out = (uint8_t *)(dma_wcomb + OFF_EP_DATA + 0x100);
+	unsigned resp_len = 0;
+
+	if ((type & 0x60) == 0 && req == 6 && (type & 0x80)) {
+		/* GET_DESCRIPTOR */
+		switch (val >> 8) {
+		case 1: /* Device */
+			memcpy(out, dev_desc, sizeof(dev_desc));
+			resp_len = sizeof(dev_desc);
+			break;
+		case 2: /* Configuration */
+			memcpy(out, cfg_desc, sizeof(cfg_desc));
+			resp_len = sizeof(cfg_desc);
+			break;
+		case 3: /* String */
+			resp_len = string_descriptor(val & 0xff, out);
+			break;
+		case 6: { /* Device Qualifier */
+			uint8_t q[10] = {10, 6, 0x00, 0x02, dev_desc[4], dev_desc[5], dev_desc[6], 64, 1, 0};
+			memcpy(out, q, 10);
+			resp_len = 10;
+			break;
+		}
+		default:
+			stall_control();
+			return;
+		}
+	} else if (type == 0 && req == 5 && !len && val < 128) {
+		/* SET_ADDRESS */
+		core_w(DWC3_DCFG, (core_r(DWC3_DCFG) & ~(127u << 3)) | ((uint32_t)val << 3));
+		status_stage(1);
+		return;
+	} else if (type == 0 && req == 9 && !len && val <= 1) {
+		/* SET_CONFIGURATION */
+		if (ctl_configured && val == 1) {
+			status_stage(1);
+			return;
+		}
+		ctl_configured = (val != 0);
+		if (ctl_configured) {
+			if (!ep_config(2, 2, ctl_packet_size) ||
+			    !ep_config(3, 2, ctl_packet_size) ||
+			    !ep_config(5, 3, 16)) {
+				stall_control();
+				return;
+			}
+			core_w(DWC3_DALEPENA, core_r(DWC3_DALEPENA) | (1u << 2) | (1u << 3) | (1u << 5));
+			pmsg_log("[PONG_USB] configured: speed=%s packet=%u\n",
+			    (ctl_packet_size == 512) ? "HS" : "FS", ctl_packet_size);
+			if (!ctl_rx_active) {
+				ctl_rx_active = ep_transfer(2, OFF_RX_TRB, OFF_RX_DATA, ctl_packet_size, DWC3_TRBCTL_NORMAL);
+			}
+			send_serial_state();
+		} else {
+			ctl_dtr = false;
+			ctl_rts = false;
+		}
+		status_stage(1);
+		return;
+	} else if (type == 0x02 && req == 1 && !len) {
+		/* CLEAR_FEATURE (ENDPOINT_HALT) */
+		unsigned ep = ((idx & 15) << 1) | ((idx >> 7) & 1);
+		if (ep == 2 || ep == 3 || ep == 5) {
+			ep_cmd(ep, DWC3_DEPCMD_CLEARSTALL, 0, 0, 0);
+		}
+		status_stage(1);
+		return;
+	} else if (type == 0x80 && req == 0 && len == 2) {
+		/* GET_STATUS (DEVICE) */
+		out[0] = 1; out[1] = 0; /* Self-powered */
+		resp_len = 2;
+	} else if (type == 0x81 && req == 0 && len == 2) {
+		/* GET_STATUS (INTERFACE) */
+		out[0] = 0; out[1] = 0;
+		resp_len = 2;
+	} else if (type == 0x82 && req == 0 && len == 2) {
+		/* GET_STATUS (ENDPOINT) */
+		out[0] = 0; out[1] = 0;
+		resp_len = 2;
+	} else if (type == 0xa1 && req == 0x21 && len == 7) {
+		/* CDC: GET_LINE_CODING */
+		memcpy(out, ctl_line_coding, 7);
+		resp_len = 7;
+		if (diag_cdc_get_line_coding < 5) {
+			pmsg_log("[PONG_USB] cdc: GET_LINE_CODING #%u\n", ++diag_cdc_get_line_coding);
+		}
+	} else if (type == 0x21 && req == 0x20 && len == 7) {
+		/* CDC: SET_LINE_CODING */
+		control_data(0, 7);
+		return;
+	} else if (type == 0x21 && req == 0x22 && !len) {
+		/* CDC: SET_CONTROL_LINE_STATE */
+		ctl_dtr = (val & 1) != 0;
+		ctl_rts = (val & 2) != 0;
+		cmd_len = 0;
+		if (diag_cdc_set_ctrl_line < 5) {
+			pmsg_log("[PONG_USB] cdc: SET_CONTROL_LINE_STATE #%u (dtr=%u rts=%u)\n",
+			    ++diag_cdc_set_ctrl_line, ctl_dtr, ctl_rts);
+		}
+		status_stage(1);
+		if (ctl_configured && !ctl_rx_active) {
+			ctl_rx_active = ep_transfer(2, OFF_RX_TRB, OFF_RX_DATA, ctl_packet_size, DWC3_TRBCTL_NORMAL);
+		}
+		send_serial_state();
+		return;
+	} else if (type == 0x21 && req == 0x23 && !len) {
+		/* CDC: SEND_BREAK */
+		if (diag_cdc_send_break < 5) {
+			pmsg_log("[PONG_USB] cdc: SEND_BREAK #%u (dur=%ums)\n", ++diag_cdc_send_break, val);
+		}
+		status_stage(1);
+		return;
+	} else if (type == 0x21 && req == 0x02 && len == 2) {
+		/* CDC: SET_COMM_FEATURE */
+		control_data(0, 2);
+		return;
+	} else if (type == 0xa1 && req == 0x03 && len == 2) {
+		/* CDC: GET_COMM_FEATURE */
+		out[0] = 0; out[1] = 0;
+		resp_len = 2;
+	} else if (type == 0x21 && req == 0x04 && !len) {
+		/* CDC: CLEAR_COMM_FEATURE */
+		status_stage(1);
+		return;
+	} else if (type == 0x01 && req == 0x0b && !len) {
+		/* Standard: SET_INTERFACE */
+		status_stage(1);
+		return;
+	} else if (type == 0x81 && req == 0x0a && len == 1) {
+		/* Standard: GET_INTERFACE */
+		out[0] = 0;
+		resp_len = 1;
+	} else {
+		if (diag_cdc_other < 5) {
+			pmsg_log("[PONG_USB] cdc/req: stall type=0x%02x req=0x%02x v=0x%04x i=0x%04x l=%u (#%u)\n",
+			    type, req, val, idx, len, ++diag_cdc_other);
+		}
+		stall_control();
+		return;
+	}
+
+	if (resp_len > len) resp_len = len;
+	if (len > 0) control_data(1, resp_len);
+	else status_stage(ctl_status_dep);
+}
+
+/* Endpoint Event Handler */
+static void
+handle_ep_event(uint32_t event)
+{
+	unsigned ep = (event >> 1) & 31;
+	unsigned kind = (event >> 6) & 15;
+	unsigned status = (event >> 12) & 15;
+
+	if (ep <= 1 && diag_ep0_evt_count < 16) {
+		pmsg_log("[PONG_USB] ep0_evt #%u: ep=%u kind=%u status=%u stage=%u\n",
+		    ++diag_ep0_evt_count, ep, kind, status, ctl_stage);
+	}
+
+	if (ep >= 2) {
+		if (kind == DWC3_DEPEVT_XFERCOMPLETE) {
+			if (ep == 3) {
+				ctl_tx_active = false;
+			}
+			if (ep == 2 && ctl_rx_active) {
+				__asm__ volatile("dsb sy" ::: "memory");
+				uint32_t residual = *(volatile uint32_t *)(dma_wcomb + OFF_RX_TRB + 8) & 0xffffff;
+				if (!(status & 1) && residual <= ctl_packet_size) {
+					unsigned rcvd = ctl_packet_size - residual;
+					if (rcvd > 0) {
+						feed_input((const uint8_t *)(dma_wcomb + OFF_RX_DATA), rcvd);
+					}
+				}
+				ctl_rx_active = false;
+				if (ctl_configured) {
+					ctl_rx_active = ep_transfer(2, OFF_RX_TRB, OFF_RX_DATA, ctl_packet_size, DWC3_TRBCTL_NORMAL);
+				}
+			}
+		}
+		return;
+	}
+
+	/* Control EP0/EP1 */
+	if (kind == DWC3_DEPEVT_XFERNOTREADY) {
+		unsigned phase = (status & 3);
+		if (phase == DWC3_DEPEVT_STATUS_CONTROL_STATUS) {
+			if (ctl_stage != 3) {
+				status_stage(ep);
+			}
+			return;
+		}
+		return;
+	}
+	if (kind != DWC3_DEPEVT_XFERCOMPLETE) return;
+
+	if (ctl_stage == 0) {
+		handle_setup();
+		return;
+	}
+	if (ctl_stage == 1) {
+		if (ctl_status_dep == 1) {
+			/* Control OUT data phase finished */
+			__asm__ volatile("dsb sy" ::: "memory");
+			if (ctl_req_cmd == 0x20) {
+				/* SET_LINE_CODING: latch 7-byte line coding */
+				memcpy(ctl_line_coding, (const void *)(dma_wcomb + OFF_EP_DATA + 0x100), 7);
+				if (diag_cdc_set_line_coding < 5) {
+					uint32_t baud = (uint32_t)ctl_line_coding[0] | ((uint32_t)ctl_line_coding[1] << 8) |
+					                ((uint32_t)ctl_line_coding[2] << 16) | ((uint32_t)ctl_line_coding[3] << 24);
+					pmsg_log("[PONG_USB] cdc: SET_LINE_CODING #%u (baud=%u fmt=%u parity=%u data=%u)\n",
+					    ++diag_cdc_set_line_coding, baud, ctl_line_coding[4], ctl_line_coding[5], ctl_line_coding[6]);
+				}
+			}
+			status_stage(1);
+		} else {
+			/* Control IN data phase finished: prepare for host's OUT status */
+			status_stage(0);
+		}
+		return;
+	}
+	if (ctl_stage == 3) {
+		arm_setup();
+		return;
+	}
+}
+
+/* Event Ring Processing */
+static void
+process_events(void)
+{
+	__asm__ volatile("dsb sy" ::: "memory");
+	unsigned count = core_r(DWC3_GEVNTCOUNT(0)) & 0xfffc;
+	if (count == 0) return;
+	if (count > 4096) {
+		pmsg_log("[PONG_USB] event ring overflow (%u)\n", count);
+		core_w(DWC3_GEVNTCOUNT(0), count);
+		ctl_event_offset = 0;
+		return;
+	}
+	for (unsigned done = 0; done < count; done += 4) {
+		uint32_t event = *(volatile uint32_t *)(dma_wcomb + OFF_EVT_RING + ctl_event_offset);
+		ctl_event_offset = (ctl_event_offset + 4) & 4095;
+		if (!(event & 1)) {
+			handle_ep_event(event);
+		} else {
+			unsigned dev_evt = (event >> 8) & 15;
+			switch (dev_evt) {
+			case 0: /* Disconnect */
+				ctl_configured = false;
+				ctl_dtr = false;
+				ctl_rts = false;
+				if (diag_dev_evt_count < 6) {
+					pmsg_log("[PONG_USB] usb_disconnect\n");
+					diag_dev_evt_count++;
+				}
+				break;
+			case 1: /* USB Reset */
+				if (diag_dev_evt_count < 6) {
+					pmsg_log("[PONG_USB] usb_reset (#%u)\n", diag_dev_evt_count + 1);
+					diag_dev_evt_count++;
+				}
+				core_w(DWC3_DCFG, core_r(DWC3_DCFG) & ~(127u << 3));
+				reset_endpoints();
+				break;
+			case 2: { /* Connection speed done */
+				uint32_t spd = DWC3_DSTS_CONNECTSPD(core_r(DWC3_DSTS));
+				ctl_packet_size = (spd == 0) ? 512 : 64;
+				cfg_desc[57] = cfg_desc[64] = (uint8_t)ctl_packet_size;
+				cfg_desc[58] = cfg_desc[65] = (uint8_t)(ctl_packet_size >> 8);
+
+				/* Restore GCTL (RAMCLKSEL=0 bus clock, PRTCAPDIR=device, DSBLCLKGTNG) */
+				uint32_t gctl = core_r(DWC3_GCTL);
+				core_w(DWC3_GCTL, (gctl & ~(3u << 12)) | (2u << 12) | DWC3_GCTL_DSBLCLKGTNG);
+
+				/* Reconfigure EP0 with confirmed 64-byte max packet size */
+				ep_config(0, 0, 64);
+				ep_config(1, 0, 64);
+				core_w(DWC3_DALEPENA, core_r(DWC3_DALEPENA) | 3);
+				arm_setup();
+
+				if (diag_conndone_count < 5) {
+					pmsg_log("[PONG_USB] connect_done #%u: spd=%u (%s) ep0=64 bulk=%u\n",
+					    ++diag_conndone_count, spd, (spd == 0) ? "HS" : "FS", ctl_packet_size);
+				}
+				break;
+			}
+			default:
+				break;
+			}
+		}
+	}
+	core_w(DWC3_GEVNTCOUNT(0), count);
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/* Deferred USB Control Thread */
+static void
+pong_usb_ctl_thread(void *param, __unused wait_result_t result)
+{
+	uint32_t delay_sec = (uint32_t)(uintptr_t)param;
+	if (delay_sec > 0) {
+		pmsg_log("[PONG_USB] delaying USB init by %u sec...\n", delay_sec);
+		printf("Pong USB: delaying init by %u sec\n", delay_sec);
+		for (uint32_t s = 0; s < delay_sec; s++) {
+			delay_for_interval(1, NSEC_PER_SEC);
+		}
+	}
+
+	pmsg_log("[PONG_USB] step 1: checking GCC clocks and GDSC...\n");
+	if (!pong_usb_check_clocks_and_power()) {
+		pmsg_log("[PONG_USB] fail: clock/power check failed; aborting\n");
+		thread_terminate(current_thread());
+		return;
+	}
+
+	pmsg_log("[PONG_USB] step 2: mapping TLMM North 0x%lx...\n", (unsigned long)TLMM_NORTH_PHYS);
+	tlmm_base = ml_io_map(TLMM_NORTH_PHYS, TLMM_SIZE);
+	if (!tlmm_base) {
+		pmsg_log("[PONG_USB] fail: ml_io_map(TLMM_NORTH)\n");
+		thread_terminate(current_thread());
+		return;
+	}
+	cfg_sda = rd(GPIO_CFG(tlmm_base, PIN_SDA)) & ~(CFG_FUNCTION | CFG_OUTPUT_ENABLE);
+	cfg_scl = rd(GPIO_CFG(tlmm_base, PIN_SCL)) & ~(CFG_FUNCTION | CFG_OUTPUT_ENABLE);
+	wr(GPIO_CFG(tlmm_base, PIN_SDA), cfg_sda);
+	wr(GPIO_CFG(tlmm_base, PIN_SCL), cfg_scl);
+	spin_us(100);
+
+	pmsg_log("[PONG_USB] step 2b: routing MAX77705 MUIC...\n");
+	if (pong_muic_route()) {
+		pmsg_log("[PONG_USB] muic: i2c slave 0x25 route ok\n");
+	} else {
+		pmsg_log("[PONG_USB] muic: warning route no ack\n");
+	}
+
+	pmsg_log("[PONG_USB] step 3: checking Apps SMMU 0x%lx (read-only)...\n", (unsigned long)APPS_SMMU_PHYS);
+	smmu_base = ml_io_map(APPS_SMMU_PHYS, APPS_SMMU_SIZE);
+	if (smmu_base) {
+		pong_smmu_check_sid0_bypass(smmu_base);
+	}
+
+	pmsg_log("[PONG_USB] step 4: allocating DMA contiguous buffer (32 KiB)...\n");
+	dma_phys = 0;
+	dma_virt = IOMallocContiguous(USB_DMA_BYTES, 4096, &dma_phys);
+	if (!dma_virt || !dma_phys) {
+		pmsg_log("[PONG_USB] fail: IOMallocContiguous 32K\n");
+		thread_terminate(current_thread());
+		return;
+	}
+	dma_wcomb = ml_io_map_wcomb((vm_offset_t)dma_phys, USB_DMA_BYTES);
+	if (!dma_wcomb) {
+		pmsg_log("[PONG_USB] fail: ml_io_map_wcomb DMA\n");
+		thread_terminate(current_thread());
+		return;
+	}
+	memset((void *)dma_wcomb, 0, USB_DMA_BYTES);
+	__asm__ volatile("dsb sy" ::: "memory");
+	pmsg_log("[PONG_USB] dma: allocated phys=0x%llx\n", (uint64_t)dma_phys);
+
+	pmsg_log("[PONG_USB] step 5: mapping DWC3 core 0x%lx and QSCRATCH 0x%lx...\n",
+	    (unsigned long)DWC3_CORE_PHYS, (unsigned long)QSCRATCH_PHYS);
+	core_base = ml_io_map(DWC3_CORE_PHYS, DWC3_CORE_SIZE);
+	qscratch_base = ml_io_map(QSCRATCH_PHYS, QSCRATCH_SIZE);
+	if (!core_base || !qscratch_base) {
+		pmsg_log("[PONG_USB] fail: ml_io_map core/qscratch\n");
+		thread_terminate(current_thread());
+		return;
+	}
+
+	pmsg_log("[PONG_USB] step 6: reading DWC3 core ID...\n");
+	uint32_t gsnpsid = core_r(DWC3_GSNPSID);
+	pmsg_log("[PONG_USB] dwc3: core id=0x%08x\n", gsnpsid);
+	uint32_t id = gsnpsid & 0xffff0000;
+	if (id != 0x55330000 && id != 0x55340000 && id != 0x33310000) {
+		pmsg_log("[PONG_USB] fail: unexpected core id 0x%08x\n", gsnpsid);
+		thread_terminate(current_thread());
+		return;
+	}
+
+	pmsg_log("[PONG_USB] step 7: reading GCTL, DCTL, DSTS...\n");
+	uint32_t gctl = core_r(DWC3_GCTL);
+	uint32_t dctl = core_r(DWC3_DCTL);
+	uint32_t dsts = core_r(DWC3_DSTS);
+	pmsg_log("[PONG_USB] dwc3: initial GCTL=0x%08x DCTL=0x%08x DSTS=0x%08x\n", gctl, dctl, dsts);
+
+	pmsg_log("[PONG_USB] step 8: stopping controller (DCTL & ~RUN_STOP)...\n");
+	core_w(DWC3_DCTL, dctl & ~DWC3_DCTL_RUN_STOP);
+
+	pmsg_log("[PONG_USB] step 9: polling DSTS.DEVCTRLHLT...\n");
+	for (unsigned i = 0; i < 25000; i++) {
+		if (core_r(DWC3_DSTS) & DWC3_DSTS_DEVCTRLHLT) break;
+		spin_us(10);
+	}
+	pmsg_log("[PONG_USB] dwc3: halt poll done (DSTS=0x%08x)\n", core_r(DWC3_DSTS));
+
+	pmsg_log("[PONG_USB] step 10: clearing DEVTEN and DALEPENA...\n");
+	core_w(DWC3_DEVTEN, 0);
+	core_w(DWC3_DALEPENA, 0);
+
+	/* Soft reset is SKIPPED to preserve UEFI PHY clocks and state */
+	pmsg_log("[PONG_USB] step 11: skipping CSFTRST (preserving UEFI PHY/core state)\n");
+
+	pmsg_log("[PONG_USB] step 12: writing GUSB2PHYCFG0 (clearing SUSPHY/ENBLSLPM)...\n");
+	core_w(DWC3_GUSB2PHYCFG(0), core_r(DWC3_GUSB2PHYCFG(0)) & ~(DWC3_GUSB2PHYCFG_SUSPHY | DWC3_GUSB2PHYCFG_ENBLSLPM));
+
+	pmsg_log("[PONG_USB] step 13: writing DCFG (device speed=high/full)...\n");
+	core_w(DWC3_DCFG, (core_r(DWC3_DCFG) & ~7u) | 0);
+
+	pmsg_log("[PONG_USB] step 14: setting event ring (phys=0x%llx, size=4096)...\n", (uint64_t)dma_phys);
+	core_w(DWC3_GEVNTADRLO(0), (uint32_t)dma_phys);
+	core_w(DWC3_GEVNTADRHI(0), (uint32_t)(dma_phys >> 32));
+	core_w(DWC3_GEVNTSIZ(0), 4096u | (1u << 31));
+	core_w(DWC3_GEVNTCOUNT(0), 0);
+	ctl_event_offset = 0;
+
+	pmsg_log("[PONG_USB] step 15: writing GCTL (PRTCAPDIR=device, DSBLCLKGTNG)...\n");
+	core_w(DWC3_GCTL, (core_r(DWC3_GCTL) & ~(3u << 12)) | (2u << 12) | DWC3_GCTL_DSBLCLKGTNG);
+
+	pmsg_log("[PONG_USB] step 16: calling reset_endpoints (DEPSTARTCFG/SETEPCONFIG)...\n");
+	reset_endpoints();
+
+	pmsg_log("[PONG_USB] step 17: writing DEVTEN=0x0f...\n");
+	core_w(DWC3_DEVTEN, 0x0f);
+
+	pmsg_log("[PONG_USB] step 18: applying QSCRATCH VBUS override...\n");
+	qs_w(0x30, qs_r(0x30) | (1u << 24));
+	qs_w(0x10, qs_r(0x10) | (1u << 20) | (1u << 28));
+	pmsg_log("[PONG_USB] qscratch: override latched (0x10=0x%08x 0x30=0x%08x)\n",
+	    qs_r(0x10), qs_r(0x30));
+
+	pmsg_log("[PONG_USB] step 19: starting controller (DCTL | RUN_STOP)...\n");
+	core_w(DWC3_DCTL, core_r(DWC3_DCTL) | DWC3_DCTL_RUN_STOP);
+
+	pmsg_log("[PONG_USB] step 20: ready: listening on CDC-ACM\n");
+	printf("Pong USB: ready, listening on CDC-ACM\n");
+
+	while (1) {
+		process_events();
+		if (ctl_configured && !ctl_rx_active) {
+			ctl_rx_active = ep_transfer(2, OFF_RX_TRB, OFF_RX_DATA, ctl_packet_size, DWC3_TRBCTL_NORMAL);
+		}
+		delay_for_interval(2, NSEC_PER_MSEC);
+	}
+}
+
+/* Public Initialization Routine (Called from bsd_init) */
+void
+pong_usb_ctl_init(void)
+{
+	uint32_t enabled = 0;
+	if (!PE_parse_boot_argn("pong_usb_ctl", &enabled, sizeof(enabled)) || enabled != 1) {
+		return;
+	}
+	ctl_enabled = true;
+
+	uint32_t delay_sec = 45;
+	PE_parse_boot_argn("pong_usb_delay", &delay_sec, sizeof(delay_sec));
+
+	pmsg_log("[PONG_USB] init: queued SM-T970 USB CDC-ACM control channel (delay=%u sec)\n", delay_sec);
+	printf("Pong USB: queued CDC-ACM control channel init (delay=%u sec)\n", delay_sec);
+
+	thread_t th = THREAD_NULL;
+	if (kernel_thread_start(pong_usb_ctl_thread, (void *)(uintptr_t)delay_sec, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	} else {
+		pmsg_log("[PONG_USB] fail: kernel_thread_start\n");
+		printf("Pong USB: fail: kernel_thread_start\n");
+	}
+}
