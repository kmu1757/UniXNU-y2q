+/* `nettest` or `nettest a.b.c.d` (the DNS server to ask) */
+int
+pong_wifi_tools_nettest(char *reply, size_t cap, const char *args)
+{
+	uint32_t ip = 0, part = 0;
+	int dots = 0, digits = 0;
+
+	while (args && *args == ' ') {
+		args++;
+	}
+	if (args && *args) {
+		for (const char *s = args; ; s++) {
+			if (*s >= '0' && *s <= '9' && digits < 3) {
+				part = part * 10 + (uint32_t)(*s - '0');
+				digits++;
+			} else if ((*s == '.' || *s == '\0') && digits && part < 256) {
+				ip = ip << 8 | part;
+				part = 0;
+				digits = 0;
+				if (*s == '\0') {
+					break;
+				}
+				dots++;
+			} else {
+				dots = -1;
+				break;
+			}
+		}
+		if (dots != 3) {
+			strlcpy(reply, "nettest: give the DNS server as a.b.c.d\n", cap);
+			return -1;
+		}
+		nt_dns_server = ip;
+	}
+	return pong_wifi_tools_usb(reply, cap, 2);
+}
