+/* ---- Mode 8 helpers: a650_gmu.bin block plan and TCM write/verify --------------------------- */
+
+struct gmufw_block {
+	uint32_t addr;
+	uint32_t len;
+	uint32_t payload_off;
+	uint32_t region;   /* GMUFW_REGION_*; UINT32_MAX for a zero-size metadata block */
+};
+
+static uint32_t
+gpu_gmufw_le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+/*
+ * Plan a650_gmu.bin's blocks (AdrenoFirmware.c:33-65): walk the 16-byte headers, classify each
+ * block into a region, and reject anything truncated, unaligned, or outside the four regions.
+ * The header's type/value words (off+8, off+12) are not needed for a TCM load and are skipped.
+ * Returns 0 on success, -1 truncated, -2 unaligned, -3 unmapped/out-of-range, -4 no space.
+ */
+static int
+gpu_gmufw_parse(const uint8_t *fw, uint32_t fw_len, struct gmufw_block *blocks, uint32_t cap,
+    uint32_t *count)
+{
+	uint32_t off = 0, n = 0;
+
+	*count = 0;
+	if (!fw || fw_len < GMUFW_BLOCK_HDR) {
+		return -1;
+	}
+	while (off < fw_len) {
+		if (fw_len - off < GMUFW_BLOCK_HDR) {
+			return -1;
+		}
+		const uint32_t addr = gpu_gmufw_le32(fw + off);
+		const uint32_t len  = gpu_gmufw_le32(fw + off + 4);
+		if (len > fw_len - off - GMUFW_BLOCK_HDR) {
+			return -1;
+		}
+		uint32_t region = UINT32_MAX;
+		if (len) {
+			if ((addr & 3u) || (len & 3u)) {
+				return -2;
+			}
+			if (addr < GMU_ITCM_BASE + GMU_TCM_BYTES) {
+				region = GMUFW_REGION_ITCM;
+			} else if (addr < GMU_DTCM_BASE) {
+				region = GMUFW_REGION_ICACHE;
+			} else if (addr < GMU_DTCM_BASE + GMU_TCM_BYTES) {
+				region = GMUFW_REGION_DTCM;
+			} else if (addr >= GMU_DUMMY_IOVA) {
+				region = GMUFW_REGION_DUMMY;
+			} else {
+				return -3;
+			}
+			/* A TCM block must fit inside its 0x4000-byte TCM (A650Gmu.c:36). */
+			if ((region == GMUFW_REGION_ITCM || region == GMUFW_REGION_DTCM) && len > GMU_TCM_BYTES) {
+				return -3;
+			}
+			if ((region == GMUFW_REGION_ITCM &&
+			    addr - GMU_ITCM_BASE > GMU_TCM_BYTES - len) ||
+			    (region == GMUFW_REGION_DTCM &&
+			    addr - GMU_DTCM_BASE > GMU_TCM_BYTES - len)) {
+				return -3;
+			}
+		}
+		if (n >= cap) {
+			return -4;
+		}
+		blocks[n].addr = addr;
+		blocks[n].len = len;
+		blocks[n].payload_off = off + GMUFW_BLOCK_HDR;
+		blocks[n].region = region;
+		n++;
+		off += GMUFW_BLOCK_HDR + len;
+	}
+	*count = n;
+	return 0;
+}
+
+/* Byte offset of a TCM block inside the GMU_TCM window (ITCM at 0, DTCM at GMU_TCM_BYTES). */
+static uint32_t
+gpu_gmufw_tcm_off(const struct gmufw_block *b)
+{
+	if (b->region == GMUFW_REGION_ITCM) {
+		return b->addr - GMU_ITCM_BASE;
+	}
+	return GMU_TCM_BYTES + (b->addr - GMU_DTCM_BASE);
+}
+
+/* `[PONG_GPU] W<n> blk<i> addr=… len=…` before each TCM block write (block granularity, not per word). */
+static void
+gpu_probe_blkmark(unsigned int wstep, unsigned int blk, uint32_t addr, uint32_t len)
+{
+	char line[64];
+	int n = snprintf(line, sizeof(line), "[PONG_GPU] W%u blk%u addr=0x%08x len=%u\n",
+	    wstep, blk, addr, len);
+
+	if (n > 0) {
+		pong_ramoops_diagnostic_write(line, n < (int)sizeof(line) ? n : (int)sizeof(line) - 1);
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+}
+
+/* Write one TCM block word by word (the GMU is still in reset), one pmsg marker for the block. */
+static void
+gpu_probe_blk_write(vm_offset_t base, unsigned int byte_off, const uint8_t *src, uint32_t len,
+    unsigned int wstep, unsigned int blk, uint32_t addr)
+{
+	gpu_probe_blkmark(wstep, blk, addr, len);
+	for (uint32_t at = 0; at < len; at += 4) {
+		*(volatile uint32_t *)(base + byte_off + at) = gpu_gmufw_le32(src + at);
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/* Read a TCM block back and count mismatched words; *first_off is the first mismatch byte offset. */
+static uint32_t
+gpu_probe_blk_verify(vm_offset_t base, unsigned int byte_off, const uint8_t *src, uint32_t len,
+    uint32_t *first_off)
+{
+	uint32_t mismatch = 0;
+
+	for (uint32_t at = 0; at < len; at += 4) {
+		const uint32_t got  = gpu_probe_rd32(base, byte_off + at);
+		const uint32_t want = gpu_gmufw_le32(src + at);
+		if (got != want) {
+			if (mismatch == 0) {
+				*first_off = at;
+			}
+			mismatch++;
+		}
+	}
+	return mismatch;
+}
