# Apple restore components are fetched locally by scripts; never commit them.
/apple/
/out/
/build/
*.ipsw
*.dmg
*.cdr
*.img
*.bin
*.fw
*.mdt
*.b01
*.b02
*.im4p
*.im4m
*.trustcache
*.ramdisk
*.lzfse
*.partial
*.dSYM/
*.o
*.a
__pycache__/
*.py[cod]

# Keep migration inputs and outputs outside source control.
/.cache/
/refer/
/reference/
/local/
/artifacts/
/firmware/
*.dylib
*.metallib
*.air
*.kc
*.kernelcache
/BuildManifest.plist
/Restore.plist
.DS_Store

/mac-build/

/local.toml
/unixnu.local.toml
/build-services*.log

# Step 5 (root mount): Apple userland lives in iOSPort/private/, never here.
# dyld_shared_cache_arm64 has NO extension, so none of the patterns above catch it.
dyld_shared_cache_arm64*
/private/
*.apfs
*.sparseimage
*.sparsebundle/
*.shsh
*.shsh2
# sealed blobs are kept outside the repo too
*.gpg
*.asc
*.age
